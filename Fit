@using MudBlazor

<MudButton Class="transition-fast-out-slow-in scale-hover"
           OnClick="Toggle"
           Style="background-color:@BackgroundColor;font-weight:bold;font-family:Cambria">
    @Title
</MudButton>

@if (IsVisible)
{
    @ChildContent
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string BackgroundColor { get; set; } = "coral";
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void Toggle()
    {
        IsVisible = !IsVisible;
        IsVisibleChanged.InvokeAsync(IsVisible);
    }
}