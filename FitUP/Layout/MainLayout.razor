@implements IDisposable
@inherits LayoutComponentBase
@inject FitUP.Services.AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<style>
    .mud-snackbar-container {
        bottom: 24px !important;
        right: 24px !important;
        top: auto !important;
        left: auto !important;
    }

    .mud-menu-popover {
        z-index: 1300 !important;
    }

    html, body {
        background: transparent !important;
    }
</style>

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" /> 
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider position="SnackbarPosition.BottomRight" />

<MudLayout>
    <MudScrollToTop>
        <MudFab Style="background-color:coral" StartIcon="@Icons.Material.Rounded.KeyboardArrowUp" />
    </MudScrollToTop>
    <MudAppBar Elevation="0" Style="height: 70px;background-color:transparent;backdrop-filter:blur(2px);">
        @*O menu so aparecera quando o site estiver na metade ou menor.*@
         <MudIconButton Class="d-flex d-md-none" Icon="@Icons.Material.Filled.Menu" Style="color:coral" Edge="Edge.Start" OnClick="@DrawerToggle" /> 
        
         @*Foi colocado um retorno pra home atras da Logo da pagina, junto com a estilização.*@
        <div class="home-link d-flex flex-column justify-center ml-2" >
        <MudLink Href="/" Underline="Underline.None" Typo="Typo.h4" Style=" color: coral !important;line-height: 1.2; font-weight: bold;">FitUP</MudLink>
        <MudText Typo="Typo.caption" Style=" color: coral;line-height:1;">Evoluindo com você!</MudText>
        </div>
        @*aqui é o inverso, os botões abaixo só aparecem quando a tela estiver maior e todos os botões tem os links das paginas. *@
        <div class="d-none d-md-inline-flex">
        <MudButton Class="ms-9 mt-2"Size="Size.Small" Style="color:coral; font-weight:900;" Href="MonteTreino">Monte o seu Treino</MudButton>
        <MudButton Class="ms-7 mt-2" Size="Size.Small" Style="color:coral; font-weight:900;" Href="DicasTreino">Dicas de Treino</MudButton>
        <MudButton Class="ms-7 mt-2" Size="Size.Small" Style="color:coral; font-weight: 900;" Href="GanhoMaximo">Ganho Máximo</MudButton>
        </div>
        <MudSpacer />

        @*Botões condicionais: logado vs não logado*@
        @if (AuthService.IsLoggedIn)
        {
            <MudButton OnClick="@UserDrawerToggle"
                       Class="mt-2 ms-2"
                       Style="color:coral; text-transform:none; font-weight:bold;"
                       StartIcon="@Icons.Material.Filled.AccountCircle"
                       Size="Size.Small">
                @AuthService.NomeUsuario
            </MudButton>
        }
        else
        {
            <MudButton Href="Login" Class="mt-2 ms-2 d-md-inline-flex" Style="background-color:coral;font-weight: bold;" Size="Size.Small">Entrar</MudButton>
            <MudButton Href="Cadastrar" Class="mt-2 ms-2 d-md-inline-flex" Style="background-color:coral; font-weight: bold" Size="Size.Small">Cadastrar</MudButton>
        }

        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Style="color:coral" Class="mt-2" OnClick="@DarkModeToggle" />
    </MudAppBar>

    @*Função do menu de navegação onde ira aparecer quando tiver o botão Menu ativo. p*@
    <MudDrawer @bind-Open="_open" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="@DrawerVariant.Temporary" Style="background-color:transparent;backdrop-filter:blur(1px)">
        <NavMenu />
    </MudDrawer>

    @*Gaveteiro do usuário logado*@
    <MudDrawer @bind-Open="_userDrawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Variant="@DrawerVariant.Temporary"
               Anchor="Anchor.End"
               Style="background-color:transparent;backdrop-filter:blur(2px); min-width:250px;">
        <div class="pa-4" style="color:white;">
            <div class="d-flex align-center mb-4">
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Style="color:coral" Size="Size.Large" />
                <div class="ml-3">
                    <MudText Typo="Typo.h6" Style="color:coral; font-weight:bold;">@AuthService.NomeUsuario</MudText>
                    <MudText Typo="Typo.body2" Style="color:#aaa;">@AuthService.EmailUsuario</MudText>
                </div>
            </div>

            <MudDivider Style="--mud-palette-divider:coral" Class="mb-3" />

            <MudMenuItem OnClick="@(() => { _userDrawerOpen = false; NavigationManager.NavigateTo("/perfil", forceLoad: false); })" Style="color:white;">
                <MudText Typo="Typo.subtitle2" Style="font-weight:bold;font-size:0.95rem;">
                    Meu Perfil
                </MudText>
            </MudMenuItem>

            <MudDivider Style="--mud-palette-divider:coral" Class="my-1" />

            <MudMenuItem OnClick="@(() => { _userDrawerOpen = false; NavigationManager.NavigateTo("/MeusTreinos", forceLoad: false); })" Style="color:white;">
                <MudText Typo="Typo.subtitle2" Style="font-weight:bold;font-size:0.95rem;">
                    Meus Treinos
                </MudText>
            </MudMenuItem>

            <MudDivider Style="--mud-palette-divider:coral" Class="my-1" />

            <MudMenuItem OnClick="@(() => { _userDrawerOpen = false; NavigationManager.NavigateTo("/MinhasDietas", forceLoad: false); })" Style="color:white;">
                <MudText Typo="Typo.subtitle2" Style="font-weight:bold;font-size:0.95rem;">
                    Minhas Dietas
                </MudText>
            </MudMenuItem>

            <MudDivider Style="--mud-palette-divider:coral" Class="my-1" />

            <MudMenuItem OnClick="@(() => { _userDrawerOpen = false; NavigationManager.NavigateTo("/CalculadoraBio", forceLoad: false); })" Style="color:white;">
                <MudText Typo="Typo.subtitle2" Style="font-weight:bold;font-size:0.95rem;">
                    Calculadora Bio
                </MudText>
            </MudMenuItem>

            <MudDivider Style="--mud-palette-divider:coral" Class="my-1" />

            <MudMenuItem OnClick="@(async () => { _userDrawerOpen = false; await LogoutAsync(); })" Style="color:white;">
                <MudText Typo="Typo.subtitle2" Style="font-weight:bold;font-size:0.95rem;">
                    Sair
                </MudText>
            </MudMenuItem>
        </div>
    </MudDrawer>
    @*Imagem geral da pagina - background fixo na viewport, independente da pagina*@
<div style="@_backgroundStyle"></div>
<MudMainContent Style="display: flex; flex-direction: column; min-height: 100vh;">

        <div style="flex-grow: 1">
            @Body
        </div>
        
        <footer class="py-4 mt-0">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <MudGrid Justify="Justify.Center">
            <MudDivider Style="--mud-palette-divider:coral;" Class="d-flex flex-column ml-6"></MudDivider>
            @* Seção 1: Branding e Redes Sociais *@
            <MudItem xs="12" md="4" Class="d-flex flex-column align-center "  >
                <div class ="home-link d-flex flex-column justify-center ml-2 ">
                <MudLink Href="/"  Underline="Underline.None" Typo="Typo.h4" Style="color:coral !important; line-height: 1.2; font-weight: bold; text-align:center">FitUP</MudLink>

                </div>
                <div class="d-flex gap-2">
                    <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Style="color:coral" Href="https://linktr.ee/LinkedInMembros" Target="_blank" />
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Style="color:coral" Href="https://github.com/Ianclrs/FitUP" Target="_blank" />
                    <MudIconButton Icon="@Icons.Custom.Brands.Instagram" Style="color:coral" Href="https://linktr.ee/MembrosFitUp" Target="_blank" />
                            <MudIconButton Icon="@Icons.Material.Filled.Diversity3" Style="color:coral" Href="Indicacoes"></MudIconButton>
                </div>
            </MudItem>
            @* *@
        </MudGrid>
        @* Direitos Autorais *@
        <div class="d-flex flex-column justify-center flex-wrap">
            <MudText Typo="Typo.body2" Style="text-align:center; color:white">
                © @DateTime.Now.Year FitUP. Todos os direitos reservados.
            </MudText><br />
            <div class="d-flex gap-3 justify-center">
                <MudLink Href="/Privacidade" Target="_blank" Underline="Underline.None" Typo="Typo.body2" Style="color:white !important">Privacidade</MudLink>
                <MudLink Href="/Termos" Target="_blank" Underline="Underline.None" Typo="Typo.body2" Style="color:white!important">Termos de Uso</MudLink>
            </div>
        </div>
                
        </MudContainer>
        </footer>
        
    </MudMainContent>
</MudLayout>
    


@code {
    private bool _open = false;
    private bool _isDarkMode = true;
    private MudTheme? _theme;

    private string _backgroundImageDark = "img/Home.webp";
    private string _backgroundImageLight = "img/HomeL.webp";

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;

        await AuthService.RestoreSessionAsync();

        // Restaurar tema do localStorage
        try
        {
            var savedTheme = await JS.InvokeAsync<string>("localStorage.getItem", "fitup_theme");
            if (savedTheme == "light")
            {
                _isDarkMode = false;
            }
        }
        catch { /* ignora erro de JS interop */ }

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.AuthStateChanged -= OnAuthStateChanged;
    }

    private void DrawerToggle()
    {
        _open = !_open;
    }

    private bool _userDrawerOpen = false;

    private void UserDrawerToggle()
    {
        _userDrawerOpen = !_userDrawerOpen;
    }

    private async void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "fitup_theme", _isDarkMode ? "dark" : "light");
        }
        catch { /* ignora erro de JS interop */ }
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/", forceLoad: false);
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#ededed",
        Surface = "#e8e2da",
        TextPrimary = "#000000",
        DrawerIcon = "#ff7f50",
        Black = "#000000",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#000000",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
        Warning = "#f4a460",
        Error = "#8B0000",
        Success = "#008B8B",
        Secondary = "#2e8b57",
        Tertiary = "#8B4513",
        Dark = "#e8e2da",
        
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#5e3103",
        Surface = "#1f1d1b",
        Background = "#000000",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#ffffff",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#ff7f50",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#008B8B",
        Warning = "#f4a460",
        Error = "#8B0000",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
        Secondary = "#2e8b57",
        Tertiary = "#8B4513",
        Dark = "#1f1d1b"
    };

    private string _backgroundStyle => $"position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; background: url('{(_isDarkMode ? _backgroundImageDark : _backgroundImageLight)}') center/cover no-repeat;";

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.WbSunny,
        false => Icons.Material.Outlined.DarkMode,
    };
}