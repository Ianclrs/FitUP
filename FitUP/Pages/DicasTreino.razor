    private string _grupamentoAtivo = "";

    private void AlternarGrupamento(string grupamento)
    {
        _grupamentoAtivo = _grupamentoAtivo == grupamento ? "" : grupamento;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

            if (!string.IsNullOrEmpty(uri.Fragment))
            {
                var elementId = uri.Fragment.Substring(1);

                await Task.Delay(350);

                await JS.InvokeVoidAsync("eval", $"document.getElementById('{elementId}')?.scrollIntoView({{ behavior: 'smooth' }})");
            }
        }
    }

    private async Task AbrirDetalhes(TreinoModel treino)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
