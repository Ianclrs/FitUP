@page "/DicasTreino"
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
<PageTitle>Dicas de Treino</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 py-0 mb-8 animate-fade-in">

    <MudStack AlignItems="AlignItems.Center" Spacing="0" Class="mb-16">
        <div class="d-flex align-center justify-center">
            <MudText Typo="Typo.h4" Style="color:coral;font-family:Cambria;font-weight:bold">Dicas</MudText>
            <MudText Typo="Typo.h4" Class="ms-1" Style="font-family:Cambria; font-weight:bold">de</MudText>
            <MudText Typo="Typo.h4" Style="font-family:Cambria;font-weight:bold">Treino</MudText>
        </div>
        <div class="d-flex flex-column align-center justify-center" style="width: 100%;">
            <MudDivider Style="--mud-palette-divider:coral; max-width:400px; width:100%;" />
            <MudCard Elevation="12" Style="max-width:400px; width:100%; min-height:73px; height:auto;" Class="rounded-sm">
                <MudText Align="Align.Center" Class="pa-1">
                    Escolha o método ideal para o seu objetivo. Compare divisões de treino,
                    frequência e benefícios para evoluir com inteligência.
                </MudText>
            </MudCard>
        </div>
        <div class="d-flex gap-2 mt-2">
            <MudMenu Class="rounded-sm" Style="background-color: coral" Label="Superiores"> 
                <MudMenuItem OnClick='() => AlternarGrupamento("Peito")' Label="Peito" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Costas")' Label="Costas" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Ombro")' Label="Ombro" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Biceps")' Label="Bíceps" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Triceps")' Label="Tríceps" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Antebraco")' Label="Antebraços" />
            </MudMenu>
            <MudMenu Class="rounded-sm" Style="background-color:coral" Label="Central">
                <MudMenuItem OnClick='() => AlternarGrupamento("Abdomen")' Label="Abdômen" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Lombar")' Label="Lombar" />
            </MudMenu>
            <MudMenu Class="rounded-sm" Style="background-color:coral" Label="Inferiores">
                <MudMenuItem OnClick='() => AlternarGrupamento("Quadri")' Label="Quadríceps" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Posterior")' Label="Posteriores" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Pantu")' Label="Panturrilha" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Gluteo")' Label="Glúteos" />
            </MudMenu>
        </div>
    </MudStack>

    @* Container Elegante para os Textos Explicativos dos Músculos *@
    @if (!string.IsNullOrEmpty(_grupamentoAtivo))
    {

            @if (_grupamentoAtivo == "Peito")
            {
                <FitUP.Components.Grupamentos.DicaPeito />
            }

            @if (_grupamentoAtivo == "Costas")
            {
                <FitUP.Components.Grupamentos.DicaCostas />
            }

            @if (_grupamentoAtivo == "Ombro")
            {
                <FitUP.Components.Grupamentos.DicaOmbro />
            }

            @if (_grupamentoAtivo == "Biceps")
            {
                <FitUP.Components.Grupamentos.DicaBiceps />
            }

            @if (_grupamentoAtivo == "Triceps")
            {
                <FitUP.Components.Grupamentos.DicaTriceps />
            }

            @if (_grupamentoAtivo == "Antebraco")
            {
                <FitUP.Components.Grupamentos.DicaAntebraco />
            }

            @if (_grupamentoAtivo == "Abdomen")
            {
                <FitUP.Components.Grupamentos.DicaAbdomen />
            }

            @if (_grupamentoAtivo == "Lombar")
            {
                <FitUP.Components.Grupamentos.DicaLombar />
            }

            @if (_grupamentoAtivo == "Quadri")
            {
                <FitUP.Components.Grupamentos.DicaQuadri />
            }

            @if (_grupamentoAtivo == "Posterior")
            {
                <FitUP.Components.Grupamentos.DicaPosterior />
            }

            @if (_grupamentoAtivo == "Pantu")
            {
                <FitUP.Components.Grupamentos.DicaPantu />
            }

            @if (_grupamentoAtivo == "Gluteo")
            {
                <FitUP.Components.Grupamentos.DicaGluteo />
            }

        
    }

    <MudGrid Spacing="5" Class="px-4">
        @foreach (var treino in ListaTreinos)
        {
            @* Geração dinâmica do ID para a âncora (Ex: "upper-lower", "full-body") *@
            var idAncora = treino.Nome.ToLower().Replace(" ", "-").Replace("/", "-");

            <MudItem xs="12" id="@idAncora" Class="mb-20 mt-20">
                <MudGrid Class="@(treino.Inverter ? "flex-row-reverse align-center" : "align-center")">

                    <MudItem xs="12" md="5">
                        <MudPaper Elevation="4"
                                  Class="training-card p-8 d-flex flex-column align-center justify-center"
                                  Style="@($"background: {treino.CardGradient};")">
                            <div class="icon-bubble">
                                <MudIcon Icon="@treino.Icone" Style="font-size: 3rem; color: #fff;" />
                            </div>
                            <MudText Style="font-size:0.7rem;font-weight:700;letter-spacing:0.3em;text-transform:uppercase;color:rgba(255,255,255,0.6);" Class="mt-5">
                                Treino
                            </MudText>
                            <MudText Typo="Typo.h4" Class="mt-1 white-text font-bold text-center">@treino.Nome</MudText>
                            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.75);" Class="mt-2 text-center">@treino.Tagline</MudText>
                            <MudChip T="string" Color="Color.Surface" Variant="Variant.Text" Class="coral-text mt-2">
                                @treino.Frequencia
                            </MudChip>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="7" Class="d-flex flex-column justify-center">
                        <div class="px-4">
                            <MudText Typo="Typo.h4" Style="font-family:cambria; font-weight:bold; color:coral" Class=" mb-2">@treino.Nome</MudText>

                            <MudCard Elevation="12" Class="mb-2" Style="border:1px solid coral">
                                <MudText Typo="Typo.body1" Align="Align.Center" Class="white-text mb-2 ms-1 me-1 mt-2">@treino.Descricao</MudText>

                                <MudText Style="font-size:0.75rem;font-weight:bold;text-transform:uppercase;letter-spacing:0.12em;color:coral" Class="mb-3 ms-2">
                                    Benefícios
                                </MudText>
                                <MudGrid Spacing="2" Class="mb-2">
                                    @foreach (var b in treino.Beneficios)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <div class="d-flex align-start gap-2 ms-2">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                         Style="color:coral;font-size:1.1rem;margin-top:2px;flex-shrink:0;" />
                                                <MudText Typo="Typo.body2" Class="white-text">@b</MudText>
                                            </div>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudCard>

                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <div class="info-chip coral-border rounded mb-2 mud-theme-dark">
                                        <div class="d-flex align-center gap-2 mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth"
                                                     Style="color:coral;font-size:1rem;" />
                                            <MudText Class="white-text" Style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;">
                                                Frequência
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="white-text ms-1" Style="font-weight:600;">@treino.Frequencia</MudText>
                                    </div>
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <div class="info-chip coral-border rounded mb-2 mud-theme-dark">
                                        <div class="d-flex align-center gap-2 mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Group"
                                                     Style="color:coral;font-size:1rem" />
                                            <MudText Class="white-text" Style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;">
                                                Indicado para
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="white-text " Style="font-weight:600;">@treino.Publico</MudText>
                                    </div>
                                </MudItem>
                            </MudGrid>
                            <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Text"
                                       Style="background-color:coral"
                                       Class="scale-hover"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="@(async () => await AbrirDetalhes(treino))">
                                Saiba Mais
                            </MudButton>
                            <MudButton Style="background-color:coral" Class="scale-hover" OnClick="@(() => AbrirExemplo(treino))">
                                Exemplo de Treino
                            </MudButton>
                           </div>
                        
                        </div>
                    </MudItem>
                </MudGrid>
            </MudItem>
        }
    </MudGrid>

    @* ========== SEÇÃO TÉCNICAS AVANÇADAS ========== *@
    <MudStack AlignItems="AlignItems.Center" Spacing="0" Class="mb-16 mt-16">
        <div class="d-flex align-center justify-center">
            <MudText Typo="Typo.h4" Style="color:coral;font-family:Cambria;font-weight:bold">Técnicas</MudText>
            <MudText Typo="Typo.h4" Class="ms-1" Style="font-family:Cambria; font-weight:bold">Avançadas</MudText>
        </div>
        <div class="d-flex flex-column align-center justify-center" style="width: 100%;">
            <MudDivider Style="--mud-palette-divider:coral; max-width:400px; width:100%;" />
            <MudCard Elevation="12" Style="max-width:500px; width:100%; min-height:73px; height:auto;" Class="rounded-sm">
                <MudText Align="Align.Center" Class="pa-1">
                    Leve seu treino ao próximo nível com métodos de intensidade avançada. 
                    Drop Set, Rest-Pause, Bi-Set, Pirâmide e muito mais para quebrar platôs e maximizar a hipertrofia.
                </MudText>
            </MudCard>
        </div>
    </MudStack>

    <MudGrid Spacing="5" Class="px-4">
        @foreach (var tecnica in ListaTecnicas)
        {
            var idAncoraTec = tecnica.Nome.ToLower().Replace(" ", "-").Replace("/", "-");

            <MudItem xs="12" id="@idAncoraTec" Class="mb-20 mt-20">
                <MudGrid Class="@(tecnica.Inverter ? "flex-row-reverse align-center" : "align-center")">

                    <MudItem xs="12" md="5">
                        <MudPaper Elevation="4"
                                  Class="training-card p-8 d-flex flex-column align-center justify-center"
                                  Style="@($"background: {tecnica.CardGradient};")">
                            <div class="icon-bubble">
                                <MudIcon Icon="@tecnica.Icone" Style="font-size: 3rem; color: #fff;" />
                            </div>
                            <MudText Style="font-size:0.7rem;font-weight:700;letter-spacing:0.3em;text-transform:uppercase;color:rgba(255,255,255,0.6);" Class="mt-5">
                                Técnica
                            </MudText>
                            <MudText Typo="Typo.h4" Class="mt-1 white-text font-bold text-center">@tecnica.Nome</MudText>
                            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.75);" Class="mt-2 text-center">@tecnica.Tagline</MudText>
                            <MudChip T="string" Color="Color.Surface" Variant="Variant.Text" Class="coral-text mt-2">
                                @tecnica.Nivel
                            </MudChip>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="7" Class="d-flex flex-column justify-center">
                        <div class="px-4">
                            <MudText Typo="Typo.h4" Style="font-family:cambria; font-weight:bold; color:coral" Class="mb-2">@tecnica.Nome</MudText>

                            <MudCard Elevation="12" Class="mb-2" Style="border:1px solid coral">
                                <MudText Typo="Typo.body1" Align="Align.Center" Class="white-text mb-2 ms-1 me-1 mt-2">@tecnica.Descricao</MudText>

                                <MudText Style="font-size:0.75rem;font-weight:bold;text-transform:uppercase;letter-spacing:0.12em;color:coral" Class="mb-3 ms-2">
                                    Benefícios
                                </MudText>
                                <MudGrid Spacing="2" Class="mb-2">
                                    @foreach (var b in tecnica.Beneficios)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <div class="d-flex align-start gap-2 ms-2">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                         Style="color:coral;font-size:1.1rem;margin-top:2px;flex-shrink:0;" />
                                                <MudText Typo="Typo.body2" Class="white-text">@b</MudText>
                                            </div>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudCard>

                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <div class="info-chip coral-border rounded mb-2 mud-theme-dark">
                                        <div class="d-flex align-center gap-2 mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.FlashOn"
                                                     Style="color:coral;font-size:1rem;" />
                                            <MudText Class="white-text" Style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;">
                                                Quando Usar
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="white-text ms-1" Style="font-weight:600;">@tecnica.QuandoUsar</MudText>
                                    </div>
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <div class="info-chip coral-border rounded mb-2 mud-theme-dark">
                                        <div class="d-flex align-center gap-2 mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter"
                                                     Style="color:coral;font-size:1rem" />
                                            <MudText Class="white-text" Style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;">
                                                Nível
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="white-text" Style="font-weight:600;">@tecnica.Nivel</MudText>
                                    </div>
                                </MudItem>
                            </MudGrid>
                            <div class="d-flex gap-2">
                                <MudButton Variant="Variant.Text"
                                           Style="background-color:coral"
                                           Class="scale-hover"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           OnClick="@(async () => await AbrirDetalhesTecnica(tecnica))">
                                    Saiba Mais
                                </MudButton>
                                <MudButton Style="background-color:coral" Class="scale-hover" OnClick="@(() => AbrirExemploTecnica(tecnica))">
                                    Exemplo Prático
                                </MudButton>
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudItem>
        }
    </MudGrid>

</MudContainer>

<style>
    .scale-hover:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease-in-out
    }

    :root {
        --coral-orange: #FF6B35;
    }

    .coral-text {
        color: var(--coral-orange) !important;
    }

    .coral-border {
        border-color: var(--coral-orange) !important;
    }

    .white-text {
        color: var(--mud-palette-text-primary) !important;
    }

    .training-card {
        border-radius: 20px;
        transition: transform 0.3s, box-shadow 0.3s;
        min-height: 300px;
        position: relative;
        overflow: hidden;
    }

        .training-card::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom right, rgba(0,0,0,0.35), transparent, rgba(0,0,0,0.65));
            pointer-events: none;
        }

        .training-card > * {
            position: relative;
            z-index: 1;
        }

        .training-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 40px -8px rgba(255,107,53,0.45) !important;
            border: 1px solid var(--coral-orange);
        }

    .icon-bubble {
        width: 88px;
        height: 88px;
        border-radius: 18px;
        background: linear-gradient(135deg, #FF6B35, #FF9A6C);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 32px -8px rgba(255,107,53,0.5);
        transition: transform 0.4s ease;
    }

    .training-card:hover .icon-bubble {
        transform: scale(1.08) rotate(3deg);
    }

    .coral-chip {
        background: rgba(255,107,53,0.12) !important;
        color: var(--coral-orange) !important;
        border: 1px solid rgba(255,107,53,0.38) !important;
        font-weight: 700 !important;
        font-size: 0.7rem !important;
        letter-spacing: 0.15em !important;
        text-transform: uppercase !important;
        border-radius: 999px !important;
    }

    .info-chip {
        border-radius: 14px;
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-background-grey);
        padding: 0.875rem 1rem;
    }

    .animate-fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private string _grupamentoAtivo = "";

    private void AlternarGrupamento(string grupamento)
    {
        _grupamentoAtivo = _grupamentoAtivo == grupamento ? "" : grupamento;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

            if (!string.IsNullOrEmpty(uri.Fragment))
            {
                var elementId = uri.Fragment.Substring(1);

                await Task.Delay(350);

                await JS.InvokeVoidAsync("eval", $"document.getElementById('{elementId}')?.scrollIntoView({{ behavior: 'smooth' }})");
            }
        }
    }

    private async Task AbrirDetalhes(TreinoModel treino)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<MensagemCustomizada>
        {
            { x => x.Titulo,   treino.Nome      },
            { x => x.Conteudo, treino.Explicacao }
        };

        await DialogService.ShowAsync<MensagemCustomizada>("Detalhes do Treino", parameters, options);
    }
    private async Task AbrirExemplo(TreinoModel treino)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        // Monta a tabela em HTML puro estruturado com classes globais do MudBlazor
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class='mud-table mud-simple-table mud-table-bordered mud-table-striped mud-elevation-1 mt-2'>");
        sb.Append("  <div class='mud-table-container'>");
        sb.Append("    <table class='mud-table-root'>");
        sb.Append("      <thead class='mud-table-head' style='background-color: rgba(255,107,53,0.1);'>");
        sb.Append("        <tr class='mud-table-row'>");
        sb.Append("          <th class='mud-table-cell' style='color:coral; font-weight:bold;'>Dia</th>");
        sb.Append("          <th class='mud-table-cell' style='color:coral; font-weight:bold;'>Divisão</th>");
        sb.Append("          <th class='mud-table-cell' style='color:coral; font-weight:bold;'>Foco Principal</th>");
        sb.Append("        </tr>");
        sb.Append("      </thead>");
        sb.Append("      <tbody class='mud-table-body'>");

        foreach (var item in treino.CronogramaSemanal)
        {
            sb.Append("    <tr class='mud-table-row'>");
            sb.Append($"     <td class='mud-table-cell'><b>{item.Dia}</b></td>");
            sb.Append($"     <td class='mud-table-cell'>{item.Rotina}</td>");
            sb.Append($"     <td class='mud-table-cell'>{item.Foco}</td>");
            sb.Append("    </tr>");
        }

        sb.Append("      </tbody>");
        sb.Append("    </table>");
        sb.Append("  </div>");
        sb.Append("</div>");

        var parameters = new DialogParameters<MensagemCustomizada>
    {
        { x => x.Titulo, $"Rotina Semanal: {treino.Nome}" },
        { x => x.Conteudo, sb.ToString() } // Passa a tabela gerada
    };

        await DialogService.ShowAsync<MensagemCustomizada>("Exemplo de Treino", parameters, options);
    }

    private List<TreinoModel> ListaTreinos = new()
    {

        new TreinoModel
        {
            Nome        = "Upper / Lower",
            Tagline     = "Equilíbrio entre volume e recuperação",
            Descricao   = "É um estilo de treino onde divide o treino em dois blocos: Upper onde o foco é a parte superior do corpo, fazendo pelo menos um exercício para os músculos englobados e Lower que trabalha a parte inferior do corpo seguindo a mesma ideia do anterior, sendo feito no dia subsequente. Execelente para quem treina 4 vezes por semana.",
            Frequencia  = "4 dias/semana",
            Publico     = "Intermediários e avançados",
            Icone       = Icons.Material.Filled.FitnessCenter,
            Inverter    = false,
            CardGradient = "linear-gradient(135deg, #3a1f14 0%, #1c1008 100%)",
            Beneficios  = new() { "Boa frequência por grupamento", "Recuperação adequada", "Volume bem distribuído", "Fácil de progredir" },
            Explicacao  = "O formato mais consagrado é o ciclo de 4 dias por semana. Isso deixa 3 dias inteiros para a recuperação sistêmica e muscular. Uma abordagem excelente é focar o treino 'A' em cargas maiores (força) e o treino 'B' em repetições um pouco mais altas (hipertrofia).",
            CronogramaSemanal = new()
            {
                new() { Dia = "Segunda", Rotina = "Upper", Foco = "Peito, Costas, Ombros e Braços" },
                new() { Dia = "Terça", Rotina = "Lower", Foco = "Quadríceps, Posterior e Panturrilha" },
                new() { Dia = "Quarta", Rotina = "Descanso", Foco = "Recuperação Ativa / Cardio Leve" },
                new() { Dia = "Quinta", Rotina = "Upper", Foco = "Peito, Costas, Ombros e Braços" },
                new() { Dia = "Sexta", Rotina = "Lower", Foco = "Quadríceps, Posterior e Glúteos" },
                new() { Dia = "Sábado", Rotina = "Descanso", Foco = "Recuperação Ativa / Cardio Leve" },
                new() { Dia = "Domingo", Rotina = "Descanso", Foco = "Repouso Total" }
            }
        },
        new TreinoModel
        {
            Nome        = "Full Body",
            Tagline     = "Corpo inteiro em cada sessão",
            Descricao   = "A premissa do Fullbody é estimular todos os grandes grupos musculares do corpo (peito, costas, pernas e ombros) em uma única sessão. Em vez de treinar de 4 a 6 vezes por semana, o foco muda para 3 vezes na semana, com dias de descanso total intercalados.",
            Frequencia  = "3 dias/semana",
            Publico     = "Iniciantes e intermediários",
            Icone       = Icons.Material.Filled.AccessibilityNew,
