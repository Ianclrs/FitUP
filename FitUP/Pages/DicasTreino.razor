@page "/DicasTreino"
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 py-0 mb-8 animate-fade-in">

    <MudStack AlignItems="AlignItems.Center" Spacing="0" Class="mb-16">
        <div class="d-flex align-center justify-center">
            <MudText Typo="Typo.h4" Style="color:coral;font-family:Cambria;font-weight:bold">Dicas</MudText>
            <MudText Typo="Typo.h4" Class="ms-1" Style="font-family:Cambria; font-weight:bold">de</MudText>
            <MudText Typo="Typo.h4" Style="font-family:Cambria;font-weight:bold">Treino</MudText>
        </div>
        <div class="d-flex flex-column align-center justify-center" style="width: 100%;">
            <MudDivider Style="--mud-palette-divider:coral; max-width:400px; width:100%;" />
            <MudCard Elevation="12" Style="max-width:400px; width:100%; min-height:73px; height:auto;" Class="rounded-sm">
                <MudText Align="Align.Center" Class="pa-1">
                    Escolha o método ideal para o seu objetivo. Compare divisões de treino,
                    frequência e benefícios para evoluir com inteligência.
                </MudText>
            </MudCard>
        </div>
        <div class="d-flex gap-2 mt-2">
            <MudMenu Class="rounded-sm" Style="background-color: coral" Label="Superiores"> 
                <MudMenuItem OnClick='() => AlternarGrupamento("Peito")' Label="Peito" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Costas")' Label="Costas" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Ombro")' Label="Ombro" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Biceps")' Label="Bíceps" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Triceps")' Label="Tríceps" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Antebraco")' Label="Antebraços" />
            </MudMenu>
            <MudMenu Class="rounded-sm" Style="background-color:coral" Label="Central">
                <MudMenuItem OnClick='() => AlternarGrupamento("Abdomen")' Label="Abdômen" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Lombar")' Label="Lombar" />
            </MudMenu>
            <MudMenu Class="rounded-sm" Style="background-color:coral" Label="Inferiores">
                <MudMenuItem OnClick='() => AlternarGrupamento("Quadri")' Label="Quadríceps" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Posterior")' Label="Posteriores" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Pantu")' Label="Panturrilha" />
                <MudMenuItem OnClick='() => AlternarGrupamento("Gluteo")' Label="Glúteos" />
            </MudMenu>
        </div>
    </MudStack>

    @* Container Elegante para os Textos Explicativos dos Músculos *@
    @if (!string.IsNullOrEmpty(_grupamentoAtivo))
    {

            @if (_grupamentoAtivo == "Peito")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-0">

                <MudGrid Justify="Justify.Center" Class="align-center" Spacing="1">

                    <MudItem xs="12" md="7" Class="d-flex flex-column">

                        <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-3">
                            Peitoral (Maior e Menor)
                        </MudText>

                        <MudPaper Elevation="15" Class="d-flex flex-column pa-2" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.body1" Class="mb-3">
                                <strong>Função:</strong> O peitoral é um dos agrupamentos musculares mais visados na musculação, tanto pela estética quanto pela sua importância funcional no complexo do ombro. Para extrair o máximo de desenvolvimento desse músculo, é preciso entender como ele se divide, a orientação de suas fibras e a biomecânica por trás dos exercícios.
                            </MudText>
                            <MudText Typo="Typo.body1">
                                <strong>Anatomia e Divisões Funcionais:</strong> O que chamamos popularmente de "peito" é composto por dois músculos principais: o peitoral maior (o músculo grande e superficial) e o peitoral menor (um músculo profundo, localizado abaixo do maior).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                        <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/supinoreto.png"
                                  Alt="Anatomia do Peitoral"
                                  Elevation="15"
                                  Class="rounded-lg mt-0 mt-md-0"
                                  Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                    <li class="mb-1"><b>Supino Reto:</b> Exercício que trabalha por completo o peitoral.</li>
                            </ul>   
                        </MudText>
                        </MudPaper>
                    </MudItem>

                </MudGrid>
                <MudDivider Class="my-4" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">

        
                    <MudItem xs="12" md="7" Class="d-flex flex-column">

                        <MudPaper Elevation="15" Class="d-flex flex-column pa-2 mt-2" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Peitoral Maior
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                É um músculo em formato de leque. Embora seja uma peça única de tecido, ele é dividido funcionalmente em porções baseadas na origem de suas fibras, pois cada parte responde melhor a diferentes ângulos de movimento:<br /><br />
                                <ul style="color: var(--mud-palette-text-primary); padding-left: 20px; font-size: 0.875rem;">
                                    <li class="mb-1"><b>Porção Clavicular (Superior):</b> Origina-se na metade interna da clavícula. Suas fibras correm de cima para baixo e para fora, inserindo-se no braço (úmero).</li>
                                    <li class="mb-1"><b>Porção Esternocostal (Medial/Inferior):</b> É a maior parte do peito. Origina-se no esterno (osso do centro do peito) e nas cartilagens das primeiras seis costelas. Suas fibras correm horizontalmente e de baixo para cima em direção ao braço.</li>
                                    <li class="mb-1"><b>Porção Abdominal (Inferior):</b> Uma subdivisão mais baixa que se origina na bainha do músculo reto do abdômen e puxa o braço para baixo e para dentro.</li>
                                    <li class="mb-1"><b>O Ponto de Inserção:</b> Todas as fibras do peitoral maior se convergem em um único tendão que se fixa na parte anterior do úmero (o osso do braço). Isso significa que a principal função do peito não é mover as mãos, mas sim mover o braço em direção ao centro do corpo.</li>
                                </ul>
                            </MudText>
                        </MudPaper>
                    </MudItem>

        
                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                        <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/supinclinado.png"
                                  Alt="Anatomia do Peitoral Maior"
                                  Elevation="15"
                                  Class="rounded-lg mt-0 mt-md-0"
                                  Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                    <li class="mb-1"><b>Supino Inclinado:</b> Um ótimo exercício que trabalha a porção superior do peitoral.</li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

    
                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">

                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Peitoral Menor
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                Músculo plano e triangular que fica escondido abaixo do peitoral maior. Ele não se insere no braço, mas sim no processo coracoide da escápula (omoplata). Sua função é estabilizar, deprimir (puxar para baixo) e protrair (jogar para a frente) a escápula.
                            </MudText>

                            <MudText Typo="Typo.body1" Style="color:coral; font-weight:bold;" Class="mt-2 mb-1">
                                Funções Biomecânicas (Ações Populares)
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                Para recrutar o peitoral ao máximo, o foco deve ser realizar as ações anatômicas que ele comanda:
                            </MudText>

                            <ul style="color: var(--mud-palette-text-primary); padding-left: 20px; font-size: 0.875rem;">
                                <li class="mb-1"><b>Adução Horizontal:</b> Trazer os braços que estão abertos em linha reta para a frente do corpo (ex: movimento do crucifixo ou voador).</li>
                                <li class="mb-1"><b>Flexão do Ombro:</b> Levantar o braço para a frente (função principal da porção superior/clavicular).</li>
                                <li class="mb-1"><b>Extensão do Ombro:</b> Trazer o braço de cima para baixo (função principal da porção inferior/abdominal).</li>
                                <li class="mb-1"><b>Rotação Interna:</b> Girar o braço para dentro, em direção ao eixo do próprio corpo.</li>
                            </ul>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                        <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/cruxifixo.png"
                                  Alt="Anatomia do Peitoral Menor"
                                  Elevation="15"
                                  Class="rounded-lg mt-0 mt-md-0"
                                  Style="width: 100%; max-width: 420px; object-fit: cover;" />

                        
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Cruxifíxo:</b> Trabalha principalmente o peitoral maior e o deltoide anterior. </li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

    
                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">

        
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Maximizando a Hipertrofia: Seleção de Exercícios
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                Para construir um peitoral estético e proporcional, o treino deve estimular todas as subdivisões respeitando o alinhamento das fibras.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco na Porção Superior (Clavicular)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Para atingir o "peito alto", o braço precisa subir e entrar em direção ao centro. O ângulo ideal do banco geralmente fica entre 30° e 45°. Ângulos maiores começam a transferir o esforço excessivamente para o deltoide anterior.<br />
                                <strong>Exercícios-chave:</strong> Supino inclinado (halteres ou barra), crucifixo inclinado, e crossover polia baixa.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco na Porção Medial e Global (Esternocostal)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Aqui as fibras correm na horizontal. Exercícios em bancos planos oferecem o melhor alinhamento mecânico para gerar força máxima.<br />
                                <strong>Exercícios-chave:</strong> Supino reto (barra ou halteres), voador/peck deck, e supino articulado.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco na Porção Inferior (Abdominal/Costal)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Para desenhar a linha inferior, o movimento deve empurrar para baixo ou trazer o braço de cima em direção à cintura.<br />
                                <strong>Exercícios-chave:</strong> Supino declinado, paralelas (tronco inclinado) e crossover polia alta.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Deve ser estimulado em ângulos diferentes para um aspecto estético preenchido.
                            </MudText>
                        </MudPaper>
                    </MudItem>

        
                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">                        
                        <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/crossover.png"
                                  Alt="Exercícios para Peitoral"
                                  Elevation="15"
                                  Class="rounded-lg mt-0 mt-md-0"
                                  Style="width: 100%; max-width: 420px; object-fit: cover;" />

                        
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                    <li class="mb-1"><b>CrossOver:</b> Exercício versatíl onde dependendo da variação consegue recrutar partes diferentes do peitoral, tanto maior ou menor.</li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

            @if (_grupamentoAtivo == "Costas")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Dorsais / Costas (Latíssimo do Dorso, Trapézio, Romboides e Redondos)
                </MudText>

   
                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Função Anatômica
                            </MudText>
                            <MudText Typo="Typo.body1">
                                As costas formam o complexo muscular mais amplo, detalhado e visualmente complexo do corpo humano. Desenvolver uma musculatura dorsal imponente não é apenas o segredo para construir o cobiçado "shape em V" (que afunila em direção à cintura, criando uma ilusão de ótica que a faz parecer menor), mas é também a base de sustentação para uma postura impecável e para a saúde dos ombros.
                                <br /><br />
                                Para dominar o treino de costas, precisamos entender que ele não se resume a "puxar". É necessário mapear a anatomia dessa imensidão de músculos e alinhar as puxadas e remadas com a direção correta de suas fibras.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/p.alta.png" Alt="Complexo Dorsal" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Puxada Alta:</b>Exercíco fundamental, auxilia na postura, desenvolve a largura das costas por focar no grande dorsal.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-6" Style="--mud-palette-divider: coral" />

    
                <MudGrid Justify="Justify.Center" Class="align-center  mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia do Complexo Dorsal
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                O dorso é composto por dezenas de músculos sobrepostos. Para simplificar o treino, nós o dividimos em três áreas funcionais principais:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Latíssimo do Dorso (Grande Dorsal)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                É o maior músculo das costas e o principal responsável pela largura (as famosas "asas"). Suas fibras correm diagonalmente para cima e para fora até se inserirem no braço. Quando bem desenvolvido, se projeta para os lados, aparecendo mesmo visto de frente.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Trapézio (Completo)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                É gigantesco e desce até o meio das costas, dividido em três porções:
                                <b>Superior</b> (eleva as escápulas/dar de ombros);
                                <b>Médio</b> (junta as escápulas horizontalmente); e
                                <b>Inferior</b> (puxa as escápulas para baixo).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Romboides e Redondo Maior
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Localizados logo abaixo do trapézio médio, ligam a coluna à borda interna da escápula. São os responsáveis por criar o "miolo das costas", dando aquele aspecto tridimensional de nós e relevos quando contraídas.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/r.baixa.png" Alt="Divisões das Costas" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Remada Baixa:</b>Auxilia no fortalecimento e na espessura das costas, trabalhando na grande dorsal e trapézio.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

    
                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Vetores de Movimento e Exercícios
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                Como as costas possuem músculos correndo em várias direções, o treino precisa obrigatoriamente ser dividido em dois vetores fundamentais:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Vetor Vertical (Puxadas - Foco em Largura)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Movimento de cima para baixo. Recruta massivamente o latíssimo do dorso. <br />
                                <strong>Exercícios-chave:</strong> Barra Fixa (Pull-up / Chin-up) e Puxada Alta no Pulley (uma pegada na largura dos ombros ou ligeiramente mais aberta oferece o melhor alinhamento mecânico).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Vetor Horizontal (Remadas - Foco em Espessura/Densidade)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Movimento de frente para trás focado na retração escapular para construir o miolo.<br />
                                <strong>Exercícios-chave:</strong> Remada Curvada com Barra (massa bruta), Remada Cavalinho (pegada neutra que aumenta o estiramento do latíssimo) e Remada Unilateral com Halter/Serrote (corrige assimetrias puxando em arco em direção ao quadril).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/v.invertido.png" Alt="Vetores de Treino" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Voador Invertido:</b>Mesmo trabalhando o deltoide posterior, é uma boa pedida no treino de costas pois recruta o trapézio e o romboide, assim fortalecendo a parte superior das costas.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

    
                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Conexão Mente-Músculo e Escápulas
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                O Caminho do Cotovelo
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                A mão é apenas um gancho; o seu foco mental deve ser <b>puxar com o cotovelo</b>. Cotovelos colados ao tronco (pegada neutra/supinada) focam na porção inferior do latíssimo. Cotovelos abertos a 45° ou 90° (pegada pronada aberta) jogam a tensão no trapézio médio, romboides e deltoide posterior.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                Ação Escapular: O Gatilho da Contração
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                O movimento das costas começa nas escápulas, não nos braços. Na puxada, primeiro deprima os ombros antes de flexionar os braços. Na remada, esmague as escápulas uma contra a outra (como se quisesse prender uma caneta entre elas) ao puxar o peso.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Dividimos o treino de costas em dois estímulos: puxadas (para dar largura/amplitude) e remadas (para dar densidade/espessura).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="400px" Class="rounded-lg">
                        <MudImage Src="img-dt/pulldown.png" Alt="Movimento Escapular" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:400px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Pull Down:</b> Exercício isolado para as costas e também recrutando os tríceps.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

            @if (_grupamentoAtivo == "Ombro")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Deltoides / Ombros (Anterior, Lateral e Posterior)
                </MudText>


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Função e Articulação
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                O complexo do ombro é o agrupamento muscular que coroa o físico. Ele é o responsável por dar largura ao tronco, criar a ilusão de uma cintura mais fina e desenhar o aspecto tridimensional e esférico dos braços (o famoso ombro "bola de boliche").
                                <br /><br />
                                Diferente de articulações estáveis como o joelho, o ombro é a articulação mais móvel e, por consequência, a mais instável e vulnerável do corpo humano. Entender sua biomecânica é o único caminho para construir ombros massivos sem acumular lesões crônicas.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/e.lat.png" Alt="Complexo do Ombro" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Elevação Lateral:</b>Exercício focado em isolar e trabalhar o deltoide lateral.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia das Três Cabeças do Deltoide
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                O deltoide é um músculo único, mas dividido em três porções ou "cabeças" distintas que se unem na mesma inserção no osso do braço (úmero):
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Deltoide Anterior (Frontal)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Origina-se na clavícula e faz a flexão do ombro (levantar o braço para a frente). É massivamente recrutado em todos os exercícios de empurrar (supinos e desenvolvimentos), raramente sendo uma porção fraca no físico.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Deltoide Lateral (Medial)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Origina-se no acrômio. É a porção mais importante para dar largura e o aspecto de "V" ao shape. Como não participa diretamente de supinos ou remadas pesadas, precisa ser isolada com inteligência.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Deltoide Posterior
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Origina-se na escápula e joga o braço para trás (extensão horizontal). É o principal responsável pelo aspecto "3D" do ombro de perfil ou de costas. Costuma ser a porção mais negligenciada e fraca na maioria das pessoas.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/desenv.png" Alt="As três porções do Deltoide" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Desenvolvimento:</b>Um exercício tradicional e funcinal onde trabalha o deltóide frontal e lateral.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Seleção de Exercícios Eficientes
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco em Força Bruta e Porção Anterior
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>Desenvolvimento (Halteres ou Barra):</b> O exercício base para construir ombros massivos empurrando a carga verticalmente acima da cabeça.<br />
                                <b>Elevação Frontal:</b> Trabalho isolado (opcional se os seus treinos de supino e desenvolvimento já forem pesados).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco em Largura (Deltoide Lateral)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>Elevação Lateral com Halteres:</b> Pense em empurrar os halteres para as paredes laterais, e não em puxá-los para cima.<br />
                                <b>Elevação Lateral na Polia Baixa:</b> Superior aos halteres mecanicamente, pois mantém a tensão constante durante todo o movimento, inclusive no início embaixo.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco em Tridimensionalidade (Deltoide Posterior)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <b>Crucifixo Invertido:</b> Foco em abrir os braços para trás sem juntar excessivamente as escápulas para isolar o ombro e retirar o trapézio.<br />
                                <b>Face Pull:</b> Feito na polia alta com corda. Excelente para hipertrofia do posterior, fortalecimento dos rotadores externos e correção postural.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                        <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/r.alta.png" Alt="Exercícios para Deltoides" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Remada Alta:</b>Focado em fortalecer e definir os ombros, onde trabalha a porção lateral e o trapézio.</li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Preservando a Articulação do Ombro
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                O Perigo da Elevação Lateral: O Espaço Subacromial
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                O erro mais comum é subir os braços com rotação interna pura ("virando a garrafinha"). Isso colide o úmero contra o acrômio, esmagando o tendão do supraespinhal e a bursa (Síndrome do Impacto).
                                <br />
                                <b>A Elevação Perfeita:</b> Realize o movimento no <i>plano escapular</i> (cerca de 30° à frente do corpo). Mantenha os cotovelos levemente destravados e nunca aponte o polegar para o chão. Suba apenas até a linha dos ombros (90°) para não transferir a tensão para o trapézio.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                O Manguito Rotador: A Blindagem Invisível
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Grupo de quatro músculos profundos (<b>Supraespinhal, Infraespinhal, Redondo Menor e Subescapular</b>) cuja única função é abraçar o osso do braço e mantê-lo colado na articulação. Fazer rotações externas na polia ou elástico serve para ativar e aquecer esses estabilizadores, garantindo suporte para progredir carga com segurança nos treinos pesados.
                            </MudText>
                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> A porção anterior já é muito exigida nos supinos de peito. Por isso, no treino isolado de ombro, o foco principal deve ser nas porções lateral e posterior para garantir simetria e proteger a articulação contra lesões.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="390px" Class="rounded-lg">
                        <MudImage Src="img-dt/r.frontal.png" Alt="Manguito Rotador e Anatomia Humana" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 390px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:390px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Elevação Frontal:</b>Trabalha a porção do deltóide anterior, podendo sim recrutar músculos auxiliares, como o peitoral maior, o serrátil, o trapézio e o core.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

            @if (_grupamentoAtivo == "Biceps")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Bíceps Braquial e Braquial
                </MudText>

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Função Muscular
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                O bíceps femoral (que faz parte do treino de posteriores) tem um primo muito mais famoso na parte superior do corpo: o bíceps braquial. Localizado na parte anterior do braço, ele é historicamente o músculo que simboliza a força e a musculação.
                                <br /><br />
                                Construir bíceps que impressionam — com o famoso pico quando contraídos e espessura quando vistos de frente — exige ir muito além de simplesmente dobrar o cotovelo com carga. É preciso entender como suas duas cabeças se comportam e como a posição do seu ombro muda completamente o foco do exercício.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                    <MudPaper MaxWidth="420px"  Class="rounded-lg">
                        <MudImage Src="img-dt/r.direta.png" Alt="Visão Geral do Bíceps" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover; max-height: 420px" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                            <li class="mb-1"><b>Rosca Direta:</b> Um dos exercícios mais clássico e eficiente da musculação focado no fortalecimento e na hipertrofia dos bíceps.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia e Funções Biomecânicas
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                O termo "bíceps" significa "duas cabeças". Ambas se originam na escápula, cruzam o cotovelo e se fundem em um único tendão inserido no antebraço. Embora seja focado em puxar, o bíceps é um músculo trifuncional:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Cabeça Longa (Porção Externa) e o Pico
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Fica na parte de fora do braço e cruza a articulação do ombro. É a grande responsável por criar a altura do bíceps (o famoso "pico" na pose de duplo bíceps). Suas principais funções são a <b>Flexão do Cotovelo</b> e o auxílio na <b>Flexão Sutil do Ombro</b>.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Cabeça Curta (Porção Interna) e Largura
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Fica na porção interna do braço (voltada para o peito) e é responsável pelo preenchimento e largura quando visto de frente. Atua fortemente na <b>Supinação do Antebraço</b> (girar o punho para cima), sendo o supinador mais poderoso do corpo.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                O Músculo Braquial (O Coadjuvante Secreto)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Fica localizado por baixo do bíceps, perto da dobra do cotovelo. Quando hipertrofiado, ele atua como uma "cunha", empurrando o bíceps para cima. Isso eleva drasticamente tanto o pico quanto a espessura geral do braço.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/r.scott.png" Alt="Anatomia do Bíceps e Braquial" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Rosca Scott:</b> Exercício isolado promovendo melhor pico de contração muscular e além de trabalhar fortemente os braquiais e antebraços.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Seleção de Exercícios e a Posição do Ombro
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                Como o bíceps cruza a articulação do ombro, a posição dos cotovelos dita qual porção realizará a maior parte do esforço:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Cotovelos Atrás do Corpo (Ênfase na Cabeça Longa e Pico)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Ao colocar o cotovelo para trás do tronco, a porção externa é esticada ao máximo antes do movimento iniciar.
                                <br /><strong>Exercício-chave:</strong> Rosca Direta no Banco Inclinado (45°), gerando uma tensão brutal no ponto inicial.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Cotovelos À Frente do Corpo (Ênfase na Cabeça Curta e Isolamento)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Com o cotovelo projetado para a frente, a cabeça longa afrouxa levemente, transferindo o trabalho para a porção interna.
                                <br /><strong>Exercícios-chave:</strong> Rosca Scott (máquina ou banco) e Rosca Concentrada, impedindo o roubo por balanço.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Cotovelos Alinhados e Foco no Braquial
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <b>Massa Geral (Alinhados):</b> Ponto de equilíbrio onde ambas as cabeças produzem força máxima juntas (Ex: Rosca Direta clássica com barra reta/W ou halteres).
                                <br /><b>Músculo Braquial:</b> Exercícios com pegada neutra anulam a supinação e isolam o braquial (Ex: Rosca Martelo).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/r.mart.png" Alt="Variações de Rosca para Bíceps" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover; max-height: 420px" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Rosca Martelo:</b> Exercício que trabalha os músculos do bíceps braquial e o braquiorradial.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Maximização da Contração e Erros Técnicos
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                O erro mais clássico é elevar os cotovelos para a frente e para cima no final do movimento, aproximando a barra do pescoço. Essa projeção faz com que o ombro assuma a sustentação da carga, colocando o bíceps em descanso no topo.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                Regras de Execução Perfeita
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                <b>Congele o Cotovelo:</b> Mantenha-os totalmente fixos e estabilizados ao lado do corpo em 90% da amplitude.
                                <br /><b>Gire o Mindinho:</b> Ao usar halteres, inicie em pegada neutra e realize a supinação durante a subida. No pico do movimento, force o dedo mindinho a apontar para o ombro para extrair uma contração máxima.
                                <br /><b>Punho Rígido:</b> Evite flexionar o punho para dentro no topo. Mantenha a articulação firme ou ligeiramente estendida para isolar estritamente o trabalho no cotovelo.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Mudar a posição dos cotovelos em relação ao corpo altera a ênfase (cotovelos para trás do corpo focam na cabeça longa; cotovelos à frente focam na cabeça curta).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/r.alternada.png" Alt="Técnica Correta de Rosca" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Rosca Alternada:</b> Exercício que trabalha de forma unilateral que combina com a rotação do antebraço.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

            </MudContainer>
            }

            @if (_grupamentoAtivo == "Triceps")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Tríceps Braquial
                </MudText>

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Função Muscular e Importância
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                O tríceps braquial é o verdadeiro dono do braço. Enquanto a maioria das pessoas foca obsessivamente no bíceps, a realidade anatômica é implacável: o tríceps ocupa aproximadamente 60% do volume total do braço.
                                <br /><br />
                                Se o seu objetivo é construir braços massivos, densos e com aquele aspecto estético e marcante de "ferradura" rasgada, o seu foco principal de treino deve estar obrigatoriamente concentrado aqui.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/t.polia.png" Alt="Visão Geral do Tríceps" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Tríceps Pulley:</b> Um dos exercícios mais clássicos da musculação, onde recruta o tríceps braquial, constituído por três porções: lateral, medial e longa.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia das Três Cabeças do Tríceps
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                O termo "tríceps" vem do latim e significa "três cabeças". Todas elas se fundem na porção inferior em um tendão massivo que se insere no cotovelo (olécano), mas possuem origens distintas:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Cabeça Longa
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                É a maior das três porções e fica na parte traseira interna. Sendo a única biarticular (cruza o cotovelo e o ombro), participa tanto da extensão do cotovelo quanto da extensão do ombro. É ela que dita o volume bruto do braço de perfil.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Cabeça Lateral
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Fica localizada na porção externa do braço. É a cabeça responsável pelo desenho estético de fora da "ferradura", garantindo uma forte impressão de largura quando o físico é visto de frente.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Cabeça Medial
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Posicionada na parte inferior central profunda, próxima ao cotovelo. Embora seja menos visível de fora, ela atua como a base principal de força do grupo muscular, mantendo-se ativa em quase todos os ângulos de extensão.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/t.testa.png" Alt="As três porções do Tríceps" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Tríceps Testa:</b> Indicado para fortalecer a hipertrofia do tríceps, já que trabalha a cabeça curta, medial e lateral.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                A Regra Posicional e Seleção de Exercícios
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                Como a cabeça longa cruza o ombro, sua capacidade de contração muda drasticamente conforme a altura do braço. Dividimos o treino em três frentes estratégicas:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Braços Acima da Cabeça (Ênfase na Cabeça Longa / Volume)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Gera um estado de alongamento extremo na porção biarticular antes do início do movimento.
                                <br /><strong>Exercícios-chave:</strong> Tríceps Francês (com halter, polia ou barra) e Tríceps Testa em banco inclinado (mantém o músculo sob tensão constante no topo).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Braços ao Lado do Corpo (Ênfase na Cabeça Lateral / Desenho)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Braços para baixo encurtam a cabeça longa, transferindo a força bruta para desenhar a porção externa.
                                <br /><strong>Exercícios-chave:</strong> Tríceps Pulley (barra reta ou W para progressão estrita) e Tríceps Corda (permite afastar as mãos embaixo, gerando um pico de contração severo na cabeça lateral).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Exercícios Compostos (Massa Geral e Força)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Movimentos multiarticulares que envolvem peito e ombros, permitindo sobrecargas massivas.
                                <br /><strong>Exercícios-chave:</strong> Supino Fechado (mãos na largura dos ombros) e Paralelas focadas em tríceps (mantendo o tronco o mais vertical possível durante a execução).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/t.frances.png" Alt="Exercícios de Extensão de Tríceps" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Tríceps Francês:</b> Exercício que trabalha a cabeça longa do tríceps, sendo ideal para aumentar a massa muscular.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Preservando a Articulação do Cotovelo
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                O tríceps é extremamente potente, porém o tendão do cotovelo é altamente suscetível a inflamações crônicas caso a técnica seja negligenciada por excesso de carga ou erro mecânico.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                Erros Críticos de Execução
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                <b>Abrir os cotovelos para os lados:</b> Movimentos como o Tríceps Testa ou Francês exigem que os cotovelos apontem estritamente para a frente, paralelos entre si. Afastá-los joga uma força de torção articular perigosa no cotovelo e dissipa a contração do músculo.
                                <br /><br />
                                <b>Usar o peso corporal no Pulley:</b> Inclinar demasiadamente o tronco e empurrar o cabo com o peso do peito e ombros anula o isolamento do braço. Mantenha as escápulas retraídas, os ombros para trás e movimente estritamente a articulação do cotovelo.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Para acionar a cabeça longa (a maior delas), o braço precisa ser posicionado acima da cabeça durante o movimento.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/t.coice.png" Alt="Técnica Segura de Tríceps" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Tríceps Coice:</b> Exercício que trabalha de forma intensa a cabeça longa do tríceps.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

            @if (_grupamentoAtivo == "Antebraco")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Antebraços (Flexores e Extensores do Punho)
                </MudText>


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Função Estética e Conectiva
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                O antebraço é um dos agrupamentos musculares mais complexos, subestimados e visuais do corpo humano. Junto com o pescoço e as panturrilhas, ele faz parte dos músculos de "exposição constante" — aqueles que ficam evidentes mesmo quando você está usando uma camiseta casual.
                                <br /><br />
                                Anatomicamente, o antebraço funciona como o "tornozelo" do membro superior. Ele é composto por mais de 20 pequenos músculos divididos em várias camadas, responsáveis por comandar com precisão os movimentos do punho, dos dedos e a força total da sua pegada.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/f.punho.png" Alt="Visão Geral do Antebraço" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Flexão de Punho:</b> Trabalha a musculatura flexora na parte anterior do antebraço.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-6" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center  mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia Funcional e Tipos de Pegada
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                Para simplificar a biomecânica, nós dividimos a massa muscular do antebraço em três grupos de ação principais, que atuam em conjunto com três dimensões de força de pegada (<i>Grip Strength</i>):
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Braquiorradial
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                É o maior e mais estético músculo da região. Começa no úmero e vai até a base do pulso. Sua função principal não é mover o punho, mas sim auxiliar na flexão do cotovelo, especialmente com a palma da mão virada para baixo ou em posição neutra.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Extensores e Flexores do Punho
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>Extensores:</b> Localizados na parte de cima (dorso), responsáveis por levantar a mão ou abrir os dedos.
                                <br /><b>Flexores:</b> Localizados na parte de baixo (palma), formam o grupo mais volumoso e denso, responsável por dobrar o punho para dentro e fechar os dedos com força.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                As Dimensões da Pegada
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <b>Esmagamento (Crush):</b> Força de fechar os dedos contra a palma (Ex: segurar uma barra pesada no Terra).
                                <br /><b>Suporte:</b> Capacidade de segurar uma carga estática por longo período (Ex: Caminhada do Fazendeiro).
                                <br /><b>Pinça (Pinch):</b> Força exercida entre a ponta dos dedos e o polegar (Ex: segurar uma anilha lisa).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/e.punho.png" Alt="Anatomia do Antebraço" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Extensão de Punho:</b> Trabalha a musculatura extensora na parte posterior do antebraço.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-6" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Seleção de Exercícios para Hipertrofia Isolada
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                Embora trabalhem estaticamente em treinos de costas, o estímulo dinâmico e isolado é indispensável para atingir o potencial máximo de densidade:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco no Braquiorradial (Volume de Cima e Lateral)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>Rosca Inversa (Barra W ou Halteres):</b> Executada com pegada pronada (palmas para baixo). Coloca o bíceps em desvantagem mecânica, forçando o braquiorradial a carregar o peso.
                                <br /><b>Rosca Martelo:</b> Pegada neutra que divide o esforço de forma equilibrada e permite o uso de cargas elevadas.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco nos Flexores e Extensores (Trabalho Localizado)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>Rosca Punho (Flexores):</b> Antebraços apoiados e palmas para cima. Deixe a barra rolar até a ponta dos dedos na descida e feche a mão flexionando o punho para cima.
                                <br /><b>Rosca Punho Inversa (Extensores):</b> Palmas voltadas para baixo, realizando o movimento estrito de levantar o dorso da mão em direção ao teto. Use cargas moderadas.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Força de Carregamento Bruta (Densidade Global)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <b>Caminhada do Fazendeiro (Farmer's Walk):</b> Sustente halteres muito pesados e caminhe por 30 a 45 segundos. A contração isométrica extrema recruta praticamente todas as fibras até a falha.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/rolo.p.png" Alt="Exercícios de Antebraço" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Rolo de Punho:</b> Exercício que trabalha a musculatura do antebraço de forma isométrica.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-6" Style="--mud-palette-divider: coral" />


                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Fisiologia e Metodologia de Recuperação
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Assim como as panturrilhas, os músculos do antebraço possuem uma altíssima densidade de fibras de contração lenta (Tipo I) e tecidos tendíneos rígidos, pois são severamente demandados durante o dia inteiro em tarefas cotidianas de preensão.
                                <br /><br />
                                Por conta dessa característica biológica, eles toleram e respondem muito bem a **frequências mais altas de treino** (podendo ser estimulados de 2 a 3 vezes por semana) e se beneficiam drasticamente de faixas de repetições ligeiramente mais altas com controle estrito do movimento (**12 a 20 repetições**). Esse cuidado garante o estímulo metabólico ideal sem submeter a sensível articulação do pulso a microlesões por excesso de carga desalinhada.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Geralmente já trabalham de forma isométrica intensa nos treinos de costas e bíceps, mas podem receber estímulo isolado se forem um ponto fraco.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/r.inversa.png" Alt="Recuperação e Fisiologia" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Rosca Inversa:</b> É um exercício clássico para antebraço onde você trabalha o bíceps.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

            </MudContainer>
            }

            @if (_grupamentoAtivo == "Abdomen")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Abdômen (Reto Abdominal, Oblíquos e Transverso)
                </MudText>

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Função Estabilizadora e Core
                            </MudText>
                            <MudText Typo="Typo.body1">
                                O abdômen é muito mais do que o famoso "tanquinho" ou uma parede estética no centro do corpo. Ele funciona como o principal elo de ligação entre os membros superiores e inferiores, sendo o núcleo (<i>core</i>) de transferência de força, estabilização da coluna e proteção dos órgãos internos.
                                <br /><br />
                                Para desenvolver um abdômen forte e visível, precisamos entender sua anatomia em camadas, suas funções reais e como aplicar a biomecânica correta no treino.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/prancha.png" Alt="Visão Geral do Abdômen" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                    <li class="mb-1"><b>Prancha:</b> É um dos exercícios mais completos para o core, englobando reto abdominal, transverso, oblíquos e até músculos estabilizadores da coluna e ombros.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia e Divisões (As Camadas do Core)
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                A parede abdominal é composta por quatro músculos principais que se sobrepõem em camadas, indo do mais superficial ao mais profundo:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Reto do Abdômen e a Falsa Divisão
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Músculo superficial responsável pelos gomos visíveis, dividido pela <i>Linha Alba</i> (fibra vertical) e interseções horizontais. <b>Mito do Superior/Inferior:</b> É um músculo único. Você apenas altera a ênfase (mover o tronco ativa mais a porção superior; mover o quadril ativa mais a porção inferior).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Oblíquos Externo e Interno
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Ficam nas laterais do tronco. O externo corre diagonalmente para baixo (padrão de mãos no bolso) e o interno fica logo abaixo em direção oposta. Juntos, eles desenham o aspecto em "V" da linha da cintura.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Transverso do Abdômen
                            </MudText>
                            <MudText Typo="Typo.body2">
                                O músculo mais profundo da parede abdominal. Suas fibras correm horizontalmente, envolvendo a região como uma cinta ou espartilho natural. Não gera movimentos visíveis de flexão, mas sua contração puxa a parede abdominal para dentro.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/ab.infra.png" Alt="Camadas do Abdômen" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Abdominal Infra:</b> Um ótimo exercício que trabalha a porção inferior do abdômen.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Biomecânica e Seleção de Exercícios
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                O abdômen precisa de sobrecarga progressiva para hipertrofiar. Fazer centenas de repetições rápidas gera resistência, não gomos densos. Divida seus estímulos pelas ações anatômicas:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Flexão de Tronco (Ênfase Superior) e Inclinação Pélvica (Ênfase Inferior)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>Foco Superior:</b> O objetivo é aproximar as costelas do quadril tirando as escápulas do chão. (Ex: Abdominal na polia alta com carga, Crunch no banco declinado com peso).
                                <br /><b>Foco Inferior:</b> O segredo é fazer a bacia girar para cima, aproximando o quadril do esterno. (Ex: Elevação de pernas suspenso na barra forçando a rotação pélvica, Abdominal reverso inclinado).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Controle Lateral e Linha de Cintura
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <b>Oblíquos (Rotação):</b> Devem ser treinados com moderação para não alargar a silhueta lateral (Ex: Rotação de tronco na polia / Woodchopper).
                                <br /><b>Transverso (Cinta Estética):</b> Ativação isométrica focado em manter a "barriga para dentro" (Ex: Prancha frontal estática e exercício de Stomach Vacuum em jejum).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                        <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/ab.o.png" Alt="Exercícios Abdominais" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Abdominal Oblíquo:</b> Trabalha os oblíquos, que são os músculos responsáveis pela rotação do tronco.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                O Grande Segredo: Revelado na Cozinha
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Não há como falar de abdômen sem alinhar a maior verdade da fisiologia esportiva: o abdômen é construído no treino, mas revelado na cozinha. Os gomos são parte da anatomia de todos, mas ficam escondidos pela gordura subcutânea.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                A Barreira do Percentual de Gordura (BF)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <b>Para Homens:</b> O abdômen geralmente começa a desenhar com menos de 180°12% a 10%14% de gordura corporal (BF).
                                <br /><b>Para Mulheres:</b> Geralmente começa a aparecer com menos de 180°20% a 10%22% de BF devido à distribuição hormonal natural.
                                <br /><br />
                                Não existe queima de gordura localizada. Fazer 500 abdominais queima calorias globais, mas não zera a gordura da barriga. A única forma de revelar o abdômen é o <b>déficit calórico</b> (dieta) aliado à hipertrofia do músculo, fazendo com que os gomos saltem.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/ab.inv.png" Alt="Percentual de Gordura" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Abdominal Invertido:</b> Um exercício simples e eficiente onde trabalha a poção inferior do abdômen.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Erros Comuns na Execução
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                <b>Puxar o pescoço com as mãos:</b> No abdominal clássico, as mãos servem de apoio leve. Puxar a cabeça joga uma tensão perigosa e desnecessária na coluna cervical.
                                <br /><br />
                                <b>Usar os Flexores do Quadril (Iliopsoas):</b> Na elevação de pernas, se você apenas sobe a perna reta sem descolar o quadril do banco, quem realiza 90% do esforço são os músculos da coxa e da virilha, deixando o abdômen estático.
                                <br /><br />
                                <b>Esquecer de soltar o ar:</b> Para contrair o reto abdominal ao máximo, é obrigatório esvaziar os pulmões. Solte todo o ar pela boca no topo do movimento (pico de contração) e inspire ao descer.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> O abdômen é um músculo como qualquer outro; precisa de sobrecarga progressiva para hipertrofiar (ficar com os "gomos" aparentes) e não apenas de repetições infinitas.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                        <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/ab.dec.png" Alt="Erros de Execução" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Abdominal Declinado:</b> Exercício eficaz para treinar o reto abdominal, com o foco na região superior do músculo.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

            @if (_grupamentoAtivo == "Lombar")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Lombar / Eretores da Espinha
                </MudText>

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                A Fundação Posterior do Tronco
                            </MudText>
                            <MudText Typo="Typo.body1">
                                Se o abdômen é a parede da frente do seu tronco, a região lombar é a fundação traseira. Conhecida anatomicamente como a zona das vértebras lombares (L1 a L5), ela suporta a maior parte do peso do seu corpo e sofre pressões mecânicas imensas no dia a dia e nos treinos de força.
                                <br /><br />
                                Desenvolver uma lombar forte e resiliente não é apenas uma questão de estética (embora crie o famoso desenho em "V" ou a "asa" nas costas quando bem desenvolvida), mas sim o principal seguro contra dores crônicas e lesões na coluna.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center order-last order-md-last">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/ponte.png" Alt="Visão Geral da Região Lombar" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Ponte:</b> Exercício que envolve levantar o tronco e as pernas do chão, ativando os músculos da região lombar e glúteos.</li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia Funcional (O Escudo Posterior)
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                A região lombar não é composta por um único músculo grande, mas sim por um complexo de tecidos profundos e superficiais que atuam juntos, tendo como base o Eretor da Espinha:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Os Eretores da Espinha (Sacroespinhais)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Conjunto de três colunas musculares que correm verticalmente desde o quadril até a base do crânio:
                                <b>Iliocostal</b> (porção externa),
                                <b>Longíssimo</b> (porção central longa) e
                                <b>Espinal</b> (porção interna colada nas vértebras). Quando ficam tensionados ou em "pump", criam duas colunas densas e paralelas à espinha.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Músculos Auxiliares Chave
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <b>Quadrado Lombar:</b> Tecido plano profundo que conecta as costelas à pelve, sendo o principal responsável por se inclinar lateralmente.
                                <br /><b>Multífidos:</b> Pequenos feixes profundos que conectam vértebra por vértebra. Possuem pouca força de movimento, mas atuam como os sensores de estabilidade mais importantes da coluna.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/superman.png" Alt="Anatomia dos Eretores da Espinha" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Extensão de Tronco ou Superman:</b> Exercício que envolve levantar o tronco a partir de uma posição deitada, ativando os músculos da região lombar.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Funções Biomecânicas e Cuidados Práticos
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                A lombar trabalha gerando movimento (ação dinâmica) ou travando o corpo (função estática e isométrica):
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Ações de Movimento e Suporte
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>Extensão da Coluna e Quadril:</b> Erguer o tronco a partir de uma posição inclinada à frente, trabalhando em sinergia com glúteos e posteriores.
                                <br /><b>Anti-Flexão (Função Isométrica Principal):</b> Resistir à carga externa que tenta dobrar sua coluna para a frente (Ex: manter o alinhamento no Agachamento Livre ou Levantamento Terra).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                O Erro Fatal: Hiperextensão Excessiva
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Ocorre muito no final da extensão no banco romano ou no terra. Ao subir o tronco, o ponto final deve ser o alinhamento neutro (corpo reto). Passar desse ponto e esmagar as costas para trás curvando a espinha ao contrário gera uma compressão severa nos discos intervertebrais, sendo a receita perfeita para uma hérnia discal.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center ">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/perdi.png" Alt="Biomecânica Correta da Lombar" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Perdigueiro:</b> Exercício que envolve levantar o tronco e as pernas do chão, ativando os músculos da região lombar e glúteos.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Lombar e a Sinergia com o Core Geral
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Sentir a lombar queimar ou entrar em fadiga excessiva muito rápido em treinos de pernas ou dorsais geralmente é um sintoma indicativo de desequilíbrios em outras estruturas sinergistas:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                Fatores de Compensação Mecânica
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                <b>Abdômen Fraco:</b> Se a parede abdominal anterior não gera pressão interna suficiente (pressão intra-abdominal), a região lombar é sobrecarregada para tentar segurar a carga vertebral de maneira isolada.
                                <br /><br />
                                <b>Encurtamento Posterior e de Glúteos:</b> Se os posteriores de coxa são travados, ao descer no agachamento profundo seu quadril é obrigado a girar para dentro prematuramente (retroversão pélvica / <i>butt wink</i>), transferindo a carga mecânica diretamente para as vértebras.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Mantendo o abdômen devidamente fortalecido e a flexibilidade da cadeia posterior em dia, a musculatura lombar atua blindada, estável e livre de dores crônicas.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/lev.t.png" Alt="Sinergia entre Lombar e Core" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Levantamento Terra:</b> Exercício que envolve levantar o tronco e as pernas do chão, ativando os músculos da região lombar e glúteos.</li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

            </MudContainer>
            }

            @if (_grupamentoAtivo == "Quadri")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Quadríceps (Reto Femoral, Vasto Lateral, Vasto Medial e Vasto Intermédio)
                </MudText>

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Função e Potência Muscular
                            </MudText>
                            <MudText Typo="Typo.body1">
                                O quadríceps femoral é o maior e mais potente conjunto muscular do corpo humano. Localizado na parte anterior (frente) da coxa, ele é o grande motor responsável por estender o joelho, carregar o peso do tronco e garantir nossa locomoção, saltos e desacelerações.
                                <br /><br />
                                Se você quer pernas massivas, densas e com cortes profundos, precisa entender a fundo como este bloco de quatro cabeças trabalha e como a biomecânica dita as regras do treino de pernas.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/a.liv.jpg" Alt="Visão Geral do Quadríceps" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Agachamento Livre:</b> Exercício que envolve flexionar e estender os joelhos, ativando os músculos do quadríceps.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia das Quatro Cabeças do Quadríceps
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                O termo "quadríceps" vem do latim e significa "quatro cabeças". Todos esses quatro ventres musculares distintos se unem na parte de baixo da coxa para formar um único e massivo tendão quadricepital, que envolve a patela (rótula) e se insere na tíbia (canela):
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Reto Femoral (Único Biarticular)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Corre bem no centro da coxa. Origina-se no osso ilíaco (quadril), atravessando tanto a articulação do quadril quanto a do joelho. Atua na extensão do joelho e na flexão do quadril (trazer a coxa em direção ao abdômen).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Vasto Lateral e Vasto Medial
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>Vasto Lateral:</b> O maior do grupo, fica na face externa. Cria o aspecto abaulado para fora (<i>outer sweep</i>), dando largura às pernas.
                                <br /><b>Vasto Medial:</b> Fica na face interna, logo acima do joelho, em formato de gota (<i>teardrop</i>). Papel crucial como principal estabilizador da patela para evitar deslocamentos laterais.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Vasto Intermédio (O Volume Oculto)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Fica escondido bem abaixo do reto femoral, colado diretamente no fêmur. Embora não seja visível externamente, seu desenvolvimento empurra os outros três músculos para fora, aumentando drasticamente a espessura total da coxa.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/legp.png" Alt="Anatomia das Quatro Cabeças" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                    <li class="mb-1"><b>Leg-Press:</b> O objetivo do exercício é fortalecer os músculos das pernas, como os quadríceps, os isquiotibiais e os glúteos.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Biomecânica e Seleção de Exercícios
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                A função primária é a extensão do joelho, mas o comportamento do quadril determina o foco. O treino precisa mesclar estímulos multiarticulares e isolados:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                O Paradoxo do Reto Femoral e Exercícios Multiarticulares
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                No Agachamento ou Leg Press, o quadril se dobra junto com o joelho, mantendo o reto femoral no mesmo comprimento. Logo, agachamentos são insuficientes para o reto femoral, focando prioritariamente nos vastos.
                                <br /><b>Agachamento Livre:</b> Rei das pernas. Priorize a profundidade mantendo o tronco o mais vertical possível.
                                <br /><b>Agachamento Hack:</b> Permite projetar os joelhos bem para a frente com segurança, gerando um estiramento absurdo nos vastos.
                                <br /><b>Leg Press 45°:</b> Pés posicionados mais abaixo na plataforma aumentam a flexão do joelho, direcionando o foco estritamente para a coxa.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                O Isolamento na Cadeira Extensora
                            </MudText>
                            <MudText Typo="Typo.body2">
                                O reto femoral só atinge ativação máxima quando o quadril está estático e o joelho trabalha isolado. Como a cadeira extensora fixa o quadril em 90°, a extensão total esmaga o reto femoral de forma única, sendo perfeita para buscar a falha concêntrica com segurança.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/a.bul.png" Alt="Exercícios de Quadríceps" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Agachamento Búlgaro:</b> Dependendo da variação do tronco esse exercício trabalha tanto o quadríceps e os glúteos.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Fatores de Segurança: Protegendo os Joelhos
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Muitas pessoas evitam treinar quadríceps pesado com medo de dores articulares, mas o problema quase nunca é o exercício em si, e sim falhas graves de execução mecânica:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                Erros Críticos de Execução
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                <b>Valgo Dinâmico (Joelhos para dentro):</b> Durante a subida do agachamento ou leg press, os joelhos jamais devem apontar para dentro. Isso gera uma força de cisalhamento perigosa nos meniscos e ligamentos. Force os joelhos para fora, alinhados com a ponta dos pés.
                                <br /><br />
                                <b>Tirar os calcanhares da plataforma:</b> Se o seu calcanhar levanta na base, toda a carga do exercício é transferida da musculatura da coxa diretamente para o tendão patelar, disparando a pressão interna no joelho. Mantenha o pé inteiro plantado e empurre a força a partir do meio do pé/calcanhar.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Exige grande volume de oxigênio e energia por ser um grupo muscular massivo. O agachamento livre é o rei aqui, mas máquinas ajudam no isolamento.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/a.smith.png" Alt="Segurança e Biomecânica do Joelho" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Agachamento Smith:</b> Excelente exercício que trabalha o quadríceps e também trabalhando os glúteos.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

            @if (_grupamentoAtivo == "Posterior")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Posteriores de Coxa / Isquiotibiais (Bíceps Femoral, Semitendinoso e Semimembranoso)
                </MudText>

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Equilíbrio e Proteção Articular
                            </MudText>
                            <MudText Typo="Typo.body1">
                                Os músculos posteriores de coxa, conhecidos cientificamente como o grupo dos isquiotibiais (ou <i>hamstrings</i>), formam o bloco muscular que cobre a parte de trás da coxa.
                                <br /><br />
                                Muitas vezes negligenciados por não serem vistos de frente no espelho, eles são fundamentais para o equilíbrio estético da perna (criando aquele perfil lateral massivo e denso) e atuam como os maiores protetores da articulação do joelho contra lesões graves, como o rompimento do ligamento cruzado anterior (LCA).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/mesa.png" Alt="Visão Geral dos Posteriores" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Mesa Flexora:</b> Foco nos isquiotibiais, promovendo equilíbrio muscular com a parte da frente, previne lesões no joelho.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia dos Isquiotibiais
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                Este grupo é composto por três músculos principais. Com exceção de uma porção isolada, todos compartilham a mesma origem na tuberosidade isquiática (osso do quadril) e cruzam duas articulações (quadril e joelho):
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Bíceps Femoral (Porção Externa)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Localizado na face externa da coxa. É dividido em duas cabeças: a <b>Cabeça Longa</b> (biarticular, atua no quadril e joelho) e a <b>Cabeça Curta</b> (única exceção do grupo, origina-se no fêmur e cruza apenas o joelho, servindo estritamente para dobrar a perna).
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Semitendinoso e Semimembranoso (Porção Interna)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <b>Semitendinoso:</b> Músculo superficial com tendão longo que ajuda a formar a estrutura da "pata de ganso" na lateral do joelho.
                                <br /><b>Semimembranoso:</b> Localizado logo abaixo do semitendinoso, sendo um ventre largo e achatado que confere espessura profunda à porção interna da coxa.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/stiff.png" Alt="Anatomia dos Isquiotibiais" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Stiff:</b> Exercício que trabalha os isquiotibiais, promovendo força e resistência na região posterior da coxa.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Funções Biomecânicas e Estratégia de Treino
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                Por cruzar duas articulações, o grupo possui duas funções mecânicas principais. O treino perfeito exige obrigatoriamente um estímulo para cada uma delas:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Vetor de Flexão de Joelho (Isolamento e Contração)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Ação de dobrar a perna aproximando o calcanhar do glúteo. Único vetor capaz de recrutar a cabeça curta do bíceps femoral.
                                <br /><b>Mesa Flexora:</b> Quadril estendido, foca fortemente no pico de contração no topo.
                                <br /><b>Cadeira Flexora:</b> Exercício padrão-ouro. Com o quadril fixado em 90°, os posteriores são alongados ao máximo na origem (quadril) e sofrem tensão severa durante a flexão.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Vetor de Extensão de Quadril (Força e Alongamento Máximo)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Ação de empurrar o quadril para a frente levantando o tronco (a cabeça curta não participa).
                                <br /><b>Stiff (RDL):</b> O rei do vetor posterior. Consiste em empurrar o quadril para trás mantendo a coluna alinhada e os joelhos em ângulo fixo, gerando estiramento máximo.
                                <br /><b>Bom Dia (Good Morning):</b> Barra apoiada nos trapézios, exige controle abdominal absurdo e foca na fase excêntrica da extensão.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                            <MudImage Src="img-dt/goodmorning.png" Alt="Exercícios de Isquiotibiais" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Good Morning:</b> Exercício que trabalha os isquiotibiais, promovendo força e resistência na região posterior da coxa.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                O Erro Comum: Confundir Stiff com Agachamento
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                O erro mais clássico na execução do Stiff é dobrar excessivamente os joelhos à medida que a barra desce em direção ao chão.
                                <br /><br />
                                Ao agachar durante a descida do peso, você encurta o posterior na articulação de baixo (joelho), dissipando toda a tensão mecânica que deveria estar agindo no alongamento da musculatura alvo.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                A Execução Correta
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Os joelhos devem iniciar apenas levemente destravados (cerca de 15° a 20°) com o único propósito de proteger a patela, e devem ser congelados nessa angulação. Quem executa o movimento é puramente o quadril, projetando-se para trás (como se quisesse fechar uma porta com o glúteo) e tracionando para a frente no retorno.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/cad.f.png" Alt="Técnica Correta do Stiff" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Cadeira Flexora:</b> Exercício que trabalha os isquiotibiais.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Proporção de Força: Quadríceps vs. Posterior
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Em um sistema músculo-esquelético saudável, a capacidade de força dos posteriores deve equivaler a aproximadamente 60% a 70% da força gerada pelos quadríceps.
                                <br /><br />
                                Na maioria dos praticantes, essa balança é severamente desregulada por hipertrofia excessiva da coxa anterior e negligência da cadeia posterior. Essa assimetria altera o trilho anatômico da patela, gerando instabilidade mecânica severa no joelho.
                                Fortalecer os posteriores com a mesma intensidade e entrega que você destina à parte frontal é o verdadeiro segredo para impulsionar sua carga no agachamento e blindar permanentemente os ligamentos contra lesões.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Um erro comum na musculação é treinar menos o posterior do que o quadríceps, o que gera desequilíbrios e lesões no joelho (como o ligamento cruzado anterior). Seu treino deve conter exercícios de flexão de joelho e de extensão de quadril.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/lev.ter.png" Alt="Equilíbrio Muscular da Perna" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                    <li class="mb-1"><b>Levantamento Terra:</b>  Ativa intensamente os glúteos, a parte de trás das coxas (isquiotibiais) e a região lombar. </li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

            @if (_grupamentoAtivo == "Pantu")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Panturrilhas (Gastrocnêmio e Sóleo)
                </MudText>

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                O Segundo Coração do Corpo
                            </MudText>
                            <MudText Typo="Typo.body1">
                                As panturrilhas, frequentemente chamadas de "o segundo coração do corpo" devido à sua importância vital no retorno venoso (bombear o sangue de volta para as cavidades superiores), são um dos agrupamentos musculares mais desafiadores e debatidos na musculação.
                                <br /><br />
                                Muitos culpam exclusivamente a herança genética pelo formato e volume das pernas, mas a verdade biomecânica é que a maioria dos praticantes comete erros cruciais na seleção dos exercícios, no controle da amplitude e no entendimento do tipo de fibra que compõe esse complexo.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="220px" Class="rounded-lg">
                        <MudImage Src="img-dt/p.empe.png" Alt="Visão Geral das Panturrilhas" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 220px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:220px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Panturrilha em Pé:</b> Exercício eficaz para o fortalecimento das panturrilhas, com foco no gastrocnêmio e sóleo.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-10" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia do Tríceps Sural
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                O complexo muscular da panturrilha é composto por três cabeças distintas que se unem na porção inferior para formar o <b>Tendão de Aquiles</b> (tendão calcâneo), fixando-se no calcanhar:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                O Gastrocnêmio (Medial e Lateral)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                É a porção superficial que desenha o formato de "coração invertido". Sendo um músculo biarticular (cruza o joelho e o tornozelo), realiza a flexão plantar e auxilia na flexão do joelho. É composto majoritariamente por <b>fibras de contração rápida (Tipo II)</b>, respondendo muito bem a cargas elevadas e estímulos explosivos.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                O Sóleo (A Base de Espessura)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Músculo largo e plano posicionado logo abaixo do gastrocnêmio. Ele é monoarticular (origina-se abaixo do joelho), atuando estritamente na flexão plantar. Quando hipertrofiado, empurra o tecido superficial, expandindo a largura lateral da perna. É composto por até <b>80% de fibras de contração lenta (Tipo I)</b>, altamente resistentes à fadiga.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/p.sentado.png" Alt="Anatomia do Tríceps Sural" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Panturrilha Sentado na Máquina:</b> Exercício ideal para o fortalecimento das panturrilhas, com foco no sóleo e na construção da espessura.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                A Regra Posicional e Seleção de Exercícios
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                A angulação dos joelhos altera drasticamente a participação das cabeças musculares devido às suas conexões articulares:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Joelhos Estendidos (Foco no Gastrocnêmio e Força Bruta)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Para recrutar a porção estética e explosiva, a perna deve estar totalmente reta.
                                <br /><b>Panturrilha em Pé (Máquina/Smith):</b> Exercício base que suporta sobrecargas elevadas.
                                <br /><b>Panturrilha no Leg Press:</b> Elimina a compressão na coluna, isolando perfeitamente a articulação do tornozelo.
                                <br /><b>Burrinho (Donkey Calf Raise):</b> Tronco inclinado a 90° coloca o gastrocnêmio sob alongamento inicial extremo, gerando altíssima taxa de ativação.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Joelhos Flexionados (Foco no Sóleo e Espessura)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Ao sentar e dobrar o joelho, o gastrocnêmio encurta e entra em insuficiência ativa, perdendo a capacidade de produzir força.
                                <br /><b>Panturrilha Sentado (Cavalinho):</b> Trabalha de forma quase exclusiva o Sóleo. Ideal para séries de maior tempo sob tensão e execuções cadenciadas devido às suas características metabólicas de fibras lentas.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/p.leg.png" Alt="Exercícios para Panturrilhas" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                    <li class="mb-1"><b>Panturrilha no Leg Press:</b> Exercício que elimina a compressão na coluna, isolando perfeitamente a articulação do tornozelo.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                O Erro do "Efeito Mola" e a Execução Perfeita
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                O Tendão de Aquiles é o elo elástico mais potente do corpo humano, desenhado para absorver o impacto da descida e devolvê-lo na subida como uma mola biológica. Treinar panturrilhas realizando quiques rápidos e movimentos curtos ativa apenas essa elasticidade tendínea, deixando o músculo praticamente estático.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                Metodologia de Contra-Mola
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                <b>1. Alongamento Máximo:</b> Desça o calcanhar de forma controlada até o limite da flexão, estirando a fibra por completo.
                                <br /><b>2. Pausa de Desmistificação:</b> Segure a posição inferior por 2 segundos completos. Esse intervalo dissipa o acúmulo de energia elástica do tendão, obrigando o músculo a realizar o trabalho bruto inicial.
                                <br /><b>3. Contração Explosiva e Pico:</b> Suba acelerando a carga até a ponta máxima dos dedos e esmague a musculatura no topo por 1 segundo antes de iniciar a descida controlada.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> O sóleo é mais ativado com os joelhos flexionados (sentado). O gastrocnêmio exige os joelhos totalmente estendidos (em pé). Para desenvolver panturrilhas completas, você precisa treinar das duas formas.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/p.empemaq.png" Alt="Técnica de Execução Estrita" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Panturrilha em Pé na Máquina:</b> Exercício eficaz para o fortalecimento das panturrilhas, com foco no gastrocnêmio e sóleo.</li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

            @if (_grupamentoAtivo == "Gluteo")
            {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 mt-6">

                <MudText Typo="Typo.h4" Style="color:coral; font-weight:bold;" Class="mb-6">
                    Glúteos (Máximo, Médio e Mínimo)
                </MudText>

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                O Centro de Força do Corpo
                            </MudText>
                            <MudText Typo="Typo.body1">
                                Os glúteos formam o complexo muscular mais poderoso e volumoso do corpo humano. Localizados na região posterior da pelve, eles são o verdadeiro "centro de força" de qualquer atleta ou praticante de musculação.
                                <br /><br />
                                Além do óbvio apelo estético de preenchimento, formato e firmeza, os glúteos desempenham um papel biomecânico crucial: eles estabilizam a bacia, protegem a região lombar contra sobrecargas e são os principais geradores de potência para correr, saltar, agachar e estender o quadril.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/elev.p.png" Alt="Visão Geral dos Glúteos" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Elevação Pélvica:</b> É um exercício focado no fortalecimento dos glúteos (máximo, médio, mínimo) e da parte posterior das coxas.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Anatomia do Complexo Glúteo
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">
                                O complexo glúteo é composto por três músculos distintos, cada um com orientações de fibras e funções mecânicas diferentes, exigindo estímulos variados para um desenvolvimento proporcional:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Glúteo Máximo (Volume e Projeção)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                É o maior, mais superficial e mais pesado músculo do complexo, responsável pelo volume bruto e aspecto empinado. Possui uma mistura equilibrada de fibras rápidas e lentas, respondendo incrivelmente bem a cargas pesadas e grande amplitude de movimento.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Glúteo Médio (Preenchimento Lateral)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Situado na lateral externa da pelve, logo acima do máximo. É o músculo que preenche a lateral do quadril, corrigindo assimetrias e a depressão trocantérica, criando uma transição suave da cintura para as coxas. Atua como o principal estabilizador dinâmico da bacia.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Glúteo Mínimo (Estabilização Profunda)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                O menor e mais profundo do trio, localizado logo abaixo do glúteo médio. Ele trabalha em perfeita sinergia com o médio, auxiliando na estabilização do quadril e impedindo que a bacia desabe ou incline lateralmente de maneira errada.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/ex.quadril.png" Alt="Anatomia dos Músculos Glúteos" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Extensão de Quadril:</b> Exercício que envolve a extensão do quadril, ativando principalmente os glúteos.</li>
                            </ul>
                        </MudText>
                    </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                Funções Biomecânicas e Seleção de Exercícios
                            </MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                As funções dos glúteos englobam a <i>Extensão do Quadril</i>, <i>Abdução</i>, <i>Rotação Externa</i> e <i>Retroversão Pélvica</i>. Para o desenvolvimento máximo, o treino deve combinar os planos de força:
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Vetor Vertical (Tensão em Alongamento Máximo)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Gera quebra de fibras no ponto onde o glúteo está totalmente esticado, embaixo.
                                <br /><b>Agachamento Profundo:</b> Deve quebrar a paralela (passar dos 90°). Quanto mais baixo você desce com segurança, maior a ativação do glúteo máximo.
                                <br /><b>Leg Press 45° (Pés Altos):</b> Pés no topo reduzem a flexão do joelho e aumentam o ângulo do quadril, transferindo o foco para o glúteo.
                                <br /><b>Búlgaro / Avanço:</b> Exercícios unilaterais brutais que exigem altíssima estabilização e estiramento.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Vetor Horizontal (Tensão em Pico de Contração)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Exercícios ideais para suprir a perda de tensão mecânica que ocorre no topo dos agachamentos convencionais.
                                <br /><b>Elevação Pélvica (Hip Thrust):</b> Exercício com maior ativação isolada do glúteo máximo. A tensão máxima acontece no topo do movimento, onde é possível esmagar o músculo contra a gravidade.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;" Class="mt-2">
                                Foco no Glúteo Médio (Abduções)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Responsável pelo desenho lateral arredondado superior.
                                <br /><b>Cadeira Abdutora:</b> Inclinar o tronco levemente à frente altera o braço de momento e potencializa o recrutamento lateral.
                                <br /><b>Abdução na Polia Baixa:</b> Mantém a tensão constante durante toda a fase de abertura do movimento.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/cad.ab.png" Alt="Exercícios de Glúteos" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Cadeira Abdutora:</b> Exercício que ativa os glúteos médios e mínimos, promovendo o fortalecimento da região lateral do quadril.</li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-10" Style="--mud-palette-divider: coral" />

                <MudGrid Justify="Justify.Center" Class="align-center mb-6" Spacing="2">
                    <MudItem xs="12" md="7" Class="d-flex flex-column">
                        <MudPaper Elevation="15" Class="d-flex flex-column pa-4" Height="100%" Style="border: 1px solid coral">
                            <MudText Typo="Typo.h5" Style="color:coral; font-weight:bold;" Class="mb-3">
                                O Fenômeno da Amnésia Glútea
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Um problema muito comum em pessoas que passam horas sentadas trabalhando ou estudando é a chamada amnésia glútea. Passar o dia pressionando o músculo contra o assento inibe os estímulos neuromusculares da região.
                                <br /><br />
                                Ao iniciar um agachamento, o sistema nervoso "esquece" de recrutar os glúteos de forma eficiente, transferindo a sobrecarga mecânica para os quadríceps e para a lombar de forma compensatória.
                            </MudText>

                            <MudText Typo="Typo.button" Style="color:coral; font-weight:bold;">
                                Como Despertar o Músculo Adormecido
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Realize um trabalho de ativação metabólica prévia antes de ir para as séries com cargas pesadas. Duas séries leves de elevação pélvica sem carga ou abduções unilaterais com elástico (<i>miniband</i>), focando estritamente na conexão mente-músculo, restabelecem os caminhos neurais. Ao migrar para o agachamento livre, o glúteo responderá imediatamente ao esforço exigido.
                            </MudText>

                            <MudDivider Class="my-2" Style="--mud-palette-divider: var(--mud-palette-divider-light);" />
                            <MudText Typo="Typo.body2" Style="font-style: italic;">
                                <strong>Visão de Treino:</strong> Para ativação máxima do glúteo máximo, são necessários exercícios com vetores de força horizontais e verticais.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5" Class="d-flex flex-column align-center justify-center">
                    <MudPaper MaxWidth="420px" Class="rounded-lg">
                        <MudImage Src="img-dt/afundo.png" Alt="Ativação Neuromuscular" Elevation="15" Class="rounded-lg mt-0 mt-md-0" Style="width: 100%; max-width: 420px; object-fit: cover;" />
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Style="color:coral; max-width:420px">
                            <ul style="color:var(--mud-palette-text-primary); padding-left: 20px;">
                                <li class="mb-1"><b>Afundo:</b> Exercício que envolve a flexão dos joelhos e a extensão do quadril, ativando principalmente os glúteos.</li>
                            </ul>
                        </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
            }

        
    }

    <MudGrid Spacing="5" Class="px-4">
        @foreach (var treino in ListaTreinos)
        {
            @* Geração dinâmica do ID para a âncora (Ex: "upper-lower", "full-body") *@
            var idAncora = treino.Nome.ToLower().Replace(" ", "-").Replace("/", "-");

            <MudItem xs="12" id="@idAncora" Class="mb-20 mt-20">
                <MudGrid Class="@(treino.Inverter ? "flex-row-reverse align-center" : "align-center")">

                    <MudItem xs="12" md="5">
                        <MudPaper Elevation="4"
                                  Class="training-card p-8 d-flex flex-column align-center justify-center"
                                  Style="@($"background: {treino.CardGradient};")">
                            <div class="icon-bubble">
                                <MudIcon Icon="@treino.Icone" Style="font-size: 3rem; color: #fff;" />
                            </div>
                            <MudText Style="font-size:0.7rem;font-weight:700;letter-spacing:0.3em;text-transform:uppercase;color:rgba(255,255,255,0.6);" Class="mt-5">
                                Treino
                            </MudText>
                            <MudText Typo="Typo.h4" Class="mt-1 white-text font-bold text-center">@treino.Nome</MudText>
                            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.75);" Class="mt-2 text-center">@treino.Tagline</MudText>
                            <MudChip T="string" Color="Color.Surface" Variant="Variant.Text" Class="coral-text mt-2">
                                @treino.Frequencia
                            </MudChip>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="7" Class="d-flex flex-column justify-center">
                        <div class="px-4">
                            <MudText Typo="Typo.h4" Style="font-family:cambria; font-weight:bold; color:coral" Class=" mb-2">@treino.Nome</MudText>

                            <MudCard Elevation="12" Class="mb-2" Style="border:1px solid coral">
                                <MudText Typo="Typo.body1" Align="Align.Center" Class="white-text mb-2 ms-1 mt-2">@treino.Descricao</MudText>

                                <MudText Style="font-size:0.75rem;font-weight:bold;text-transform:uppercase;letter-spacing:0.12em;color:coral" Class="mb-3 ms-2">
                                    Benefícios
                                </MudText>
                                <MudGrid Spacing="2" Class="mb-2">
                                    @foreach (var b in treino.Beneficios)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <div class="d-flex align-start gap-2 ms-2">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                         Style="color:coral;font-size:1.1rem;margin-top:2px;flex-shrink:0;" />
                                                <MudText Typo="Typo.body2" Class="white-text">@b</MudText>
                                            </div>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudCard>

                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <div class="info-chip coral-border rounded mb-2 mud-theme-dark">
                                        <div class="d-flex align-center gap-2 mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth"
                                                     Style="color:coral;font-size:1rem;" />
                                            <MudText Class="white-text" Style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;">
                                                Frequência
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="white-text ms-1" Style="font-weight:600;">@treino.Frequencia</MudText>
                                    </div>
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <div class="info-chip coral-border rounded mb-2 mud-theme-dark">
                                        <div class="d-flex align-center gap-2 mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Group"
                                                     Style="color:coral;font-size:1rem" />
                                            <MudText Class="white-text" Style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;">
                                                Indicado para
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="white-text " Style="font-weight:600;">@treino.Publico</MudText>
                                    </div>
                                </MudItem>
                            </MudGrid>
                            <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Text"
                                       Style="background-color:coral"
                                       Class="scale-hover"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="@(async () => await AbrirDetalhes(treino))">
                                Saiba Mais
                            </MudButton>
                            <MudButton Style="background-color:coral" Class="scale-hover" OnClick="@(() => AbrirExemplo(treino))">
                                Exemplo de Treino
                            </MudButton>
                           </div>
                        
                        </div>
                    </MudItem>
                </MudGrid>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

