@code {
    private string _grupamentoAtivo = "";

    private void AlternarGrupamento(string grupamento)
    {
        _grupamentoAtivo = _grupamentoAtivo == grupamento ? "" : grupamento;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

            if (!string.IsNullOrEmpty(uri.Fragment))
            {
                var elementId = uri.Fragment.Substring(1);

                await Task.Delay(350);

                await JS.InvokeVoidAsync("eval", $"document.getElementById('{elementId}')?.scrollIntoView({{ behavior: 'smooth' }})");
            }
        }
    }

    private async Task AbrirDetalhes(TreinoModel treino)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<MensagemCustomizada>
        {
            { x => x.Titulo,   treino.Nome      },
            { x => x.Conteudo, treino.Explicacao }
        };

        await DialogService.ShowAsync<MensagemCustomizada>("Detalhes do Treino", parameters, options);
    }
    private async Task AbrirExemplo(TreinoModel treino)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        // Monta a tabela em HTML puro estruturado com classes globais do MudBlazor
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class='mud-table mud-simple-table mud-table-bordered mud-table-striped mud-elevation-1 mt-2'>");
        sb.Append("  <div class='mud-table-container'>");
        sb.Append("    <table class='mud-table-root'>");
        sb.Append("      <thead class='mud-table-head' style='background-color: rgba(255,107,53,0.1);'>");
        sb.Append("        <tr class='mud-table-row'>");
        sb.Append("          <th class='mud-table-cell' style='color:coral; font-weight:bold;'>Dia</th>");
        sb.Append("          <th class='mud-table-cell' style='color:coral; font-weight:bold;'>Divisão</th>");
        sb.Append("          <th class='mud-table-cell' style='color:coral; font-weight:bold;'>Foco Principal</th>");
        sb.Append("        </tr>");
        sb.Append("      </thead>");
        sb.Append("      <tbody class='mud-table-body'>");

        foreach (var item in treino.CronogramaSemanal)
        {
            sb.Append("    <tr class='mud-table-row'>");
            sb.Append($"     <td class='mud-table-cell'><b>{item.Dia}</b></td>");
            sb.Append($"     <td class='mud-table-cell'>{item.Rotina}</td>");
            sb.Append($"     <td class='mud-table-cell'>{item.Foco}</td>");
            sb.Append("    </tr>");
        }

        sb.Append("      </tbody>");
        sb.Append("    </table>");
        sb.Append("  </div>");
        sb.Append("</div>");

        var parameters = new DialogParameters<MensagemCustomizada>
    {
        { x => x.Titulo, $"Rotina Semanal: {treino.Nome}" },
        { x => x.Conteudo, sb.ToString() } // Passa a tabela gerada
    };

        await DialogService.ShowAsync<MensagemCustomizada>("Exemplo de Treino", parameters, options);
    }

