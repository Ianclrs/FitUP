@page "/"
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject FitUP.Services.AuthService AuthService
<PageTitle>Home</PageTitle>

@if (_showCard)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 99999;
        background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center;">
        <div style="max-width: 350px; width: 90%; background: #1f1d1b; border: 2px solid coral;
            border-radius: 12px; padding: 24px; color: white; position: relative;
            box-shadow: 0 0 40px rgba(255, 107, 53, 0.4);">
            <button @onclick="FecharWelcome"
                style="position: absolute; top: 8px; right: 8px; background: none; border: none;
                color: coral; font-size: 24px; cursor: pointer; line-height: 1;">&times;</button>

            <h3 style="text-align: center; margin-top: 8px; line-height: 1.4;">
                Bem-vindo ao <span style="color: coral;">FitUP</span>!
            </h3>

            <p style="text-align: center; margin: 16px 0; line-height: 1.5;">
                Sua plataforma definitiva para o mundo fitness. Trazemos praticidade com treinos personalizados, guias de execução e nutrição completa.
            </p>

            <hr style="border-color: coral; margin-bottom: 12px;" />

            <div style="max-height: 250px; overflow-y: auto; padding-right: 8px;">
                <h4 style="color: coral; margin-bottom: 4px;">Monte o Seu Treino</h4>
                <p style="font-size: 0.9rem; margin-bottom: 12px; line-height: 1.5;">
                    Gere rotinas de treino personalizadas com base no seu perfil e objetivos. Suas fichas podem ser salvas diretamente na sua área de usuário para acesso rápido na hora de ir para a academia.
                </p>

                <hr style="margin-bottom: 12px; border-color: #444;" />

                <h4 style="color: coral; margin-bottom: 4px;">Dicas de Treino</h4>
                <p style="font-size: 0.9rem; margin-bottom: 12px; line-height: 1.5;">
                    Entenda como funcionam os grupamentos musculares. Acesse guias com os exercícios mais eficientes para cada área e descubra os principais métodos e estilos de treinamento para otimizar seus resultados.
                </p>

                <hr style="margin-bottom: 12px; border-color: #444;" />

                <h4 style="color: coral; margin-bottom: 4px;">Ganho Máximo</h4>
                <p style="font-size: 0.9rem; line-height: 1.5;">
                    Domine a sua nutrição. Aprenda a importância de cada macronutriente, utilize nossa calculadora de taxa metabólica basal (TMB) e gere planos alimentares sob medida para o seu biotipo.
                </p>
            </div>
        </div>
    </div>
}

<MudContainer Class="mt-8 animate-fade-in">
    <MudGrid Justify="Justify.Center" Spacing="16">
        <MudItem>
            <MudCard Elevation="5" Class="rounded-xl" Style="width:250px; height: 70px; overflow: hidden">
                <MudCardContent Class="pa-0 d-flex flex-row" Style="height: 100%">
                    <div class="d-flex align-center justify-center rounded-xl"
                         Style="color:coral; width:37%; height: 100%">
                        <MudIcon Icon="@Icons.Material.Sharp.Group" Style="font-size: 4rem" />
                    </div>
                    <div class="d-flex align-center ps-5"
                         Style="width:60%; height: 100%">
                        <MudText Typo="Typo.body1" Style="font-weight:600;">
                            Uma Equipe Qualificada!
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem>
            <MudCard Elevation="5" Class="rounded-xl" Style="width:250px;height: 70px; overflow:hidden">
                <MudCardContent Class="pa-0 d-flex flex-row" Style="height:100%">
                    <div class="d-flex align-center justify-center rounded-xl" style="color:coral; width:37%; height:100%">
                        <MudIcon Icon="@Icons.Material.Sharp.CalendarMonth" Style="font-size:4rem"/>
                    </div>
                    <div class="d-flex align-center" style="width:60%; height:100%">
                        <MudText Class="mt-1" Align="Align.Start" Typo="Typo.body1" Style="font-weight:600">
                            Treinos Que Cabem Na Rotina!
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem>
            <MudCard Elevation="5" Class="rounded-xl" Style="width:250px;height: 70px; overflow:hidden">
                <MudCardContent Class="pa-0 d-flex flex-row" Style="height:100%">
                    <div class="d-flex align-center justify-center rounded-xl" style="color:coral; width:37%; height:100%">
                        <MudIcon Icon="@Icons.Material.Rounded.RestaurantMenu" Style="font-size:4rem"/>
                    </div>
                    <div class="d-flex align-center ps-2" style="width:60%; height:100%">
                        <MudText Typo="Typo.body1" Style="font-weight:600">
                            Guias de Alimentação!
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 py-10 d-flex flex-column animate-fade-in">
    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" Class="mb-2">
            <div class="d-flex align-center justify-center">
                <MudText Style="color:coral; font-weight:bold" Inline="true" Typo="Typo.h5" Class="mt-4">Treinos</MudText>
                <MudText Style="color:white; font-weight:bold" Inline="true" Typo="Typo.h5" Class="mt-4">Exclusivos.</MudText>
            </div>
        </MudItem>
    </MudGrid>
    <div class="d-flex flex-wrap gap-5 justify-center mt-0">
        <MudCard Elevation="0" Style="width: 280px" Class="rounded-xl transition-fast-out-slow-in scale-hover custom-shadow-hover">
            <MudCardMedia Image="img/H.Lower.png" Height="150" />
            <MudCardContent>
                <MudButton OnClick='() => IrParaTreino("upper-lower")' Class="transition-fast-out-slow-in scale-hover" Style="background-color:coral; width: 100%;font-weight: 800">UPPER/LOWER</MudButton>
                <MudText Class="mt-1" Align="Align.Center" Typo="Typo.body2">Um treino dividido em membros superiores e inferiores consiste em separar os treinos das partes superior e inferior do corpo.</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="11" Style="width: 280px;" Class="rounded-xl transition-fast-out-slow-in scale-hover custom-shadow-hover">
            <MudCardMedia Image="img/H.Full.png" Height="150" />
            <MudCardContent>
                <MudButton OnClick='() => IrParaTreino("full-body")' Class="transition-fast-out-slow-in scale-hover" Style="background-color:coral; width: 100%;font-weight: 800">FULLBODY</MudButton>
                <MudText Class="mt-1" Align="Align.Center" Typo="Typo.body2">Treino focado para trabalhar os principais grupamentos musculares, em uma unica sessão.</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="11" Style="width: 280px;" Class="rounded-xl transition-fast-out-slow-in scale-hover custom-shadow-hover">
            <MudCardMedia Image="img/H.PPL.png" Height="150" />
            <MudCardContent>
                <MudButton OnClick='() => IrParaTreino("push-pull-legs")' Class="transition-fast-out-slow-in scale-hover" Style="background-color:coral; width: 100%;font-weight: 800">PUSH/PULL/LEGS</MudButton>
                <MudText Class="mt-1" Align="Align.Center" Typo="Typo.body2">Treino voltado em organizar os exercícios em três sessões distintas, e com grupamentos musculares distintos a cada dia.</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="11" Style="width: 280px;" Class="rounded-xl transition-fast-out-slow-in scale-hover custom-shadow-hover">
            <MudCardMedia Image="img/H.ABCD.png" Height="150" />
            <MudCardContent>
                <MudButton OnClick='() => IrParaTreino("treino-a-b-c-d")' Class="transition-fast-out-slow-in scale-hover" Style="background-color:coral; width: 100%;font-weight: 800">A/B/C/D</MudButton>
                <MudText Class="mt-1" Align="Align.Center" Typo="Typo.body2">Focado em 1 ou 2 grupos musculares por dia, indicado para avançados, pois permite mais volume e intensidade por músculo trabalhado.</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="11" Style="width: 280px;" Class="rounded-xl transition-fast-out-slow-in scale-hover custom-shadow-hover">
            <MudCardMedia Image="img/H.Alimentacao.png" Height="150" />
            <MudCardContent>
                <MudButton Href="GanhoMaximo" Class="transition-fast-out-slow-in scale-hover" Style="background-color:coral; width: 100%;font-weight: 800">ALIMENTAÇÂO</MudButton>
                <MudText Class="mt-1" Align="Align.Center" Typo="Typo.body2">Não adianta focar em treinar,<br /> se você não se atentar na alimentação correta.</MudText>
            </MudCardContent>
        </MudCard>
    </div>
    <MudGrid Class="mt-18" Justify="Justify.Center">
        <MudButton Href="MonteTreino" Class="ms-6 mt-2 rounded-xl transition-fast-out-slow-in scale-hover custom-shadow-hover" Style="background-color:coral; font-weight:700; width:clamp(300px,50%,500px)">VENHA CONHECER NOSSOS TREINOS!</MudButton>
    </MudGrid>
</MudContainer>

@code{
    private bool _showCard = true;
    private bool _checked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checked) return;
        _checked = true;

        // Verifica localStorage: tem sessão de usuário?
        try
        {
            var userJson = await JS.InvokeAsync<string>("localStorage.getItem", "fitup_user");
            if (!string.IsNullOrEmpty(userJson) && userJson.Length > 10)
            {
                _showCard = false;
                StateHasChanged();
                return;
            }
        }
        catch { }

        // Verifica localStorage: card já foi fechado antes?
        try
        {
            var dismissed = await JS.InvokeAsync<string>("localStorage.getItem", "fitup_welcome_home");
            if (dismissed == "1")
            {
                _showCard = false;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task FecharWelcome()
    {
        _showCard = false;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "fitup_welcome_home", "1");
        }
        catch { }
    }

    private void IrParaTreino(string treinoId)
    {
        NavigationManager.NavigateTo($"/DicasTreino#{treinoId}");
    }
}