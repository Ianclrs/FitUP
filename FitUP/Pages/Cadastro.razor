@page "/cadastrar"
@layout MainLayout
@using System.ComponentModel.DataAnnotations
@using MudBlazor
@using FitUP.Services
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject ISnackbar Snackbar

<PageTitle>Cadastrar</PageTitle>

<style>
    :root { 
        --mud-palette-primary: coral; 
        --mud-palette-primary-hover: #ff8e61; 
    }
    
    .reg-wrap { 
        display: flex; 
        justify-content: center; 
    }
    
    .reg-card { 
        border-radius: 28px; 
        width: 100%; 
        max-width: 750px; 
        position: relative;
    }

    .btn-back, .btn-close {
        position: absolute;
        top: 12px;
        color: #f44336 !important; 
        transition: transform 0.2s ease-in-out, opacity 0.2s;
        opacity: 0.7;
    }

    .btn-back { left: 12px; }
    .btn-close { right: 12px; }
    
    .btn-back:hover, .btn-close:hover {
        color: #d32f2f !important;
        opacity: 1;
        transform: scale(1.1);
    }

    .btn-pri { 
        background-color: coral !important; 
        color: #fff !important; 
        font-weight: 700; 
    }

    .orange-link { 
        color: coral !important; 
        font-weight: 700; 
        text-decoration: none; 
    }
    
    .orange-link:hover {
        color: #ff8e61 !important;
        text-decoration: underline;
    }
</style>

<div class="reg-wrap">
    <MudPaper Elevation="4" Class="reg-card pa-10 mt-5 mb-5 ">
        
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIosNew" 
                       Class="btn-back" 
                       OnClick="IrParaLogin" 
                       Size="Size.Medium"/>

        <MudIconButton Icon="@Icons.Material.Filled.Close" 
                       Class="btn-close" 
                       OnClick="VoltarHome" 
                       Size="Size.Medium" />

        <div class="mb-6">
            <MudText Align="Align.Center" Typo="Typo.h5" Style="font-weight:bold">Crie sua conta</MudText>
            <MudText Align="Align.Center" Typo="Typo.body2" Class="mud-text-secondary">Venha fazer parte do nosso Time!</MudText>
        </div>

        <EditForm Model="@cadModel" OnValidSubmit="HandleCadastro">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Nome" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="cadModel.FirstName" For="@(()=>cadModel.FirstName)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Sobrenome" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="cadModel.LastName" For="@(()=>cadModel.LastName)" />
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudDatePicker AdornmentColor="Color.Inherit" Label="Nascimento" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Date="cadModel.BirthDate" DateFormat="dd/MM/yyyy" Editable="true" Mask="@(new PatternMask("00/00/0000"))" Placeholder="Ex: 25/11/2004" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Telefone (Opcional)" 
                                  Variant="Variant.Filled" 
                                  Margin="Margin.Dense" 
                                  @bind-Value="cadModel.Phone" 
                                  For="@(()=>cadModel.Phone)"
                                  Mask="@(new PatternMask("(00) 00000-0000"))"
                                  Immediate="true"
                                  Clearable="true"
                                  Placeholder="Ex: (11) 91234-5678" />
                </MudItem>
                
                <MudItem xs="12">
                    <MudTextField Label="CPF" 
                                  Variant="Variant.Filled" 
                                  Margin="Margin.Dense" 
                                  @bind-Value="cadModel.CPF" 
                                  For="@(()=>cadModel.CPF)" 
                                  Mask="@(new PatternMask("000.000.000-00"))" 
                                  Clearable="true" />
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudTextField Label="E-mail" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="cadModel.Email" For="@(()=>cadModel.Email)" autocomplete="off" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Confirmar E-mail" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="cadModel.ConfirmEmail" For="@(()=>cadModel.ConfirmEmail)" autocomplete="off" />
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudTextField InputType="@_passwordInput" Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" AdornmentColor="Color.Inherit" OnAdornmentClick="TogglePasswordVisibility" Label="Senha" Variant="Variant.Filled" Margin="Margin.Dense"  @bind-Value="cadModel.Password" For="@(()=>cadModel.Password)" autocomplete="new-password" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField InputType="@_passwordInput" AdornmentIcon="@_passwordInputIcon" Label="Confirmar Senha" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="cadModel.ConfirmPassword" For="@(()=>cadModel.ConfirmPassword)" autocomplete="new-password" />
                </MudItem>
                @*Termos e Privacidade*@
                <MudItem xs="12" Class="mt-2 text-center">
                    <MudText Typo="Typo.caption">
                        Ao criar, aceita os <a href="/Termos" class="orange-link">Termos</a> e <a href="/Privacidade" class="orange-link">Privacidade</a>.
                    </MudText>
                </MudItem>

                <MudItem xs="12" Class="mt-4">
                    <MudButton ButtonType="ButtonType.Submit" 
                               Variant="Variant.Filled" 
                               FullWidth="true" 
                               Style="background-color: coral; font-weight: 700;"
                               Class="py-3"
                               Disabled="@_isLoading">
                        <span>CRIAR CONTA</span>
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Class="ms-2" Color="Color.Inherit" Indeterminate="true" />
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
</div>

@code {
    private CadastroModel cadModel = new();
    private bool _isLoading = false;
    bool _isPasswordVisible;
    InputType _passwordInput = InputType.Password;
    string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    void IrParaLogin() => NavigationManager.NavigateTo("/login");
    void VoltarHome() => NavigationManager.NavigateTo("/");
    
    private bool ValidarCPF(string cpf)
    {
        if (string.IsNullOrWhiteSpace(cpf))
            return false;

        // Remove caracteres não numéricos
        var numeros = new string(cpf.Where(char.IsDigit).ToArray());

        // CPF deve ter 11 dígitos
        if (numeros.Length != 11)
            return false;

        // Verifica se todos os dígitos são iguais (ex: 111.111.111-11)
        if (numeros.Distinct().Count() == 1)
            return false;

        // Validação dos dígitos verificadores
        int[] multiplicadores1 = { 10, 9, 8, 7, 6, 5, 4, 3, 2 };
        int[] multiplicadores2 = { 11, 10, 9, 8, 7, 6, 5, 4, 3, 2 };

        var digitos = numeros.Select(c => int.Parse(c.ToString())).ToArray();

        // Calcula primeiro dígito verificador
        int soma = 0;
        for (int i = 0; i < 9; i++)
            soma += digitos[i] * multiplicadores1[i];
        int resto = soma % 11;
        int dv1 = resto < 2 ? 0 : 11 - resto;

        if (digitos[9] != dv1)
            return false;

        // Calcula segundo dígito verificador
        soma = 0;
        for (int i = 0; i < 10; i++)
            soma += digitos[i] * multiplicadores2[i];
        resto = soma % 11;
        int dv2 = resto < 2 ? 0 : 11 - resto;

        return digitos[10] == dv2;
    }

    public async Task HandleCadastro() 
    { 
        _isLoading = true;
        
        try
        {
            // Valida CPF
            if (!string.IsNullOrWhiteSpace(cadModel.CPF) && !ValidarCPF(cadModel.CPF))
            {
                Snackbar.Add("CPF inválido. Verifique os números informados.", Severity.Error);
                _isLoading = false;
                return;
            }

            var request = new RegistroRequest
            {
                Nome = cadModel.FirstName,
                Sobrenome = cadModel.LastName,
                Email = cadModel.Email,
                Senha = cadModel.Password,
                Telefone = string.IsNullOrWhiteSpace(cadModel.Phone) ? null : cadModel.Phone,
                Cpf = string.IsNullOrWhiteSpace(cadModel.CPF) ? null : cadModel.CPF.Replace(".", "").Replace("-", ""),
                DataNascimento = cadModel.BirthDate?.ToString("yyyy-MM-dd")
            };

            var result = await AuthService.RegistrarAsync(request);

            if (result.Success)
            {
                Snackbar.Add("Conta criada com sucesso! Faça login.", Severity.Success);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro no cadastro: {ex}");
            Snackbar.Add("Erro ao criar conta. Verifique sua conexão e tente novamente.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    void TogglePasswordVisibility()
    {
        if (_isPasswordVisible)
        {
            _isPasswordVisible = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _isPasswordVisible = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }
    public class CadastroModel 
    {
        [Required(ErrorMessage = "Nome é obrigatório!")] public string FirstName { get; set; } = "";
        [Required(ErrorMessage = "Sobrenome é obrigatório!")] public string LastName { get; set; } = "";
        [Required(ErrorMessage = "CPF é obrigatório!")] public string CPF { get; set; } = "";
        [Required(ErrorMessage = "E-mail é obrigatório!"), EmailAddress(ErrorMessage = "E-mail inválido")] public string Email { get; set; } = "";
        [Required(ErrorMessage = "Confirmação de e-mail é obrigatória!")]
        [Compare(nameof(Email), ErrorMessage = "E-mails diferentes!")] public string ConfirmEmail { get; set; } = "";
        [Required(ErrorMessage = "Senha é obrigatória!"), MinLength(6, ErrorMessage = "Mínimo 6 caracteres")] public string Password { get; set; } = "";
        [Required(ErrorMessage = "Confirmação de senha é obrigatória!")]
        [Compare(nameof(Password), ErrorMessage = "Senhas diferentes!")] public string ConfirmPassword { get; set; } = "";
        public string? Phone { get; set; }
        public DateTime? BirthDate { get; set; }
    }
}
