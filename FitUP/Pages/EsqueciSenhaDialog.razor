@using System.ComponentModel.DataAnnotations
@using FitUP.Services
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="pa-4">
            <MudText Typo="Typo.body1">
                Informe o e-mail cadastrado para receber o link de redefinição de senha.
            </MudText>

            <EditForm Model="@_model" OnValidSubmit="Enviar">
                <DataAnnotationsValidator />
                <MudTextField T="string"
                              Label="E-mail"
                              Variant="Variant.Filled"
                              @bind-Value="_model.Email"
                              For="@(() => _model.Email)"
                              Immediate="true" />
            </EditForm>

        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text" Disabled="@_isLoading">Cancelar</MudButton>
        <MudButton OnClick="EnviarHandler" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isLoading">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" />
            }
            Enviar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string EmailInicial { get; set; } = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private EsqueciSenhaModel _model = new();
    private bool _isLoading;

    protected override void OnInitialized()
    {
        _model.Email = EmailInicial;
    }

    private void Cancelar()
    {
        MudDialog.Cancel();
    }

    private async Task EnviarHandler()
    {
        if (string.IsNullOrWhiteSpace(_model.Email))
        {
            Snackbar.Add("Informe um e-mail válido.", Severity.Warning);
            return;
        }

        if (!new EmailAddressAttribute().IsValid(_model.Email))
        {
            Snackbar.Add("Formato de e-mail inválido.", Severity.Warning);
            return;
        }

        await Enviar();
    }

    private async Task Enviar()
    {
        _isLoading = true;

        try
        {
            var request = new EsqueciSenhaRequestDto
            {
                Email = _model.Email
            };

            var result = await AuthService.EsqueciSenhaAsync(request);

            if (result.Success)
            {
                Snackbar.Add("Um e-mail com instruções para redefinir sua senha foi enviado. Verifique sua caixa de entrada.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(result.Data));
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro no esqueci senha: {ex}");
            Snackbar.Add("Erro ao processar a solicitação. Verifique sua conexão.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class EsqueciSenhaModel
    {
        [Required(ErrorMessage = "O e-mail é obrigatório.")]
        [EmailAddress(ErrorMessage = "Formato de e-mail inválido.")]
        public string Email { get; set; } = string.Empty;
    }
}