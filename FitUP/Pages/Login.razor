@page "/login"
@using System.ComponentModel.DataAnnotations
@using FitUP.Services
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Login</PageTitle>

<style>
    :root {
        --mud-palette-primary: coral;
        --mud-palette-primary-hover: #ff8e61;
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100%;
        width: 100%;
    }

    .login-card {
        width: 100%;
        max-width: 450px;
        position: relative;
    }

    .btn-close {
        position: absolute;
        top: 12px;
        right: 12px;
        color: #f44336 !important;
        transition: transform 0.2s ease-in-out, opacity 0.2s;
        opacity: 0.7;
    }
    
        .btn-close:hover {
            color: #d32f2f !important;
            opacity: 1;
            transform: scale(1.1);
        }

    .btn-principal {
        background-color: coral !important; 
        color: white !important;
        font-weight: 700;
        text-transform: uppercase;
    }

    .btn-secundario {
        background-color: #000000 !important;
        color: #ffffff !important;
        font-weight: 700;
        text-transform: none;
    }

        .btn-secundario:hover {
            background-color: #333333 !important;
        }

    .texto-esqueceu {
        font-size: 14px;
        font-weight: 600;
        color: coral; 
        cursor: pointer;
        text-decoration: none;
    }

        .texto-esqueceu:hover {
            text-decoration: underline;
            color: #ff8e61;
        }
</style>

<div class="login-wrapper pa-4">
    <MudPaper Elevation="5" Class="login-card pa-10 mt-15 rounded-xl">
        
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Class="btn-close"
                       OnClick="VoltarHome"
                       Size="Size.Medium" />

        <MudStack Spacing="2">
            
            <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 700">
                Bem-vindo(a) de volta
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6">
                Olá! Entre com suas credenciais para acessar o sistema.
            </MudText>

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField T="string"
                              Label="Seu e-mail"
                              Variant="Variant.Filled"
                              @bind-Value="loginModel.Identity"
                              For="@(() => loginModel.Identity)"
                              Class="mb-4" />

                <MudTextField T="string"
                              Label="Sua senha"
                              Variant="Variant.Filled"
                              @bind-Value="loginModel.Password"
                              For="@(() => loginModel.Password)"
                              InputType="@_passwordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              AdornmentColor="Color.Inherit"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Class="mb-6" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Style="background-color:coral; font-weight: 700;"
                           Class="mb-3 py-3"
                           FullWidth="true"
                           Disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" />
                    }
                    ENTRAR
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Href="/cadastrar"
                           Class="btn-secundario mb-6 py-3"
                           FullWidth="true">
                    CRIAR CONTA
                </MudButton>

                <div class="d-flex justify-center">
                    <MudText Class="texto-esqueceu" @onclick="AbrirDialogoEsqueciSenha">
                        Esqueceu a senha?
                    </MudText>
                </div>
            </EditForm>

        </MudStack>
    </MudPaper>
</div>

@code {
    private LoginModel loginModel = new();
    bool _isPasswordVisible;
    InputType _passwordInput = InputType.Password;
    string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    bool _isLoading;

    void TogglePasswordVisibility()
    {
        if (_isPasswordVisible)
        {
            _isPasswordVisible = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _isPasswordVisible = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

    void VoltarHome() => NavigationManager.NavigateTo("/");

    private async Task HandleLogin()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            var request = new LoginRequest
            {
                Email = loginModel.Identity,
                Senha = loginModel.Password
            };

            var response = await AuthService.LoginAsync(request);

            if (response is not null)
            {
                Snackbar.Add($"Bem-vindo(a), {response.Nome}!", Severity.Success);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                Snackbar.Add("E-mail ou senha inválidos. Tente novamente.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao conectar com o servidor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AbrirDialogoEsqueciSenha()
    {
        var parameters = new DialogParameters
        {
            { "EmailInicial", loginModel.Identity ?? string.Empty }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true,
            NoHeader = false
        };

        var dialog = await DialogService.ShowAsync<EsqueciSenhaDialog>("Esqueci minha senha", parameters, options);
        var result = await dialog.Result;

        // O EsqueciSenhaDialog já exibe o link via snackbar
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "O e-mail é obrigatório!")]
        [EmailAddress(ErrorMessage = "Insira um e-mail válido!")]
        public string Identity { get; set; } = string.Empty;

        [Required(ErrorMessage = "A senha é obrigatória!")]
        public string Password { get; set; } = string.Empty;
    }
}