@page "/GanhoMaximo"
@using System.Text.Json
@using System.Text.Encodings.Web
@using FitUP.Services
@using FitUP.Components.GanhoMaximo
@inject IJSRuntime JS
@inject DietaDataService DietaData

<PageTitle>Ganho Maximo</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 py-0 mb-8 d-flex flex-column justify-center animate-fade-in">
    <MudStack AlignItems="AlignItems.Center" Spacing="0">
        @*Titulo da pg*@
        <div class="d-flex align-center justify-center">
            <MudText Typo="Typo.h4" Style="font-weight:bold;color:coral;font-family:Cambria" Align="Align.Center" Inline="true">Ganho</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:bold;font-family:Cambria" Align="Align.Center" Inline="true">Máximo</MudText>
        </div>

        <MudDivider Style="--mud-palette-divider:coral; max-width:455px; width:100%"></MudDivider>

        <MudCard Elevation="12" Style="max-width:455px; width:100%;min-height:171px; height:auto" Class="rounded-sm">
            <MudText Align="Align.Center" Class="pa-1">
                Aqui você aprendera um pouco do mundo da alimentação e<br /> como isso poderá ajudar nos treinos!<br />
                Para alcançar a máxima hipertrofia e performance, não basta apenas "comer limpo"; é preciso entender a função bioquímica de cada substrato que você ingere.<br /> Abaixo, apresentaremos o guia técnico dos macronutrientes e micronutrientes essenciais para o seu desenvolvimento físico.
            </MudText>
        </MudCard>

@*Botoes de ativacao*@
        <div class="mt-2 d-flex gap-1 flex-wrap align-center justify-center">
            <MudButton Class="transition-fast-out-slow-in scale-hover" OnClick="ToggleProteinas" Style="background-color:darkred;font-weight:bold;font-family:Cambria">Proteinas</MudButton>
            <MudButton Class="transition-fast-out-slow-in scale-hover" OnClick="ToggleCarboidratos" Style="background-color:sandybrown;font-weight:bold;font-family:Cambria">Carboidratos</MudButton>
            <MudButton Class="transition-fast-out-slow-in scale-hover" OnClick="ToggleFrutas" Style="background-color:darkcyan;font-weight:bold;font-family:Cambria">Frutas</MudButton>
            <MudButton Class="transition-fast-out-slow-in scale-hover" OnClick="ToggleVegetais" Style="background-color:seagreen;font-weight:bold;font-family:Cambria">Vegetais</MudButton>
            <MudButton Class="transition-fast-out-slow-in scale-hover" OnClick="ToggleGorduras" Style="background-color:saddlebrown;font-weight:bold;font-family:Cambria">Gorduras</MudButton>
            <MudButton Class="transition-fast-out-slow-in scale-hover" Href="/CalculadoraBio" Style="background-color:coral;font-weight:bold;font-family:Cambria">Calculadora</MudButton>
            <MudButton Class="transition-fast-out-slow-in scale-hover" Href="/GeradorDieta" Style="background-color:darkslategrey; font-weight:bold;font-family:Cambria">Gerar Dieta</MudButton>
        </div>
    </MudStack>

    @*Conteudo das secoes (renderizado fora da barra de botoes)*@
    @if (_secaoAtiva == "Proteinas") { <ProteinasSection /> }
    @if (_secaoAtiva == "Carboidratos") { <CarboidratosSection /> }
    @if (_secaoAtiva == "Frutas") { <FrutasSection /> }
    @if (_secaoAtiva == "Vegetais") { <VegetaisSection /> }
    @if (_secaoAtiva == "Gorduras") { <GordurasSection /> }

    <div class="mt-2">
        <MudText Style="font-weight:bold;font-family:Cambria;color:coral" Typo="Typo.h4" Align="Align.Start" Inline="true">Dietas</MudText>
        <MudText Style="font-weight:bold;font-family:Cambria" Typo="Typo.h4" Align="Align.Start" Inline="true"> Completas:</MudText>
    </div>

    @foreach (var dieta in DietaData.Dietas)
    {
        <MudStack AlignItems="AlignItems.Center">
            <div class="align-center justify-center mt-1">
                <MudText Inline="true" Style="font-weight:bold;font-family:Cambria;color:coral" Typo="Typo.h4" Align="Align.Center">@dieta.Nome.Split('/')[0].Trim()</MudText>
                @if (dieta.Nome.Contains('/'))
                {
                    <MudText Inline="true" Style="font-weight:bold;font-family:Cambria" Typo="Typo.h4" Align="Align.Center">/@dieta.Nome.Split('/')[1].Trim()</MudText>
                }
            </div>
            <MudCard>
                <MudText Align="Align.Center">
                    @dieta.Descricao
                </MudText>
            </MudCard>
        </MudStack>

        <div class="d-flex flex-wrap gap-5 justify-center mt-2">
            @foreach (var refeicao in dieta.Refeicoes)
            {
                <MudCard Elevation="11" Style="width: 280px;" Class="rounded-xl transition-fast-out-slow-in scale-hover mb-1">
                    @if (!string.IsNullOrEmpty(refeicao.Imagem))
                    {
                        <MudCardMedia Image="@refeicao.Imagem" Height="150" />
                    }
                    <MudCardContent>
                        <MudButton Style="background-color:coral; width: 100%;font-weight: 800">@refeicao.Titulo</MudButton>
                        <MudText Class="mt-1" Align="Align.Start" Typo="Typo.body2">
                            @foreach (var alimento in refeicao.Alimentos)
                            {
                                <b>@alimento.Label</b>@alimento.Valor<br />
                            }
                        </MudText>
                    </MudCardContent>
                </MudCard>
            }
        </div>

        <MudStack AlignItems="AlignItems.Center" Class="mt-2">
            <MudButton Class="transition-fast-out-slow-in scale-hover mt-1 mb-2"
                       Style="background-color: coral; font-weight: bold; color: white; width:220px; text-transform:uppercase;"
                       StartIcon="@Icons.Material.Outlined.FileDownload"
                       OnClick="() => ExportarDietaPdf(dieta.Id)">
                Baixar a Dieta
            </MudButton>
        </MudStack>
        <MudDivider Class="mt-3 mb-3" Style="--mud-palette-divider:coral"></MudDivider>
    }
</MudContainer>

<style>
    .scale-hover:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease-in-out;
    }
    .animate-fade-in { animation: fadeIn 0.6s ease-out; }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private string _secaoAtiva = "";

    private void ToggleProteinas() => _secaoAtiva = _secaoAtiva == "Proteinas" ? "" : "Proteinas";
    private void ToggleCarboidratos() => _secaoAtiva = _secaoAtiva == "Carboidratos" ? "" : "Carboidratos";
    private void ToggleFrutas() => _secaoAtiva = _secaoAtiva == "Frutas" ? "" : "Frutas";
    private void ToggleVegetais() => _secaoAtiva = _secaoAtiva == "Vegetais" ? "" : "Vegetais";
    private void ToggleGorduras() => _secaoAtiva = _secaoAtiva == "Gorduras" ? "" : "Gorduras";

    private async Task ExportarDietaPdf(int dietaId)
    {
        try
        {
            var dieta = DietaData.GetById(dietaId);
            if (dieta == null) return;

            var pdfData = new
            {
                nome = dieta.Nome,
                descricao = dieta.Descricao,
                refeicoes = dieta.Refeicoes.Select(r => new
                {
                    titulo = r.Titulo,
                    alimentos = r.Alimentos.Select(a => new
                    {
                        label = a.Label,
                        valor = a.Valor
                    }).ToArray()
                }).ToArray()
            };

            var options = new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            };

            var json = JsonSerializer.Serialize(pdfData, options);
            await JS.InvokeVoidAsync("exportDietaPdf", json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao exportar PDF da dieta: {ex.Message}");
        }
    }
}