@page "/GeradorDieta"
@using FitUP.Services
@using System.Text.Json
@using System.Text.Encodings.Web
@inject IJSRuntime JS
@inject PlanoAlimentarService PlanoAlimentarService
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject HttpClient Http

<PageTitle>Gerador de Dietas</PageTitle>


<div class="page-bg">
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-0 mb-6">

    <div class="page-header anim-fade-up">
        <div class="title-line flex-wrap">
            <MudText Typo="Typo.h3" Style="font-weight:800;color:coral;font-family:Cambria" Inline="true">Gerador</MudText>
            <MudText Typo="Typo.h3" Style="font-weight:800;font-family:Cambria" Inline="true">de Dietas</MudText>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-1" Style="opacity:0.6;">
            Calculo inteligente baseado em ciencia nutricional
        </MudText>
    </div>

    @if (_isLoadingAlimentos)
    {
        <MudContainer MaxWidth="MaxWidth.Small" Class="px-4">
            <div class="step-panel anim-fade-scale" style="text-align:center;padding:60px;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-4" Style="opacity:0.6;">Carregando banco de alimentos...</MudText>
            </div>
        </MudContainer>
    }
    else if (!_dietaGerada)
    {
        <div class="custom-stepper">
            <div class="step-pill @(_activeStep == 0 ? "active" : _activeStep > 0 ? "done" : "")">
                 <span class="step-num">@(_activeStep > 0 ? "âœ“" : "1")</span> Perfil
            </div>
            <div class="step-connector @(_activeStep > 0 ? "done" : "")"></div>
            <div class="step-pill @(_activeStep == 1 ? "active" : _activeStep > 1 ? "done" : "")">
                 <span class="step-num">@(_activeStep > 1 ? "âœ“" : "2")</span> Metas
            </div>
            <div class="step-connector @(_activeStep > 1 ? "done" : "")"></div>
            <div class="step-pill @(_activeStep == 2 ? "active" : "")">
                <span class="step-num">3</span> Revisao
            </div>
        </div>

        @* STEP 1 *@
        @if (_activeStep == 0)
        {
            <MudContainer MaxWidth="MaxWidth.Small" Class="px-4">
                <div class="step-panel anim-fade-scale">
                    <MudText Typo="Typo.h6" Style="font-weight:700;" Class="mb-1">Dados Corporais</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mb-4" Style="opacity:0.55;">
                        Essas informacoes sao usadas para calcular seu metabolismo basal.
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_peso" Label="Peso" Variant="Variant.Filled" Adornment="Adornment.End" AdornmentText="kg" Immediate="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_altura" Label="Altura" Variant="Variant.Filled" Adornment="Adornment.End" AdornmentText="cm" Immediate="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_idade" Label="Idade" Variant="Variant.Filled" Immediate="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_sexo" Label="Sexo" Variant="Variant.Filled" Margin="Margin.Dense">
                                <MudSelectItem Value="@("M")">Masculino</MudSelectItem>
                                <MudSelectItem Value="@("F")">Feminino</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Class="btn-flat " Style="background:coral !important" OnClick="AvancarStep1">Proximo</MudButton>
                    </MudStack>
                </div>
            </MudContainer>
        }

        @* STEP 2 *@
        @if (_activeStep == 1)
        {
            <MudContainer MaxWidth="MaxWidth.Medium" Class="px-4">
                <div class="step-panel anim-fade-scale">
                    <MudText Typo="Typo.h6" Style="font-weight:700;" Class="mb-1">Seu Objetivo</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mb-4" Style="opacity:0.55;">
                        Escolha o que melhor representa sua meta atual.
                    </MudText>

                    <div class="obj-cards mb-4">
                        <div class="obj-card @(_objetivo == 0 ? "selected" : "")" @onclick="() => _objetivo = 0">
                            <span class="obj-check">&#10003;</span>
                            <div class="obj-title">Bulking</div>
                            <div class="obj-sub">Ganho de massa muscular com superavit calorico</div>
                        </div>
                        <div class="obj-card @(_objetivo == 1 ? "selected" : "")" @onclick="() => _objetivo = 1">
                            <span class="obj-check">&#10003;</span>
                            <div class="obj-title">Cutting</div>
                            <div class="obj-sub">Perda de gordura preservando massa magra</div>
                        </div>
                        <div class="obj-card @(_objetivo == 2 ? "selected" : "")" @onclick="() => _objetivo = 2">
                            <span class="obj-check">&#10003;</span>
                            <div class="obj-title">Manutencao</div>
                            <div class="obj-sub">Equilibrio calorico para manter o peso</div>
                        </div>
                    </div>

                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_nivelAtividade" Label="Nivel de Atividade" Variant="Variant.Filled" Margin="Margin.Dense">
                                <MudSelectItem Value="1">Sedentario</MudSelectItem>
                                <MudSelectItem Value="2">Leve (1-3 dias/sem)</MudSelectItem>
                                <MudSelectItem Value="3">Moderado (3-5 dias/sem)</MudSelectItem>
                                <MudSelectItem Value="4">Intenso (6-7 dias/sem)</MudSelectItem>
                                <MudSelectItem Value="5">Atleta (2x/dia)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_numRefeicoes" Label="Refeicoes por dia" Variant="Variant.Filled" Margin="Margin.Dense">
                                <MudSelectItem Value="3">3 refeicoes</MudSelectItem>
                                <MudSelectItem Value="4">4 refeicoes</MudSelectItem>
                                <MudSelectItem Value="5">5 refeicoes</MudSelectItem>
                                <MudSelectItem Value="6">6 refeicoes</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_restricao" Label="Restricao Alimentar" Variant="Variant.Filled" Margin="Margin.Dense">
                                <MudSelectItem Value="0">Nenhuma</MudSelectItem>
                                <MudSelectItem Value="1">Sem lactose</MudSelectItem>
                                <MudSelectItem Value="2">Vegetariano</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                        <MudButton Class="btn-flat btn-reset" OnClick="VoltarStep2" StartIcon="@Icons.Material.Filled.ArrowBack">Voltar</MudButton>
                        <MudButton Class="btn-flat" Style="background:coral !important" OnClick="AvancarStep2">Proximo</MudButton>
                    </MudStack>
                </div>
            </MudContainer>
        }

        @* STEP 3 *@
        @if (_activeStep == 2)
        {
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-4">
                <div class="step-panel anim-fade-scale">
                    <MudText Typo="Typo.h6" Style="font-weight:700;" Class="mb-1">Revisao do Plano</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mb-4" Style="opacity:0.55;">
                        Confira seus dados e as metas calculadas antes de gerar a dieta.
                    </MudText>

                    <div class="review-grid">
                        <div class="review-card anim-slide-left" style="animation-delay:0.05s;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700;color:coral;" Class="mb-2">Seus Dados</MudText>
                            <div class="macro-pill"><span style="opacity:0.65;">Peso</span><strong>@_peso kg</strong></div>
                            <div class="macro-pill"><span style="opacity:0.65;">Altura</span><strong>@_altura cm</strong></div>
                            <div class="macro-pill"><span style="opacity:0.65;">Idade</span><strong>@_idade anos</strong></div>
                            <div class="macro-pill"><span style="opacity:0.65;">Sexo</span><strong>@(_sexo == "M" ? "Masculino" : "Feminino")</strong></div>
                            <div class="macro-pill"><span style="opacity:0.65;">Atividade</span><strong>@NomeNivelAtividade(_nivelAtividade)</strong></div>
                            <div class="macro-pill"><span style="opacity:0.65;">Objetivo</span><strong>@(_objetivo switch { 0 => "Bulking", 1 => "Cutting", _ => "Manutencao" })</strong></div>
                            <div class="macro-pill"><span style="opacity:0.65;">Refeicoes/dia</span><strong>@_numRefeicoes</strong></div>
                        </div>

                        <div class="review-card anim-slide-left" style="animation-delay:0.15s;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700;color:#2E7D32;" Class="mb-2">Metas Calculadas</MudText>
                            <div style="text-align:center;padding:12px 0;">
                                <MudText Typo="Typo.h3" Style="font-weight:800;color:coral;">@_metaCalorias.ToString("F0")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Inherit">kcal / dia</MudText>
                            </div>
                            <MudDivider Style="margin:8px 0;opacity:0.2;" />
                            <div class="macro-pill"><span><span class="macro-dot" style="background:darkred;"></span>Proteinas</span><strong>@_metaProteina.ToString("F0")g</strong></div>
                            <div class="macro-bar-wrap"><div class="macro-bar-fill" style="width:@((_metaProteina*4/_metaCalorias*100).ToString("F0"))%;background:darkred;"></div></div>
                            <div class="macro-pill"><span><span class="macro-dot" style="background:sandybrown;"></span>Carboidratos</span><strong>@_metaCarbo.ToString("F0")g</strong></div>
                            <div class="macro-bar-wrap"><div class="macro-bar-fill" style="width:@((_metaCarbo*4/_metaCalorias*100).ToString("F0"))%;background:sandybrown;"></div></div>
                            <div class="macro-pill"><span><span class="macro-dot" style="background:saddlebrown;"></span>Gorduras</span><strong>@_metaGordura.ToString("F0")g</strong></div>
                            <div class="macro-bar-wrap"><div class="macro-bar-fill" style="width:@((_metaGordura*9/_metaCalorias*100).ToString("F0"))%;background:saddlebrown;"></div></div>
                            <div style="margin-top:12px; padding-top:10px; border-top:1px solid rgba(255,127,80,0.08);">
                                <span style="font-size:0.8rem; opacity:0.55;">TMB: @_tmb.ToString("F0") kcal Â· TDEE: @_tdee.ToString("F0") kcal</span>
                            </div>
                        </div>
                    </div>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4 flex-wrap">
                        <MudButton Class="btn-flat btn-reset" OnClick="VoltarStep3" StartIcon="@Icons.Material.Filled.ArrowBack">Voltar</MudButton>
                        <MudButton  Class="btn-flat" Style="background:#2E7D32 !important; font-size:1.05rem !important; padding:13px 36px !important;" OnClick="GerarDieta">Gerar Dieta</MudButton>
                    </MudStack>
                </div>
            </MudContainer>
        }
    }
    else
    {
        @* RESULTADO *@
        <MudContainer MaxWidth="MaxWidth.Medium" Class="px-0 mt-4 mb-6 anim-fade-up">
            <MudCard Elevation="0" Class="pa-4 mb-4" Style="border:1.5px solid rgba(255,127,80,0.5); border-radius:16px">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="flex-wrap:wrap; gap:8px;">
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight:700;">Seu Plano Alimentar</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Inherit" Style="opacity:0.55;">@_nomeObjetivo</MudText>
                    </div>
                    <div style="text-align:right;">
                        <MudText Typo="Typo.h5" Style="font-weight:800;color:coral;">@_totalCaloriasGerado.ToString("F0") kcal</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Inherit">P:@_totalProteinaGerado.ToString("F0")g C:@_totalCarboGerado.ToString("F0")g G:@_totalGorduraGerado.ToString("F0")g</MudText>
                    </div>
                </MudStack>
            </MudCard>

            <div>
                @for (int i = 0; i < _refeicoesGeradas.Count; i++)
                {
                    var refeicao = _refeicoesGeradas[i];
                    string horaStr = refeicao.HorarioSugerido.HasValue ? refeicao.HorarioSugerido.Value.ToString(@"hh\:mm") : "";
                    <div class="tl-item">
                        <div class="tl-card">
                            <div class="tl-header"><h6 style="color:coral;">@refeicao.Nome</h6><span style="font-size:0.78rem;opacity:0.55;">@horaStr</span></div>
                            <div class="tl-body">
                                <table class="tl-table">
                                    <thead><tr><th>Alimento</th><th class="num">Qtd</th><th class="num">P</th><th class="num">C</th><th class="num">G</th><th class="num">Kcal</th></tr></thead>
                                    <tbody>
                                        @foreach (var alim in refeicao.Alimentos)
                                        {
                                            <tr><td>@alim.Nome</td><td class="num">@alim.Quantidade.ToString("F0")@alim.UnidadeMedida</td><td class="num">@alim.Proteina.ToString("F0")</td><td class="num">@alim.Carboidrato.ToString("F0")</td><td class="num">@alim.Gordura.ToString("F0")</td><td class="num">@alim.Calorias.ToString("F0")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="tl-footer">
                                <span style="color:darkred;">P: @refeicao.TotalProteina.ToString("F0")g</span>
                                <span style="color:sandybrown;">C: @refeicao.TotalCarboidrato.ToString("F0")g</span>
                                <span style="color:saddlebrown;">G: @refeicao.TotalGordura.ToString("F0")g</span>
                                <span style="color:#2E7D32;margin-left:auto;">@refeicao.TotalCalorias.ToString("F0") kcal</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="floating-bar">
                <MudButton Class="btn-flat btn-save" Style="background-color:seagreen" OnClick="SalvarDieta" Disabled="@_isSavingDieta">
                    @if (_isSavingDieta)
                    {
                        <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="me-2" />
                        <span>Salvando...</span>
                    }
                    else
                    {
                        <span>Salvar Dieta</span>
                    }
                </MudButton>
                <MudButton Class="btn-flat btn-pdf" Style="background-color:coral" OnClick="ExportarPdf" Disabled="@_isExporting">
                    @if (_isExporting)
                    {
                        <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="me-2" />
                        <span>Exportando...</span>
                    }
                    else
                    {
                        <span>Baixar PDF</span>
                    }
                </MudButton>
                <MudButton Class="btn-flat btn-reset" OnClick="NovaGeracao" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@(_isSavingDieta || _isExporting)">Recomecar</MudButton>
            </div>
        </MudContainer>
    }
</MudContainer>
</div>

@code {
    private int _activeStep = 0;

    private string _peso = "";
    private string _altura = "";
    private string _idade = "";
    private string _sexo = "M";
    private int _nivelAtividade = 3;
    private int _objetivo = 0;
    private int _numRefeicoes = 5;
    private int _restricao = 0;

    private bool _dietaGerada = false;
    private bool _isLoadingAlimentos = true;
    private bool _isSavingDieta;
    private bool _isExporting;
    private double _tmb, _tdee, _metaCalorias, _metaProteina, _metaCarbo, _metaGordura, _metaFibra;
    private string _nomeObjetivo = "";
    private double _totalCaloriasGerado, _totalProteinaGerado, _totalCarboGerado, _totalGorduraGerado, _totalFibraGerado;
    private List<RefeicaoViewModel> _refeicoesGeradas = new();

    private void AvancarStep1()
    {
        if (!double.TryParse(_peso, out var peso) || !double.TryParse(_altura, out var altura) || !double.TryParse(_idade, out var idade))
        { Snackbar.Add("Preencha todos os campos corretamente.", Severity.Warning); return; }
        if (peso < 30 || peso > 250 || altura < 100 || altura > 250 || idade < 10 || idade > 100)
        { Snackbar.Add("Verifique peso (30-250), altura (100-250) e idade (10-100).", Severity.Warning); return; }
        _activeStep = 1;
    }
    private void VoltarStep2() => _activeStep = 0;
    private void AvancarStep2() { CalcularMetas(); _activeStep = 2; }
    private void VoltarStep3() => _activeStep = 1;

    private string NomeNivelAtividade(int n) => n switch { 1 => "Sedentario", 2 => "Leve", 3 => "Moderado", 4 => "Intenso", 5 => "Atleta", _ => "-" };

    private void CalcularMetas()
    {
        if (!double.TryParse(_peso, out var peso) || !double.TryParse(_altura, out var altura) || !double.TryParse(_idade, out var idade)) return;
        _tmb = _sexo == "M" ? 88.362 + (13.397 * peso) + (4.799 * altura) - (5.677 * idade) : 447.593 + (9.247 * peso) + (3.098 * altura) - (4.330 * idade);
        double fa = _nivelAtividade switch { 1 => 1.2, 2 => 1.375, 3 => 1.55, 4 => 1.725, 5 => 1.9, _ => 1.55 };
        _tdee = _tmb * fa;
        _metaCalorias = _objetivo switch { 0 => _tdee + 500, 1 => Math.Max(_tdee - 500, _tmb), _ => _tdee };
        _nomeObjetivo = _objetivo switch { 0 => "Bulking (Ganho de Massa)", 1 => "Cutting (Perda de Gordura)", _ => "Manutencao" };
        _metaProteina = peso * 2.0; _metaGordura = peso * 0.9;
        _metaCarbo = Math.Max((_metaCalorias - _metaProteina * 4 - _metaGordura * 9) / 4, 50);
        _metaFibra = _objetivo == 1 ? 35 : 28;
    }

    private class AlimentoJson { public string Nome { get; set; } = ""; public double Proteina { get; set; } public double Carboidrato { get; set; } public double Gordura { get; set; } public double Fibra { get; set; } public double Calorias { get; set; } public string Categoria { get; set; } = ""; public List<string> Horarios { get; set; } = new(); public string UnidadeMedida { get; set; } = "g"; public double PorcaoPadrao { get; set; } = 100; }
    private class AlimentoBase { public string Nome = ""; public double Proteina, Carboidrato, Gordura, Fibra, Calorias; public string Categoria = ""; public List<string> Horarios = new(); public string UnidadeMedida = "g"; public double PorcaoPadrao = 100; }
    private List<AlimentoBase> _alimentosBase = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarAlimentosAsync();
    }

    private async Task CarregarAlimentosAsync()
    {
        _isLoadingAlimentos = true;
        try
        {
            var json = await Http.GetStringAsync("data/alimentos.json");
            var alimentosJson = JsonSerializer.Deserialize<List<AlimentoJson>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (alimentosJson != null && alimentosJson.Count > 0)
            {
                _alimentosBase = alimentosJson.Select(a => new AlimentoBase
                {
                    Nome = a.Nome,
                    Proteina = a.Proteina,
                    Carboidrato = a.Carboidrato,
                    Gordura = a.Gordura,
                    Fibra = a.Fibra,
                    Calorias = a.Calorias,
                    Categoria = a.Categoria,
                    Horarios = a.Horarios ?? new(),
                    PorcaoPadrao = a.PorcaoPadrao,
                    UnidadeMedida = a.UnidadeMedida ?? "g"
                }).ToList();
                _isLoadingAlimentos = false;
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar alimentos do JSON: {ex.Message}. Usando fallback hardcoded.");
        }

        // Fallback: dados hardcoded
        InicializarBancoAlimentosFallback();
        _isLoadingAlimentos = false;
    }

    private void InicializarBancoAlimentosFallback() {
        _alimentosBase = new List<AlimentoBase> {
            new() { Nome = "Peito de Frango", Proteina = 31, Carboidrato = 0, Gordura = 3.6, Fibra = 0, Calorias = 165, Categoria = "proteina", Horarios = new(){"almoco","janta"}, PorcaoPadrao = 150 },
            new() { Nome = "Ovos Inteiros", Proteina = 13, Carboidrato = 1.1, Gordura = 9.5, Fibra = 0, Calorias = 143, Categoria = "proteina", Horarios = new(){"cafe","ceia"}, UnidadeMedida = "unid", PorcaoPadrao = 2 },
            new() { Nome = "Clara de Ovo", Proteina = 11, Carboidrato = 0.7, Gordura = 0.2, Fibra = 0, Calorias = 52, Categoria = "proteina", Horarios = new(){"cafe","lanche"}, UnidadeMedida = "unid", PorcaoPadrao = 4 },
            new() { Nome = "Tilapia", Proteina = 26, Carboidrato = 0, Gordura = 2.7, Fibra = 0, Calorias = 128, Categoria = "proteina", Horarios = new(){"almoco","janta"}, PorcaoPadrao = 150 },
            new() { Nome = "Salmao", Proteina = 22, Carboidrato = 0, Gordura = 12, Fibra = 0, Calorias = 208, Categoria = "proteina", Horarios = new(){"janta"}, PorcaoPadrao = 150 },
            new() { Nome = "Carne Bovina Magra", Proteina = 26, Carboidrato = 0, Gordura = 6, Fibra = 0, Calorias = 158, Categoria = "proteina", Horarios = new(){"almoco"}, PorcaoPadrao = 150 },
            new() { Nome = "Atum (lata)", Proteina = 23, Carboidrato = 0, Gordura = 0.8, Fibra = 0, Calorias = 99, Categoria = "proteina", Horarios = new(){"lanche","janta"}, PorcaoPadrao = 120 },
            new() { Nome = "Whey Protein", Proteina = 75, Carboidrato = 10, Gordura = 5, Fibra = 0, Calorias = 385, Categoria = "proteina", Horarios = new(){"cafe","postreino","lanche"}, PorcaoPadrao = 30 },
            new() { Nome = "Albumina", Proteina = 80, Carboidrato = 5, Gordura = 0.5, Fibra = 0, Calorias = 345, Categoria = "proteina", Horarios = new(){"ceia"}, PorcaoPadrao = 30 },
            new() { Nome = "Iogurte Grego", Proteina = 10, Carboidrato = 4, Gordura = 0.7, Fibra = 0, Calorias = 59, Categoria = "proteina", Horarios = new(){"cafe","lanche","ceia"}, PorcaoPadrao = 170 },
            new() { Nome = "Sobrecoxa de Frango", Proteina = 26, Carboidrato = 0, Gordura = 8, Fibra = 0, Calorias = 176, Categoria = "proteina", Horarios = new(){"almoco","janta"}, PorcaoPadrao = 150 },
        };
    }

    private void GerarDieta()
    {
        if (!double.TryParse(_peso, out var peso)) return;
        CalcularMetas(); _refeicoesGeradas.Clear();
        var nomes = ObterNomesRefeicoes(_numRefeicoes); var horarios = ObterHorarios(_numRefeicoes);
        double ppR = _metaProteina / _numRefeicoes, cpR = _metaCarbo / _numRefeicoes, gpR = _metaGordura / _numRefeicoes, fpR = _metaFibra / _numRefeicoes;
        _totalCaloriasGerado = _totalProteinaGerado = _totalCarboGerado = _totalGorduraGerado = _totalFibraGerado = 0;
        var rnd = new Random();
        for (int i = 0; i < _numRefeicoes; i++)
        {
            double mp = ppR, mc = cpR, mg = gpR;
            if (i == 0) { mc *= 1.2; mg *= 0.8; } else if (i == _numRefeicoes - 1) { mc *= 0.5; mg *= 1.3; mp *= 1.1; } else if (i == _numRefeicoes - 2 && _numRefeicoes >= 5) { mc *= 1.1; }
            var refe = new RefeicaoViewModel { Nome = nomes[i], HorarioSugerido = horarios[i], Ordem = i + 1, Alimentos = new() };
            var als = SelecionarAlimentos(nomes[i], mp, mc, mg, fpR, rnd);
            double sp = 0, sc = 0, sg = 0, sf = 0, sk = 0;
            foreach (var a in als) { refe.Alimentos.Add(a); sp += a.Proteina; sc += a.Carboidrato; sg += a.Gordura; sf += a.Fibra; sk += a.Calorias; }
            refe.TotalProteina = Math.Round(sp, 1); refe.TotalCarboidrato = Math.Round(sc, 1); refe.TotalGordura = Math.Round(sg, 1); refe.TotalFibra = Math.Round(sf, 1); refe.TotalCalorias = Math.Round(sk, 0);
            _totalProteinaGerado += sp; _totalCarboGerado += sc; _totalGorduraGerado += sg; _totalFibraGerado += sf; _totalCaloriasGerado += sk;
            _refeicoesGeradas.Add(refe);
        }
        _totalProteinaGerado = Math.Round(_totalProteinaGerado, 1); _totalCarboGerado = Math.Round(_totalCarboGerado, 1); _totalGorduraGerado = Math.Round(_totalGorduraGerado, 1); _totalFibraGerado = Math.Round(_totalFibraGerado, 1); _totalCaloriasGerado = Math.Round(_totalCaloriasGerado, 0);
        _dietaGerada = true;
    }

    private List<AlimentoViewModel> SelecionarAlimentos(string nomeH, double mp, double mc, double mg, double mf, Random rnd)
    {
        var res = new List<AlimentoViewModel>();
        string ch = nomeH.ToLower() switch { "cafe da manha" => "cafe", "almoco" => "almoco", "lanche da tarde" => "lanche", "lanche" => "lanche", "pre-treino" => "pretreino", "pos-treino" => "postreino", "janta" => "janta", "ceia" => "ceia", _ => "almoco" };
        var disp = _alimentosBase.Where(a => a.Horarios.Contains(ch)).ToList();
        if (_restricao == 1) disp = disp.Where(a => a.Nome != "Iogurte Grego").ToList();
        else if (_restricao == 2) disp = disp.Where(a => a.Nome != "Peito de Frango" && a.Nome != "Tilapia" && a.Nome != "Salmao" && a.Nome != "Carne Bovina Magra" && a.Nome != "Atum (lata)" && a.Nome != "Sobrecoxa de Frango" && a.Nome != "Whey Protein" && a.Nome != "Albumina").ToList();
        if (disp.Count == 0) disp = _alimentosBase.Where(a => a.Horarios.Contains("almoco")).ToList();
        disp = disp.OrderBy(_ => rnd.Next()).ToList();
        double ga = 0, ca = 0;
        var pa = disp.FirstOrDefault(a => a.Categoria == "proteina"); var cb = disp.FirstOrDefault(a => a.Categoria == "carbo");
        var vg = disp.FirstOrDefault(a => a.Categoria == "vegetal" || a.Categoria == "fruta"); var gd = disp.FirstOrDefault(a => a.Categoria == "gordura");
        if (pa != null) { double f = Math.Clamp(mp / (pa.Proteina * (pa.PorcaoPadrao / 100.0)), 0.5, 2.0); double q = Math.Round(pa.PorcaoPadrao * f, 0); if (pa.UnidadeMedida != "g") q = Math.Round(q / 100, 0); var a = MakeVM(pa, q); res.Add(a); ca += a.Carboidrato; ga += a.Gordura; }
        if (cb != null) { double cr = Math.Max(mc - ca, 10); double f = Math.Clamp(cr / (cb.Carboidrato * (cb.PorcaoPadrao / 100.0)), 0.3, 2.5); double q = Math.Round(cb.PorcaoPadrao * f, 0); if (cb.UnidadeMedida != "g") q = Math.Round(q / 100, 0); var a = MakeVM(cb, q); res.Add(a); ga += a.Gordura; }
        if (vg != null) { double q = Math.Round(vg.PorcaoPadrao * 0.8, 0); if (vg.UnidadeMedida != "g") q = Math.Max(1, Math.Round(vg.PorcaoPadrao * 0.5, 0)); res.Add(MakeVM(vg, q)); }
        if (gd != null && ga < mg * 1.1) { double gr = Math.Max(mg - ga, 2); double f = Math.Clamp(gr / (gd.Gordura * (gd.PorcaoPadrao / 100.0)), 0.3, 1.5); double q = Math.Round(gd.PorcaoPadrao * f, 0); if (gd.UnidadeMedida != "g") q = Math.Round(q / 100, 0); res.Add(MakeVM(gd, q)); }
        return res;
    }

    private AlimentoViewModel MakeVM(AlimentoBase b, double qtd) {
        double f = b.UnidadeMedida != "g" ? (qtd * (b.Nome switch { "Ovos Inteiros" => 100, "Clara de Ovo" => 100, "Banana" => 120, "Maca" => 150, "Laranja" => 180, _ => 100 })) / 100.0 : qtd / 100.0;
        return new AlimentoViewModel { Nome = b.Nome, Quantidade = qtd, UnidadeMedida = b.UnidadeMedida, Proteina = Math.Round(b.Proteina * f, 1), Carboidrato = Math.Round(b.Carboidrato * f, 1), Gordura = Math.Round(b.Gordura * f, 1), Fibra = Math.Round(b.Fibra * f, 1), Calorias = Math.Round(b.Calorias * f, 0) };
    }

    private List<string> ObterNomesRefeicoes(int n) => n switch {
        3 => new() { "Cafe da Manha", "Almoco", "Janta" }, 4 => new() { "Cafe da Manha", "Almoco", "Lanche da Tarde", "Janta" },
        5 => new() { "Cafe da Manha", "Almoco", "Pre-Treino", "Pos-Treino", "Janta" }, _ => new() { "Cafe da Manha", "Almoco", "Pre-Treino", "Pos-Treino", "Janta", "Ceia" }
    };
    private List<TimeSpan> ObterHorarios(int n) => n switch {
        3 => new() { new(7,0,0), new(12,0,0), new(19,30,0) }, 4 => new() { new(7,0,0), new(12,0,0), new(16,0,0), new(19,30,0) },
        5 => new() { new(7,0,0), new(12,0,0), new(15,0,0), new(17,30,0), new(20,0,0) }, _ => new() { new(7,0,0), new(12,0,0), new(15,0,0), new(17,30,0), new(20,0,0), new(22,0,0) }
    };

    private void NovaGeracao() { _dietaGerada = false; _activeStep = 0; _refeicoesGeradas.Clear(); }

    private async Task SalvarDieta() {
        if (!AuthService.IsLoggedIn) { Snackbar.Add("Faca login para salvar.", Severity.Warning); return; }
        _isSavingDieta = true;
        try {
            var req = new PlanoAlimentarCompletoRequest { Nome = $"Dieta {_nomeObjetivo} - {DateTime.Now:dd/MM}", Objetivo = _objetivo,
                Descricao = $"Meta: {_metaCalorias:F0} kcal | P: {_metaProteina:F0}g C: {_metaCarbo:F0}g G: {_metaGordura:F0}g",
                Refeicoes = _refeicoesGeradas.Select(r => new RefeicaoCompletaRequest { Nome = r.Nome, HorarioSugerido = r.HorarioSugerido, Ordem = r.Ordem,
                    TotalProteina = r.TotalProteina, TotalCarboidrato = r.TotalCarboidrato, TotalGordura = r.TotalGordura, TotalFibra = r.TotalFibra, TotalCalorias = r.TotalCalorias,
                    Alimentos = r.Alimentos.Select(a => new AlimentoRequestDto { Nome = a.Nome, Quantidade = a.Quantidade, UnidadeMedida = a.UnidadeMedida,
                        Proteina = a.Proteina, Carboidrato = a.Carboidrato, Gordura = a.Gordura, Fibra = a.Fibra, Calorias = a.Calorias }).ToList() }).ToList() };
            var result = await PlanoAlimentarService.CriarCompletoAsync(req);
            if (result.Success)
                Snackbar.Add("Dieta salva! Veja em 'Minhas Dietas'.", Severity.Success);
            else
                Snackbar.Add(result.ErrorMessage, Severity.Error);
        } catch (Exception ex) { Console.WriteLine($"Erro salvar: {ex.Message}"); Snackbar.Add("Erro ao salvar dieta.", Severity.Error); }
        finally { _isSavingDieta = false; }
    }

    private async Task ExportarPdf() {
        _isExporting = true;
        try {
            var data = new { nome = $"Dieta {_nomeObjetivo}", descricao = $"Meta: {_metaCalorias:F0} kcal | P:{_metaProteina:F0}g C:{_metaCarbo:F0}g G:{_metaGordura:F0}g",
                refeicoes = _refeicoesGeradas.Select(r => new { titulo = r.Nome, alimentos = r.Alimentos.Select(a => new { label = $"{a.Nome}: ", valor = $"{a.Quantidade:F0}{a.UnidadeMedida} | P:{a.Proteina:F0}g C:{a.Carboidrato:F0}g G:{a.Gordura:F0}g ({a.Calorias:F0} kcal)" }).ToList() }).ToList() };
            var json = JsonSerializer.Serialize(data, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
            await JS.InvokeVoidAsync("exportDietaPdf", json);
        } catch (Exception ex) { Console.WriteLine($"Erro PDF: {ex.Message}"); Snackbar.Add("Erro ao exportar PDF.", Severity.Error); }
        finally { _isExporting = false; }
    }

    public class RefeicaoViewModel { public string Nome = ""; public TimeSpan? HorarioSugerido; public int Ordem; public double TotalProteina, TotalCarboidrato, TotalGordura, TotalFibra, TotalCalorias; public List<AlimentoViewModel> Alimentos = new(); }
    public class AlimentoViewModel { public string Nome = ""; public double Quantidade; public string UnidadeMedida = "g"; public double Proteina, Carboidrato, Gordura, Fibra, Calorias; }
