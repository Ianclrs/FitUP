    private Dictionary<string, ExerciseItem> GetFilteredCatalog(string focus)
    {
        if (_focusMapping.TryGetValue(focus, out var keys))
            return _exerciseCatalog.Where(kvp => keys.Contains(kvp.Key)).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
        return _exerciseCatalog;
    }

    private int ProgressPct() => (int)Math.Round((double)_step / _stepLabels.Length * 100);
    private void NextStep() { if (_step < _stepLabels.Length - 1) _step++; }
    private void PrevStep() { if (_step > 0) _step--; }

    private void ToggleLimitacao(OptionItem opt)
    {
        if (opt.Value == "Nenhuma")
        {
            _limitacoesSelecionadas = new() { "Nenhuma" };
            _outraLimitacaoDescricao = string.Empty;
            return;
        }

        _limitacoesSelecionadas.Remove("Nenhuma");

        if (_limitacoesSelecionadas.Contains(opt.Value))
        {
            _limitacoesSelecionadas.Remove(opt.Value);
            if (opt.Value == "Outra") _outraLimitacaoDescricao = string.Empty;
        }
        else
        {
            _limitacoesSelecionadas.Add(opt.Value);
        }
    }

    private WorkoutPlan ApplyLimitacoes(WorkoutPlan plan)
    {
        if (_limitacoesSelecionadas.Count == 0 || _limitacoesSelecionadas.Contains("Nenhuma"))
            return plan;

        var blockedKeys = new HashSet<string>();
        foreach (var lim in _limitacoesSelecionadas)
        {
            if (_limitacaoBloqueios.TryGetValue(lim, out var keys))
            {
                foreach (var k in keys) blockedKeys.Add(k);
            }
        }

        if (blockedKeys.Count == 0) return plan;

        var fallbackExercises = new List<ExerciseItem>
        {
            new("Abdominal Reto", 3, "15–20", "45s", "Core"),
            new("Prancha Isométrica", 3, "45–60s", "45s", "Core"),
            new("Panturrilha em Pé", 4, "15–20", "45s", "Panturrilhas"),
        };

        foreach (var split in plan.Splits)
        {
            var originalCount = split.Exercises.Count;
            split.Exercises = split.Exercises
                .Where(ex => !blockedKeys.Any(bk => ex.Name.Contains(bk, StringComparison.OrdinalIgnoreCase) || MatchesBlockedKey(ex, blockedKeys)))
                .ToList();

            if (split.Exercises.Count < 3)
            {
                foreach (var fb in fallbackExercises.Take(3 - split.Exercises.Count))
                {
                    if (!split.Exercises.Any(e => e.Name == fb.Name))
                        split.Exercises.Add(fb);
                }
            }
        }

        return plan;
    }

    private bool MatchesBlockedKey(ExerciseItem ex, HashSet<string> blockedKeys)
    {
        foreach (var kvp in _exerciseCatalog)
        {
            if (kvp.Value.Name == ex.Name && blockedKeys.Contains(kvp.Key))
                return true;
        }
        return false;
    }

    private void StartLoading()
    {
        _phase = Phase.Loading; _loadingIndex = 0;
        _loadingStepDone = new bool[_loadingSteps.Length];
        _currentLoadingLabel = _loadingSteps[0];
        _loadingTimer = new System.Timers.Timer(600);
        _loadingTimer.Elapsed += OnLoadingTick;
        _loadingTimer.Start();
    }
    private async void OnLoadingTick(object? sender, ElapsedEventArgs e)
    {
        _loadingStepDone[_loadingIndex] = true; _loadingIndex++;
        if (_loadingIndex < _loadingSteps.Length) { _currentLoadingLabel = _loadingSteps[_loadingIndex]; }
        else { _loadingTimer?.Stop(); _loadingTimer?.Dispose(); await Task.Delay(400); _phase = Phase.Result; _activeDay = 0; }
        await InvokeAsync(StateHasChanged);
    }

    private WorkoutPlan GetWorkout()
    {
        WorkoutPlan plan;

        if (_objetivo == "Hipertrofia")
        {
            var dur = _duracao ?? "";
            bool isShort = dur == "Até 30 min" || dur == "45 min";

            if (_nivel == "Iniciante")
                plan = WorkoutData.HipertrofiaFullbody;
            else if (_nivel == "Intermediário")
            {
                if (_dias == 2 || _dias == 4)
                    plan = WorkoutData.HipertrofiaAB;
                else
                    plan = WorkoutData.HipertrofiaABC;
            }
            else if (_nivel == "Avançado")
            {
                if (_dias == 2)
                    plan = WorkoutData.HipertrofiaAB;
                else if (_dias == 3)
                    plan = WorkoutData.HipertrofiaABC;
                else if (_dias == 4)
                    plan = isShort ? WorkoutData.HipertrofiaAB : WorkoutData.HipertrofiaABCD;
                else if (_dias == 5)
                    plan = WorkoutData.HipertrofiaABCD;
                else if (_dias == 6)
                    plan = isShort ? WorkoutData.HipertrofiaAB : WorkoutData.HipertrofiaABC;
                else
                    plan = WorkoutData.HipertrofiaABC;
            }
            else
            {
                plan = WorkoutData.HipertrofiaFullbody;
            }
        }
        else
        {
            plan = _objetivo switch
            {
                "Emagrecimento" => WorkoutData.Emagrecimento,
                "Força" => WorkoutData.Forca,
                "Resistência" => WorkoutData.Resistencia,
                _ => WorkoutData.HipertrofiaFullbody,
            };
        }

        return ApplyLimitacoes(plan);
    }

    private string GetDuration() => _duracao switch { "Até 30 min" => "30 min", "45 min" => "45 min", "60 min" => "60 min", "75+ min" => "75+ min", _ => "60 min", };
    private async Task SaveWorkout()
    {
        if (!AuthService.IsLoggedIn)
        {
            Snackbar.Add("Faça login para salvar seu treino.", Severity.Warning);
            return;
        }

        try
        {
            var workout = GetWorkout();
            var splits = workout.Splits.Take(Math.Min(_dias > 0 ? _dias : 3, workout.Splits.Count)).ToList();

            var request = new PlanoTreinoRequest
            {
                Nome = workout.Nome,
                Descricao = workout.Desc,
                Divisao = _dias > 0 ? _dias : 3,
                Nivel = _nivel switch { "Iniciante" => 0, "Intermediário" => 1, "Avançado" => 2, _ => 0 },
                FrequenciaSemanal = _dias > 0 ? _dias : 3,
                Dias = splits.Select((s, idx) => new DiaTreinoRequest
                {
                    Nome = s.Label,
                    Ordem = idx + 1,
                    Exercicios = s.Exercises.Select((ex, exIdx) => new ExercicioRequest
                    {
                        Nome = ex.Name,
                        Descricao = ex.Muscle,
                        Series = ex.Series,
                        Repeticoes = int.TryParse(ex.Reps.Split('–','-')[0], out var r) ? r : 10,
                        Carga = null,
                        Observacoes = $"Descanso: {ex.Rest}",
                        Ordem = exIdx + 1
                    }).ToList()
                }).ToList()
            };

            var result = await PlanoTreinoService.CriarAsync(request);
            if (result is not null)
            {
                Snackbar.Add("Treino salvo com sucesso! Acesse 'Treinos Salvos' no menu do usuário.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Erro ao salvar o treino. Verifique sua conexão.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar: {ex.Message}", Severity.Error);
        }
    }
    private async Task ExportPdf()
    {
        if (_isExportingPdf) return;
        _isExportingPdf = true;
        try
        {
            var workout = GetWorkout();
            var splits = workout.Splits.Take(Math.Min(_dias > 0 ? _dias : 3, workout.Splits.Count)).ToList();

            var pdfData = new
            {
                nome = workout.Nome,
                desc = workout.Desc,
                nivel = _nivel,
                local = _local,
                duracao = GetDuration(),
                diasSemana = _dias > 0 ? _dias : 3,
                splits = splits.Select(s => new
                {
                    label = s.Label,
                    focus = s.Focus,
                    exercicios = s.Exercises.Select(ex => new
                    {
                        name = ex.Name,
                        muscle = ex.Muscle,
                        series = ex.Series,
                        reps = ex.Reps,
                        rest = ex.Rest
                    }).ToList()
                }).ToList()
            };

            var options = new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            };

            var json = JsonSerializer.Serialize(pdfData, options);
            await JS.InvokeVoidAsync("exportFitUpPdf", json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao exportar PDF: {ex}");
            Snackbar.Add("Erro ao exportar PDF. Tente novamente.", Severity.Error);
        }
        finally
        {
            _isExportingPdf = false;
        }
    }

    private void StartExerciseEdit(int index)
    {
        _editingExerciseDay = _activeDay; _editingExerciseIndex = index;
        var workout = GetWorkout();
        var splits = workout.Splits.Take(Math.Min(_dias > 0 ? _dias : 3, workout.Splits.Count)).ToList();
        var split = splits.ElementAtOrDefault(_activeDay) ?? splits.First();
        var ex = split.Exercises[index];
        var match = _exerciseCatalog.Where(kvp => kvp.Value.Name == ex.Name).Select(kvp => kvp.Key).FirstOrDefault();
        _selectedEditExerciseKey = match ?? string.Empty;
        _editSeries = ex.Series; _editReps = ex.Reps; _editRest = ex.Rest;
    }
    private void SaveExerciseEdit(int index)
    {
        var workout = GetWorkout();
        var splits = workout.Splits.Take(Math.Min(_dias > 0 ? _dias : 3, workout.Splits.Count)).ToList();
        var split = splits.ElementAtOrDefault(_activeDay) ?? splits.First();
        var ex = split.Exercises[index];
        if (!string.IsNullOrWhiteSpace(_selectedEditExerciseKey) && _exerciseCatalog.TryGetValue(_selectedEditExerciseKey, out var sel)) { ex.Name = sel.Name; ex.Muscle = sel.Muscle; }
        ex.Series = _editSeries; ex.Reps = _editReps; ex.Rest = _editRest;
        CancelExerciseEdit();
    }
    private void CancelExerciseEdit() { _editingExerciseDay = -1; _editingExerciseIndex = -1; _selectedEditExerciseKey = string.Empty; }
    private void ResetAll() { _phase = Phase.Quiz; _step = 0; _objetivo = null; _nivel = null; _dias = 0; _duracao = null; _local = null; _limitacoesSelecionadas = new(); _outraLimitacaoDescricao = string.Empty; _activeDay = 0; CancelExerciseEdit(); }
    public void Dispose() { _loadingTimer?.Stop(); _loadingTimer?.Dispose(); }

