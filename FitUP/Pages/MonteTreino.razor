@page "/MonteTreino"
@using System.Collections.Generic
@using System.Timers
@using System.Text.Json
@using System.Text.Json.Serialization
@using FitUP.Services
@inject IJSRuntime JS
@inject AuthService AuthService
@inject PlanoTreinoService PlanoTreinoService
@inject ISnackbar Snackbar

<PageTitle>Monte o Seu Treino</PageTitle>

<style>
    :root {
        --fitup-orange: #FF7A2F;
        --fitup-orange-hover: #FF9559;
        --fitup-orange-alpha: rgba(255, 122, 47, 0.12);
        --fitup-orange-glow: 0 0 22px rgba(255, 122, 47, 0.30);
        --fitup-orange-glow-sm: 0 0 14px rgba(255, 122, 47, 0.22);
    }

    .step-card {
        background-color: var(--mud-palette-surface) !important;
        border: 1.5px solid var(--mud-palette-surface) !important;
        border-radius: 6px !important;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s !important;
    }

        .step-card:hover {
            border-color: var(--fitup-orange) !important;
            box-shadow: var(--fitup-orange-glow);
            transform: translateY(-2px);
        }

    .option-card-selected {
        border-color: var(--fitup-orange) !important;
        background-color: var(--fitup-orange-alpha) !important;
    }

    .pill-option {
        background-color: var(--mud-palette-surface) !important;
        border: 1.5px solid var(--mud-palette-surface) !important;
        border-radius: 6px !important;
        color: var(--mud-palette-text-primary) !important;
        transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
        cursor: pointer;
        padding: 8px 20px;
        font-size: 15px;
    }

        .pill-option:hover {
            border-color: var(--fitup-orange) !important;
            box-shadow: 0 0 16px rgba(255, 122, 47, 0.28);
        }

    .pill-selected {
        border-color: var(--fitup-orange) !important;
        background-color: var(--fitup-orange-alpha) !important;
        color: var(--fitup-orange) !important;
        font-weight: 500;
    }

    .day-btn {
        background-color: var(--mud-palette-surface) !important;
        border: 1.5px solid var(--mud-palette-surface) !important;
        border-radius: 6px !important;
        color: var(--mud-palette-text-secondary) !important;
        font-size: 16px;
        font-weight: 700;
        transition: all 0.2s, box-shadow 0.2s;
        cursor: pointer;
        min-width: 52px;
        height: 52px;
    }

        .day-btn:hover {
            border-color: var(--fitup-orange) !important;
            box-shadow: var(--fitup-orange-glow-sm);
            color: var(--mud-palette-text-primary) !important;
        }

    .day-btn-selected {
        border-color: var(--fitup-orange) !important;
        background-color: var(--fitup-orange-alpha) !important;
        color: var(--fitup-orange) !important;
    }

    .progress-track {
        background-color: var(--mud-palette-surface);
        border-radius: 6px;
        height: 3px;
        overflow: hidden;
    }

    .progress-fill {
        height: 3px;
        background-color: var(--fitup-orange);
        border-radius: 6px;
        transition: width 0.5s cubic-bezier(.4,0,.2,1);
    }

    .exercise-card {
        background-color: var(--mud-palette-surface) !important;
        border: 1.5px solid var(--mud-palette-surface) !important;
        border-radius: 6px !important;
    }

        .exercise-card:hover {
            border-color: var(--fitup-orange) !important;
        }

    .ex-num {
        width: 52px;
        height: 32px;
        border-radius: 50%;
        background-color: var(--fitup-orange-alpha);
        color: var(--fitup-orange);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 500;
        flex-shrink: 0;
    }

    .tag-highlight {
        background-color: var(--fitup-orange-alpha);
        border: 1px solid var(--fitup-orange);
        color: var(--fitup-orange);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .tag-neutral {
        background-color: var(--fitup-orange-alpha);
        border: 1px solid var(--fitup-orange);
        color: var(--mud-palette-text-primary);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 12px;
    }

    .stat-card {
        background-color: var(--mud-palette-surface) !important;
        border: 1.5px solid var(--mud-palette-surface) !important;
        border-radius: 6px !important;
        text-align: center;
        padding: 14px 10px;
    }

    .day-tab {
        background-color: var(--mud-palette-surface);
        border: 1.5px solid var(--mud-palette-surface);
        border-radius: 6px;
        padding: 6px 18px;
        font-size: 13px;
        color: var(--mud-palette-text-primary);
        cursor: pointer;
        transition: all 0.2s, box-shadow 0.2s;
    }

        .day-tab:hover {
            border-color: var(--fitup-orange);
            box-shadow: 0 0 12px rgba(255, 122, 47, 0.22);
            color: var(--mud-palette-text-primary);
        }

    .day-tab-active {
        border-color: var(--fitup-orange);
        color: var(--fitup-orange);
        background-color: var(--fitup-orange-alpha);
    }

    .btn-primary-fitup {
        background-color: var(--fitup-orange) !important;
        color: #FFFFFF !important;
        border-radius: 6px !important;
        border: none !important;
        font-weight: 500 !important;
        transition: background-color 0.2s, transform 0.15s !important;
    }

        .btn-primary-fitup:hover {
            background-color: var(--fitup-orange-hover) !important;
        }

        .btn-primary-fitup:active {
            transform: scale(0.98);
        }

        .btn-primary-fitup[disabled], .btn-primary-fitup.mud-button-disabled {
            color: #FFFFFF !important;
            opacity: 0.7 !important;
            cursor: not-allowed;
        }

    .btn-secondary-fitup, .btn-voltar-fitup {
        background-color: var(--mud-palette-surface) !important;
        color: var(--mud-palette-text-primary) !important;
        border: 1.5px solid var(--mud-palette-surface) !important;
        border-radius: 6px !important;
        font-weight: 500 !important;
        transition: all 0.2s, box-shadow 0.2s !important;
    }

        .btn-secondary-fitup:hover, .btn-voltar-fitup:hover {
            border-color: var(--fitup-orange) !important;
            box-shadow: var(--fitup-orange-glow-sm);
        }

    .skeleton-card {
        background-color: var(--mud-palette-surface);
        border: 1.5px solid var(--fitup-orange);
        border-radius: 8px;
        padding: 18px;
    }
    .skeleton-shimmer {
        background: linear-gradient(90deg, rgba(127,127,127,0.08) 0%, rgba(127,127,127,0.22) 40%, rgba(127,127,127,0.08) 80%);
        background-size: 200% 100%;
        animation: shimmer 1.8s ease-in-out infinite;
        border-radius: 4px;
    }
    @@keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
    .sk-header { height: 13px; width: 65%; margin-bottom: 6px; }
    .sk-header-sm { height: 10px; width: 40%; }
    .sk-stat { height: 52px; border-radius: 6px; }
    .sk-exercise { height: 48px; border-radius: 6px; margin-bottom: 6px; }
    .sk-focus { height: 24px; width: 45%; border-radius: 6px; margin-bottom: 14px; }
    .sk-daytab { height: 28px; width: 65px; border-radius: 6px; display: inline-block; margin-right: 6px; margin-bottom: 12px; }
    .loading-step-row {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        transition: color 0.3s;
    }
    .loading-pending { color: var(--mud-palette-text-disabled); }
    .loading-active { color: var(--fitup-orange); font-weight: 500; }
    .loading-done { color: var(--mud-palette-text-primary); }
    .loading-progress-bar {
        width: 100%;
        height: 4px;
        background-color: var(--mud-palette-divider);
        border-radius: 6px;
        overflow: hidden;
        margin-top: 12px;
    }
    .loading-progress-fill {
        height: 4px;
        background-color: var(--fitup-orange);
        border-radius: 6px;
        transition: width 0.5s cubic-bezier(.4,0,.2,1);
    }
    .spinner-ring {
        width: 52px;
        height: 52px;
        border: 3px solid var(--mud-palette-divider);
        border-top-color: var(--fitup-orange);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .loading-step-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: var(--mud-palette-text-disabled);
        transition: color 0.3s;
    }

    .loading-step-done {
        color: var(--mud-palette-text-primary) !important;
    }

    .ls-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: var(--mud-palette-divider);
        flex-shrink: 0;
        transition: background-color 0.3s;
    }

    .ls-dot-done {
        background-color: var(--fitup-orange) !important;
    }

    .limitation-warning {
        background-color: var(--mud-palette-surface);
        border: 1.5px solid var(--fitup-orange);
        border-radius: 6px;
        padding: 12px 16px;
        font-size: 13px;
        color: var(--mud-palette-text-primary);
    }

    .step-badge {
        font-size: 13px;
        color: var(--fitup-orange);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .fitup-textarea {
        background-color: var(--mud-palette-surface) !important;
        border: 1.5px solid var(--mud-palette-divider) !important;
        border-radius: 6px !important;
        color: var(--mud-palette-text-primary) !important;
        font-family: inherit;
        resize: none;
        outline: none;
        transition: border-color 0.2s;
        width: 100%;
        padding: 14px;
        font-size: 14px;
        line-height: 1.6;
    }

        .fitup-textarea:focus {
            border-color: var(--fitup-orange) !important;
        }

        .fitup-textarea::placeholder {
            color: var(--mud-palette-text-disabled);
        }

    .edit-exercise-overlay {
        background-color: var(--mud-palette-surface);
        border: 1.5px solid var(--fitup-orange);
        border-radius: 6px;
        padding: 16px;
        margin-top: 8px;
        margin-bottom: 8px;
    }

    .edit-input {
        background-color: var(--mud-palette-surface) !important;
        border: 1.5px solid var(--mud-palette-surface) !important;
        border-radius: 6px !important;
        color: var(--mud-palette-text-primary) !important;
        padding: 8px 12px;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
    }

        .edit-input:focus {
            border-color: var(--fitup-orange) !important;
        }

    .btn-edit-fitup {
        background-color: transparent !important;
        border: 1.5px solid var(--fitup-orange) !important;
        color: var(--fitup-orange) !important;
        border-radius: 6px !important;
        font-size: 12px !important;
        padding: 4px 14px !important;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

        .btn-edit-fitup:hover {
            background-color: var(--fitup-orange-alpha) !important;
            box-shadow: 0 0 10px rgba(255, 122, 47, 0.18);
        }

    .pular-link {
        background-color: var(--mud-palette-surface) !important;
        color: var(--mud-palette-text-primary) !important;
        border: 1.5px solid var(--mud-palette-surface) !important;
        border-radius: 6px !important;
        font-weight: 500 !important;
        transition: all 0.2s, box-shadow 0.2s !important;
    }

        .pular-link:hover {
            color: var(--fitup-orange) !important;
        }

    .result-header-card {
        background: linear-gradient(135deg, var(--fitup-orange-alpha) 0%, var(--mud-palette-surface) 60%);
        border: 1.5px solid var(--fitup-orange);
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 14px;
    }

    .focus-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: var(--fitup-orange-alpha);
        border: 1px solid var(--fitup-orange);
        border-radius: 6px;
        padding: 6px 14px;
        font-size: 13px;
        color: var(--fitup-orange);
        font-weight: 500;
    }

    @@media (max-width: 400px) {
        .step-labels-row {
            flex-wrap: wrap !important;
            gap: 6px !important;
            justify-content: center !important;
        }

            .step-labels-row .mud-typography-body2 {
                font-size: 11px !important;
            }

        .days-row {
            flex-wrap: wrap !important;
            gap: 6px !important;
            justify-content: center !important;
        }

        .result-actions-row {
            flex-wrap: wrap !important;
        }

            .result-actions-row .mud-button-root {
                font-size: 12px !important;
                padding: 6px 10px !important;
            }

        .result-header-card .mud-typography-h5 {
            font-size: 1.1rem !important;
        }
    }
</style>

<div>
    <MudContainer MaxWidth="MaxWidth.Small" Class="py-8">

        @if (_phase == Phase.Quiz)
        {
            <div class="mb-8">
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2 step-labels-row">
                    @for (int i = 0; i < _stepLabels.Length; i++)
                    {
                        
                        int idx = i;
                        @if (idx == _step)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Inherit" Style="font-weight:700">
                                <span style="color:var(--fitup-orange)">@_stepLabels[idx]</span>
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Inherit">@_stepLabels[idx]</MudText>
                        }
                    }
                </MudStack>
                <div class="progress-track">
                    <div class="progress-fill" style="width:@(ProgressPct())%"></div>
                </div>
            </div>

            @if (_step == 0)
            {
                <div class="step-badge">Etapa 1 de 6</div>
                <MudText Typo="Typo.h5" Color="Color.Inherit" Style="font-weight:500;margin-bottom:6px;">Qual é o seu objetivo principal?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Inherit" Style="margin-bottom:24px;">Vamos personalizar cada detalhe do seu treino.</MudText>
                <MudGrid Spacing="3">
                    @foreach (var opt in _objetivoOptions)
                    {
                        var o = opt;
                        <MudItem xs="6">
                            <div class="step-card @((_objetivo == o.Value) ? "option-card-selected" : "")" style="padding:18px;cursor:pointer;" @onclick="() => _objetivo = o.Value">
                                <MudIcon Icon="@o.Icon" Style="color:var(--fitup-orange);font-size:26px;margin-bottom:8px;" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Inherit" Style="font-weight:500;">@o.Value</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Inherit" Style="margin-top:3px;">@o.Desc</MudText>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
                <MudStack Row="true" Class="mt-6" Spacing="2">
                    <MudButton FullWidth="true" Class="btn-primary-fitup" Size="Size.Large" Disabled="@(_objetivo == null)" OnClick="NextStep">
                        <MudText Style="font-weight:bolder">
                            Continuar
                        </MudText>
                    </MudButton>
                </MudStack>
            }

            @if (_step == 1)
            {
                <div class="step-badge">Etapa 2 de 6</div>
                <MudText Typo="Typo.h5" Color="Color.Inherit" Style="font-weight:500;margin-bottom:6px;">Qual é o seu nível de experiência?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Inherit" Style="margin-bottom:24px;">Isso define a intensidade e complexidade dos exercícios.</MudText>
                <MudGrid Spacing="3">
                    @foreach (var opt in _nivelOptions)
                    {
                        var o = opt;
                        <MudItem xs="6">
                            <div class="step-card @((_nivel == o.Value) ? "option-card-selected" : "")" style="padding:18px;cursor:pointer;" @onclick="() => _nivel = o.Value">
                                <MudIcon Icon="@o.Icon" Style="color:var(--fitup-orange);font-size:26px;margin-bottom:8px;" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Inherit" Style="font-weight:500;">@o.Value</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Inherit" Style="margin-top:3px;">@o.Desc</MudText>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
                <MudStack Row="true" Class="mt-6" Spacing="2">
                    <MudButton Class="btn-voltar-fitup" Size="Size.Large" OnClick="PrevStep">
                        <MudText Style="font-weight:bold">
                            Voltar
                        </MudText>
                    </MudButton>
                    <MudButton FullWidth="true" Class="btn-primary-fitup" Size="Size.Large" Disabled="@(_nivel == null)" OnClick="NextStep">
                        <MudText Style="font-weight:bolder">
                            Continuar
                        </MudText>
                    </MudButton>
                </MudStack>
            }

            @if (_step == 2)
            {
                <div class="step-badge">Etapa 3 de 6</div>
                <MudText Typo="Typo.h5" Color="Color.Inherit" Style="font-weight:500;margin-bottom:6px;">Quantos dias por semana você treina?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Inherit" Style="margin-bottom:24px;">Montaremos a divisão semanal perfeita para você.</MudText>
                <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="days-row">
                    @foreach (var d in new[] { 2, 3, 4, 5, 6 })
                    {
                        int day = d;
                        <div class="day-btn @((_dias == day) ? "day-btn-selected" : "")" style="display:flex;align-items:center;justify-content:center;" @onclick="() => _dias = day">@day@("x")</div>
                    }
                </MudStack>
                <MudStack Row="true" Class="mt-6" Spacing="2">
                    <MudButton Class="btn-voltar-fitup" Size="Size.Large" OnClick="PrevStep">
                        <MudText Style="font-weight:bold">
                            Voltar
                        </MudText>
                    </MudButton>
                    <MudButton FullWidth="true" Class="btn-primary-fitup" Size="Size.Large" Disabled="@(_dias == 0)" OnClick="NextStep">
                        <MudText Style="font-weight:bolder">
                            Continuar
                        </MudText>
                    </MudButton>
                </MudStack>
            }

            @if (_step == 3)
            {
                <div class="step-badge">Etapa 4 de 6</div>
                <MudText Typo="Typo.h5" Color="Color.Inherit" Style="font-weight:500;margin-bottom:6px;">Quanto tempo você tem por treino?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Inherit" Style="margin-bottom:24px;">Otimizaremos o volume e a densidade do treino.</MudText>
                <MudStack Row="true" Spacing="2" Style="flex-wrap:wrap;">
                    @foreach (var dur in _duracaoOptions)
                    {
                        var d = dur;
                        <div class="pill-option @((_duracao == d) ? "pill-selected" : "")" @onclick="() => _duracao = d">@d</div>
                    }
                </MudStack>
                <MudStack Row="true" Class="mt-6" Spacing="2">
                    <MudButton Class="btn-voltar-fitup" Size="Size.Large" OnClick="PrevStep">
                        <MudText Style="font-weight:bold">
                            Voltar
                        </MudText>
                    </MudButton>
                    <MudButton FullWidth="true" Class="btn-primary-fitup" Size="Size.Large" Disabled="@(_duracao == null)" OnClick="NextStep">
                        <MudText Style="font-weight:bolder">
                            Continuar
                        </MudText>
                    </MudButton>
                </MudStack>
            }

            @if (_step == 4)
            {
                <div class="step-badge">Etapa 5 de 6</div>
                <MudText Typo="Typo.h5" Color="Color.Inherit" Style="font-weight:500;margin-bottom:6px;">Onde você vai treinar?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Inherit" Style="margin-bottom:24px;">Selecionaremos exercícios disponíveis para o seu ambiente.</MudText>
                <MudGrid Spacing="3">
                    @foreach (var opt in _localOptions)
                    {
                        var o = opt;
                        <MudItem xs="6">
                            <div class="step-card @((_local == o.Value) ? "option-card-selected" : "")" style="padding:18px;cursor:pointer;" @onclick="() => _local = o.Value">
                                <MudIcon Icon="@o.Icon" Style="color:var(--fitup-orange);font-size:26px;margin-bottom:8px;" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Inherit" Style="font-weight:500;">@o.Value</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Inherit" Style="margin-top:3px;">@o.Desc</MudText>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
                <MudStack Row="true" Class="mt-6" Spacing="2">
                    <MudButton Class="btn-voltar-fitup" Size="Size.Large" OnClick="PrevStep">
                        <MudText Style="font-weight:bold">
                            Voltar
                        </MudText>
                    </MudButton>
                    <MudButton FullWidth="true" Class="btn-primary-fitup" Size="Size.Large" Disabled="@(_local == null)" OnClick="NextStep">
                        <MudText Style="font-weight:bolder">
                            Continuar
                        </MudText>
                    </MudButton>
                </MudStack>
            }

            @if (_step == 5)
            {
                <div class="step-badge">Etapa 6 de 6</div>
                <MudText Typo="Typo.h5" Color="Color.Inherit" Style="font-weight:500;margin-bottom:6px;">Você tem alguma limitação física?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Inherit" Style="margin-bottom:24px;">Selecione as regiões com restrições — os exercícios serão ajustados automaticamente. Esta etapa é opcional.</MudText>
                <MudGrid Spacing="3">
                    @foreach (var opt in _limitacaoOptions)
                    {
                        var o = opt;
                        bool isSelected = _limitacoesSelecionadas.Contains(o.Value);
                        <MudItem xs="6">
                            <div class="step-card @(isSelected ? "option-card-selected" : "")" style="padding:18px;cursor:pointer;" @onclick="() => ToggleLimitacao(o)">
                                <MudIcon Icon="@o.Icon" Style="color:var(--fitup-orange);font-size:26px;margin-bottom:8px;" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Inherit" Style="font-weight:500;">@o.Value</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Inherit" Style="margin-top:3px;">@o.Desc</MudText>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
                @if (_limitacoesSelecionadas.Contains("Outra"))
                {
                    <MudTextField @bind-Value="_outraLimitacaoDescricao"  Label="Descreva brevemente sua limitação" Variant="Variant.Text" Class="mt-4" Style="width:100%;--mud-palette-primary:coral" />
                }
                <MudStack Row="true" Class="mt-6" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Class="btn-voltar-fitup" Size="Size.Large" OnClick="PrevStep">
                        <MudText Style="font-weight:bold">
                            Voltar
                        </MudText>
                    </MudButton>
                    <MudButton FullWidth="true" Class="btn-primary-fitup" Size="Size.Large" OnClick="StartLoading">
                        <MudText Style="font-weight:bolder">
                            Gerar Treino
                        </MudText>
                    </MudButton>
                </MudStack>
            }
        }

        @if (_phase == Phase.Loading)
        {
            <MudText Typo="Typo.caption" Style="color:var(--fitup-orange);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;">Gerando protocolo de treino</MudText>
            <div class="skeleton-card">
                <div class="skeleton-shimmer sk-header"></div>
                <div class="skeleton-shimmer sk-header-sm" style="margin-bottom:14px;"></div>
                <MudGrid Spacing="2" Class="mb-4">
                    <MudItem xs="4"><div class="skeleton-shimmer sk-stat"></div></MudItem>
                    <MudItem xs="4"><div class="skeleton-shimmer sk-stat"></div></MudItem>
                    <MudItem xs="4"><div class="skeleton-shimmer sk-stat"></div></MudItem>
                </MudGrid>
                <div style="margin-bottom:6px;">
                    <div class="skeleton-shimmer sk-daytab"></div>
                    <div class="skeleton-shimmer sk-daytab"></div>
                    <div class="skeleton-shimmer sk-daytab"></div>
                </div>
                <div class="skeleton-shimmer sk-focus"></div>
                <div class="skeleton-shimmer sk-exercise"></div>
                <div class="skeleton-shimmer sk-exercise"></div>
                <div class="skeleton-shimmer sk-exercise"></div>
                <div class="skeleton-shimmer sk-exercise"></div>
            </div>
            <MudStack Spacing="1" Class="mt-4">
                @for (int i = 0; i < _loadingSteps.Length; i++)
                {
                    int idx = i;
                    string colorClass = "loading-pending";
                    string icon = Icons.Material.Outlined.Circle;
                    if (_loadingStepDone[idx])
                    {
                        colorClass = "loading-done";
                        icon = Icons.Material.Outlined.CheckCircle;
                    }
                    else if (idx == 0 || _loadingStepDone[idx - 1])
                    {
                        colorClass = "loading-active";
                        icon = Icons.Material.Outlined.RadioButtonChecked;
                    }
                    <div class="loading-step-row @colorClass">
                        <MudIcon Icon="@icon" Size="Size.Small" Style="font-size:16px;flex-shrink:0;" />
                        <span>@_loadingSteps[idx]</span>
                    </div>
                }
            </MudStack>
            <div class="loading-progress-bar">
                <div class="loading-progress-fill" style="width:@((int)Math.Round((double)(_loadingIndex + 1) / _loadingSteps.Length * 100))%"></div>
            </div>
        }

        @if (_phase == Phase.Result)
        {
            var workout = GetWorkout();
            var splits = workout.Splits.Take(Math.Min(_dias > 0 ? _dias : 3, workout.Splits.Count)).ToList();
            var currentSplit = splits.ElementAtOrDefault(_activeDay) ?? splits.First();
            int totalSeries = splits.SelectMany(s => s.Exercises).Sum(e => e.Series);

            <div class="result-header-card">
                <MudText Typo="Typo.caption" Style="color:var(--fitup-orange);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;">Treino gerado com sucesso</MudText>
                <MudText Typo="Typo.h5" Color="Color.Inherit" Style="font-weight:500;margin-bottom:2px;">@workout.Nome</MudText>
                <MudText Typo="Typo.body2" Color="Color.Inherit">@workout.Desc · @_nivel · @_local</MudText>
            </div>

            @if (_nivel == "Iniciante")
            {
                <div class="limitation-warning mb-4" style="border-color:var(--fitup-orange);background-color:var(--fitup-orange-alpha);">
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        <span style="color:var(--fitup-orange);font-size:18px;">&#128197;</span>
                        <strong Style="font-weight:500;color:var(--fitup-orange);">
                            Lembrete:
                        </strong>
                        <span> Este treino foi pensado para se adaptar ao longo de <strong>1 mês</strong>. Conforme seu corpo evolui, aumente gradualmente as cargas e repetições para continuar progredindo. Após 30 dias, volte aqui e gere um novo treino para o próximo ciclo!</span>
                    </MudText>
                </div>
            }

            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="4"><div class="stat-card"><MudText Typo="Typo.h6" Style="color:var(--fitup-orange);font-weight:500;">@(_dias)x</MudText><MudText Typo="Typo.subtitle2" Color="Color.Inherit">por semana</MudText></div></MudItem>
                <MudItem xs="4"><div class="stat-card"><MudText Typo="Typo.h6" Style="color:var(--fitup-orange);font-weight:500;">@totalSeries</MudText><MudText Typo="Typo.subtitle2" Color="Color.Inherit">séries totais</MudText></div></MudItem>
                <MudItem xs="4"><div class="stat-card"><MudText Typo="Typo.h6" Style="color:var(--fitup-orange);font-weight:500;">@GetDuration()</MudText><MudText Typo="Typo.subtitle2" Color="Color.Inherit">por sessão</MudText></div></MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="1" Class="mb-4" Style="flex-wrap:wrap;">
                @for (int i = 0; i < splits.Count; i++)
                {
                    int idx = i;
                    <div class="day-tab @((_activeDay == idx) ? "day-tab-active" : "")" @onclick="() => _activeDay = idx">@splits[idx].Label</div>
                }
            </MudStack>

            <div class="focus-badge mb-4">
                <MudIcon Icon="@Icons.Material.Outlined.TrackChanges" Style="font-size:16px;" />
                <span>@currentSplit.Focus</span>
            </div>

            @for (int i = 0; i < currentSplit.Exercises.Count; i++)
            {
                var ex = currentSplit.Exercises[i];
                int num = i + 1;
                int exIndex = i;

                @if (_editingExerciseDay == _activeDay && _editingExerciseIndex == exIndex)
                {
                    var filteredCatalog = GetFilteredCatalog(currentSplit.Focus);
                    <div class="edit-exercise-overlay">
                        <MudText Typo="Typo.subtitle2" Style="color:var(--fitup-orange);font-weight:500;margin-bottom:14px;">Alterar Exercício @num</MudText>
                        <MudStack Spacing="3">
                            <MudSelect Label="Selecione o Exercício" Variant="Variant.Outlined"
                                       @bind-Value="_selectedEditExerciseKey" AnchorOrigin="Origin.BottomCenter" Class="rounded-xl"
                                       ToStringFunc="@(key => filteredCatalog.TryGetValue(key, out var exRef) ? exRef.Name : key)">
                                @foreach (var kvp in filteredCatalog)
                                {
                                    <MudSelectItem Value="@kvp.Key">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.body2" Color="Color.Inherit">@kvp.Value.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Inherit">— @kvp.Value.Muscle</MudText>
                                        </MudStack>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <div style="display:flex;gap:8px;">
                                <MudNumericField Label="Séries" Variant="Variant.Outlined" @bind-Value="_editSeries" Min="1" Max="10" Style="flex:1;" />
                                <MudTextField Label="Repetições" Variant="Variant.Outlined" @bind-Value="_editReps" Style="flex:1;" />
                                <MudTextField Label="Descanso" Variant="Variant.Outlined" @bind-Value="_editRest" Style="flex:1;" />
                            </div>
                        </MudStack>
                        <MudStack Row="true" Spacing="2" Class="mt-4">
                            <MudButton FullWidth="true" Class="btn-primary-fitup" Size="Size.Small" OnClick="() => SaveExerciseEdit(exIndex)">
                                <MudText Style="font-weight:bold">
                                    Salvar
                                </MudText>
                            </MudButton>
                            <MudButton FullWidth="true" Class="btn-voltar-fitup" Size="Size.Small" OnClick="CancelExerciseEdit">
                                <MudText Style="font-weight:bold">
                                    Cancelar
                                </MudText>
                            </MudButton>
                        </MudStack>
                    </div>
                }
                else
                {
                    <div class="exercise-card mb-3" style="padding:16px;">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                            <div class="ex-num">@num</div>
                            <div style="flex:1;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Inherit" Style="font-weight:500;margin-bottom:3px;font-weight:bold">@ex.Name</MudText>
                                <MudText Typo="Typo.subtitle2" Color="Color.Inherit" Style="margin-bottom:8px;font-weight:lighter">@ex.Muscle</MudText>
                                <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap;">
                                    <span class="tag-highlight">@ex.Series séries</span>
                                    <span class="tag-highlight">@ex.Reps reps</span>
                                    <span class="tag-neutral">&#9201; @ex.Rest descanso</span>
                                </MudStack>
                            </div>
                            <button class="btn-edit-fitup" @onclick="() => StartExerciseEdit(exIndex)">Alterar</button>
                        </MudStack>
                    </div>
                }
            }

            <MudStack Row="true" Spacing="2" Class="mt-6 result-actions-row" Style="flex-wrap:wrap;">
                <MudButton Class="btn-secondary-fitup" Size="Size.Medium" StartIcon="@Icons.Material.Outlined.Bookmark" OnClick="SaveWorkout">
                    <MudText Style="font-weight:bold">
                        Salvar
                    </MudText>
                </MudButton>
                <MudButton Class="btn-secondary-fitup" Size="Size.Medium" StartIcon="@Icons.Material.Outlined.FileDownload" OnClick="ExportPdf">
                    <MudText Style="font-weight:bold">
                        Exportar PDF
                    </MudText>
                </MudButton>
                <MudButton FullWidth="true" Class="btn-primary-fitup" Size="Size.Medium" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="ResetAll">
                    <MudText Style="font-weight:bold">
                        Novo Treino
                    </MudText>
                </MudButton>
            </MudStack>

            @if (_limitacoesSelecionadas.Count > 0 && !_limitacoesSelecionadas.Contains("Nenhuma"))
            {
                <div class="limitation-warning mt-4">
                    <MudText Typo="Typo.caption" Color="Color.Inherit">
                        <span style="color:var(--fitup-orange);">&#9888;</span>
                        <strong Style="font-weight:500;"> Limitações consideradas:</strong>
                        <span> @string.Join(", ", _limitacoesSelecionadas.Where(l => l != "Outra"))</span>
                        @if (_limitacoesSelecionadas.Contains("Outra") && !string.IsNullOrWhiteSpace(_outraLimitacaoDescricao))
                        {
                            <span> (@_outraLimitacaoDescricao)</span>
                        }
                    </MudText>
                </div>
            }
        }

    </MudContainer>
</div>

@code {
    private Phase _phase = Phase.Quiz;
    private int _step;
    private string? _objetivo;
    private string? _nivel;
    private int _dias;
    private string? _duracao;
