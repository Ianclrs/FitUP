@page "/CalculadoraBio"
<PageTitle>Calculadora Corporal</PageTitle>

<style>
    .scale-hover:hover {
        transform: scale(1.02);
        transition: transform 0.2s ease-in-out;
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 animate-fade-in">
    <MudGrid>
        <!-- Formulário de Entrada de Dados -->
        <MudItem xs="12" md="6">
            <MudCard Style="border: 2px solid coral;" Elevation="3" Class="pa-7 rounded-xl">
                <div class="d-flex align-center mb-4">
                    <MudIconButton Style="color:coral" Icon="@Icons.Material.Filled.ArrowBackIosNew" Href="/GanhoMaximo" Size="Size.Small" />
                    <MudText Typo="Typo.h6" Class="ms-2" Style="color:coral; font-weight:bold">Dados da Bioimpedância</MudText>
                </div>

                <MudCardContent>
                    <MudForm @ref="form">
                        <MudRadioGroup @bind-Value="Model.Sexo" Class="mb-4">
                            <MudRadio Value='"M"' Color="Color.Inherit">Masculino</MudRadio>
                            <MudRadio Value='"F"' Color="Color.Inherit">Feminino</MudRadio>
                        </MudRadioGroup>

                        <MudNumericField @bind-Value="Model.Peso" Label="Peso Atual (kg)" Variant="Variant.Text"
                                         Format="F2" Step="0.1" Required="true" RequiredError="O peso é obrigatório."
                                         Validation="@(new Func<double?, string?>(ValidationPeso))" Class="mb-3" />

                        <MudNumericField @bind-Value="Model.Altura" Label="Altura (cm)" Variant="Variant.Text"
                                         Step="1" Required="true" RequiredError="A altura é obrigatória."
                                         Validation="@(new Func<double?, string?>(ValidationAltura))" Class="mb-3" />

                        <MudNumericField @bind-Value="Model.Idade" Label="Idade (anos)" Variant="Variant.Text"
                                         Step="1" Required="true" RequiredError="A idade é obrigatória."
                                         Validation="@(new Func<int?, string?>(ValidationIdade))" Class="mb-3" />

                        <MudNumericField @bind-Value="Model.PercentualGordura" Label="Percentual de Gordura (%)"
                                         Variant="Variant.Text" Format="F1" Step="0.1" Required="true" RequiredError="O percentual de gordura é obrigatório."
                                         Validation="@(new Func<double?, string?>(ValidationGordura))" Class="mb-4" />

                        <MudSelect @bind-Value="Model.NivelAtividade" Label="Nível de Atividade Física" Variant="Variant.Text" Class="mb-4">
                            <MudSelectItem Style="color:inherit!important" Value="@("Sedentario")"><strong>Sedentário</strong> (Pouco ou nenhum exercício)</MudSelectItem>
                            <MudSelectItem Style="color:inherit!important" Value="@("Leve")"><strong>Levemente Ativo</strong> (Exercício leve 1-3 dias/semana)</MudSelectItem>
                            <MudSelectItem Style="color:inherit!important" Value="@("Moderado")"><strong>Moderadamente Ativo</strong> (Exercício moderado 3-5 dias/semana)</MudSelectItem>
                            <MudSelectItem Style="color:inherit!important" Value="@("Intenso")"><strong>Altamente Ativo</strong> (Exercício intenso 6-7 dias/semana)</MudSelectItem>
                            <MudSelectItem Style="color:inherit!important" Value="@("Extremo")"><strong>Extremamente Ativo</strong> (Treino diário pesado / Trabalho braçal)</MudSelectItem>
                        </MudSelect>
                    </MudForm>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Class="scale-hover" Variant="Variant.Filled"
                               Style="background-color:coral; color:white; font-weight:bold" FullWidth="true" OnClick="Calcular">
                        Calcular Resultados
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Painel de Resultados -->
        <MudItem xs="12" md="6">
            @if (ResultadoCalculado)
            {
                <MudCard Elevation="0" Class="pa-4" Style="height: 100%; background-color: var(--mud-palette-background-grey);">

                    <MudCardContent>

                        <MudPaper Class="mb-4" Style="border: 2px solid coral; height:35px">
                            <MudText Typo="Typo.h5" Class="mb-4 ms-2 font-weight-bold text-center"><strong>Resultados:</strong></MudText>
                        </MudPaper>

                        <MudSimpleTable Style="overflow-x: auto; border: 2px solid coral" Dense="true" Hover="true" Striped="false">
                            <tbody>
                                <tr>
                                    <td><strong>Massa Magra:</strong></td>
                                    <td><MudText Typo="Typo.body2"><strong>@Resultado.MassaMagra.ToString("F2") kg</strong></MudText></td>
                                </tr>
                                <tr>
                                    <td><strong>Massa Gorda:</strong></td>
                                    <td><MudText Typo="Typo.body2"><strong>@Resultado.MassaGorda.ToString("F2") kg</strong></MudText></td>
                                </tr>
                                <tr>
                                    <td><strong>Taxa Metabólica Basal:</strong></td>
                                    <td><MudText><strong>@Resultado.TMB.ToString("N0") kcal</strong></MudText></td>
                                </tr>
                                <tr>
                                    <td><strong>Gasto Energético Total:</strong></td>
                                    <td><MudText Style="color:coral"><strong>@Resultado.GET.ToString("N0") kcal</strong></MudText></td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                        <MudPaper>
                            <MudAlert Style="border: 2px solid coral; color:inherit" Severity="Severity.Warning" Class="mt-4" Variant="Variant.Text">
                                <MudText Typo="Typo.body2">
                                    <strong>Observação:</strong> Não associe esses resultados como verdade absoluta, sempre procure um profissional.
                                </MudText>
                            </MudAlert>
                        </MudPaper>
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private MudForm form = default!;
    private bool ResultadoCalculado { get; set; }

    private BioimpedanciaModel Model { get; set; } = new();
    private ResultadoBio Resultado { get; set; } = new();

    private string? ValidationPeso(double? peso) => peso <= 0 ? "O peso deve ser maior que zero." : null;
    private string? ValidationAltura(double? altura) => altura <= 0 ? "A altura deve ser maior que zero." : null;
    private string? ValidationIdade(int? idade) => idade <= 0 ? "A idade deve ser maior que zero." : null;
    private string? ValidationGordura(double? gordura) => gordura < 0 || gordura >= 100 ? "O percentual deve ser entre 0% e 99.9%." : null;

    private async Task Calcular()
    {
        if (form is null) return;

        
        await form.ValidateAsync();

        if (!form.IsValid || !Model.Peso.HasValue || !Model.PercentualGordura.HasValue || !Model.Altura.HasValue || !Model.Idade.HasValue)
        {
            ResultadoCalculado = false;
            return;
        }

        double massaGorda = Model.Peso.Value * (Model.PercentualGordura.Value / 100.0);
        double massaMagra = Model.Peso.Value - massaGorda;

        double tmb = 0;

        if (Model.Sexo == "M")
        {
            tmb = 88.362 + (13.397 * Model.Peso.Value) + (4.799 * Model.Altura.GetValueOrDefault()) - (5.677 * Model.Idade.GetValueOrDefault());
        }
        else
        {
            tmb = 447.593 + (9.247 * Model.Peso.Value) + (3.098 * Model.Altura.GetValueOrDefault()) - (4.330 * Model.Idade.GetValueOrDefault());
        }

        double fatorAtividade = Model.NivelAtividade switch
        {
            "Sedentario" => 1.2,
            "Leve" => 1.375,
            "Moderado" => 1.55,
            "Intenso" => 1.725,
            "Extremo" => 1.9,
            _ => 1.2
        };

        double get = tmb * fatorAtividade;

        Resultado = new ResultadoBio
        {
            MassaMagra = massaMagra,
            MassaGorda = massaGorda,
            TMB = tmb,
            GET = get
        };

        ResultadoCalculado = true;
    }

    public class BioimpedanciaModel
    {
        public string Sexo { get; set; } = "M";
        public double? Peso { get; set; }
        public double? Altura { get; set; }
        public int? Idade { get; set; }
        public double? PercentualGordura { get; set; }
        public string NivelAtividade { get; set; } = "Moderado";
    }

    public class ResultadoBio
    {
        public double MassaMagra { get; set; }
        public double MassaGorda { get; set; }
        public double TMB { get; set; }
        public double GET { get; set; }
    }
}