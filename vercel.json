{
  "outputDirectory": "publish/wwwroot",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_framework/(.*\\.wasm)",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_framework/(.*\\.dll)",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_framework/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_framework/(.*\\.dat)",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_content/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*\\.(png|jpg|jpeg|webp|svg|ico))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img-dt/(.*\\.(png|jpg|jpeg|webp))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img-gm/(.*\\.(png|jpg|jpeg|webp))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.wasm)",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/_framework/(.*)", "destination": "/_framework/$1" },
    { "source": "/_content/(.*)", "destination": "/_content/$1" },
    { "source": "/css/(.*)", "destination": "/css/$1" },
    { "source": "/img/(.*)", "destination": "/img/$1" },
    { "source": "/img-dt/(.*)", "destination": "/img-dt/$1" },
    { "source": "/img-gm/(.*)", "destination": "/img-gm/$1" },
    { "source": "/js/(.*)", "destination": "/js/$1" },
    { "source": "/data/(.*)", "destination": "/data/$1" },
    { "source": "/sample-data/(.*)", "destination": "/sample-data/$1" },
    { "source": "/FitUP.styles.css", "destination": "/FitUP.styles.css" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/service-worker.js", "destination": "/service-worker.js" },
    { "source": "/((?!_framework|_content|css|img|img-dt|img-gm|js|data|sample-data|FitUP\\.styles\\.css|manifest\\.json|service-worker\\.js).*)", "destination": "/index.html" }
  ]
}
